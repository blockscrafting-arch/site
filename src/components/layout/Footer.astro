---
/**
 * Подвал сайта: копирайт, ссылки на разделы, контакт (Telegram).
 */
import { site } from '../../utils/site';
const year = new Date().getFullYear();
---

<footer class="footer-animate border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-[var(--color-text-muted)]">
        © {year} vlad.execute(_). Разработка и автоматизация.
      </p>
      <nav class="flex gap-6 text-sm" aria-label="Подвал">
        <a href="/cases" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Кейсы</a>
        <a href="/guides" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Инструкции</a>
        <a href="/contact" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Контакты</a>
      </nav>
    </div>
    <p class="mt-4 text-center text-sm text-[var(--color-text-muted)]">
      Telegram: <a href={site.tgChannel} class="text-[var(--color-accent)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded" target="_blank" rel="noopener noreferrer">{site.tgChannelHandle}</a>
    </p>
  </div>
</footer>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const footer = document.querySelector('.footer-animate');
  if (footer) {
    gsap.fromTo(footer, { opacity: 0, y: 20 }, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: { trigger: footer, start: 'top 95%', toggleActions: 'play none none none' },
    });
  }
</script>
