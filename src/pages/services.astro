---
/**
 * Страница «Услуги» — детальный разбор продуктовой линейки «на пальцах».
 * Hero, sticky quick-nav, 8 сервис-блоков с flow-диаграммами и мини-кейсами, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceShowcase from '../components/sections/ServiceShowcase.astro';
import ServiceQuickNav from '../components/features/ServiceQuickNav.astro';
import Button from '../components/common/Button.astro';

const quickNavItems = [
  { id: 'telegram-bots', label: 'Telegram-боты' },
  { id: 'ai-agents', label: 'AI-агенты' },
  { id: 'mini-apps', label: 'Mini Apps' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'parsing', label: 'Парсинг' },
  { id: 'autoposting', label: 'Автопостинг' },
  { id: 'scripts', label: 'Скрипты' },
  { id: 'integrations', label: 'Интеграции' },
];
---

<BaseLayout
  title="Услуги — vlad.execute(_)"
  description="Telegram-боты, AI-агенты, автоматизация, парсинг — объясняю на пальцах, что это и зачем бизнесу. С примерами реальных кейсов."
>
  <!-- Hero -->
  <section class="pt-24 pb-6 sm:pt-32 sm:pb-8 px-4 sm:px-6" aria-labelledby="services-hero-heading">
    <div class="mx-auto max-w-3xl text-center">
      <h1 id="services-hero-heading" class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl">
        Что я делаю и зачем это бизнесу
      </h1>
      <p class="reveal mt-4 text-lg text-[var(--color-text-muted)]" style="animation-delay: 0.06s">
        Простыми словами — с примерами и цифрами из реальных проектов.
      </p>
    </div>
  </section>

  <!-- Sticky quick-nav -->
  <ServiceQuickNav items={quickNavItems} />

  <!-- 1. Telegram-боты -->
  <ServiceShowcase
    id="telegram-bots"
    title="Telegram-боты"
    pitch="Менеджер, который не спит, не болеет и отвечает за секунды"
    description="Админка и скрипты — в приоритете. Удобная панель прямо в боте: модерация, настройки, отчёты; скрипты и отчёты запускаются из чата — без отдельных сервисов, всё в одном месте. Боты через Bot Father очень функциональны: их можно назначать админами в каналах и группах, проверять подписки, делать любые кнопки и меню, публиковать посты. Плюс привычный сценарий: клиент пишет — бот отвечает, собирает заявку, записывает на приём."
    flowSteps={['Клиент пишет', 'Бот распознаёт запрос', 'Обработка (CRM/база/скрипт)', 'Ответ или админка и скрипты в чате']}
    benefits={['Админка и скрипты в одном чате', 'Проверка подписок, кнопки, публикация постов', '24/7 без выходных', 'Масштабируется без найма']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: контент на автопилоте"
    caseMetric="60 мин → 2 мин на пост"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path class="svg-draw" pathLength="1" d="M26 46h40v36c0 2-2 4-4 4H30c-2 0-4-2-4-4V46z" />
      <path class="svg-draw" pathLength="1" d="M26 50h40M32 60h28M32 70h20" />
      <circle cx="38" cy="80" r="2.5" class="service-typing-dot" />
      <circle cx="46" cy="80" r="2.5" class="service-typing-dot" />
      <circle cx="54" cy="80" r="2.5" class="service-typing-dot" />
      <rect class="svg-draw" pathLength="1" x="58" y="22" width="36" height="44" rx="4" />
      <path class="svg-draw" pathLength="1" d="M64 30h24M64 38h18M64 46h22" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M76 72v10M76 82h-6M76 82h6" stroke-width="2" />
    </svg>
  </ServiceShowcase>

  <!-- 2. AI-агенты -->
  <ServiceShowcase
    id="ai-agents"
    title="AI-агенты"
    pitch="Цифровой сотрудник, который выучил все ваши регламенты"
    description="Как нанять сотрудника, который не устаёт, не болеет и помнит каждый разговор. AI-агент анализирует данные, отвечает клиентам, готовит документы — за секунды."
    flowSteps={['Запрос', 'AI анализирует контекст (RAG/память)', 'Генерирует ответ', 'Результат']}
    benefits={['Помнит контекст', 'Работает с документами', 'Учится на ваших данных', 'Заменяет рутину отдела']}
    caseSlug="ai-lawyer"
    caseTitle="ИИ-юрист: анализ и КП по ГОСТу"
    caseMetric="15 условий проверки за секунды"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle class="svg-draw" pathLength="1" cx="60" cy="58" r="20" />
      <circle class="svg-draw" pathLength="1" cx="38" cy="42" r="8" />
      <circle class="svg-draw" pathLength="1" cx="82" cy="42" r="8" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="82" r="8" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M48 52Q60 48 72 52M52 68Q60 72 68 68M44 58Q52 62 60 58" stroke-width="1.5" />
      <path class="svg-draw" pathLength="1" d="M54 48l4 4 8-10" stroke-width="2" />
    </svg>
  </ServiceShowcase>

  <!-- 3. Mini Apps -->
  <ServiceShowcase
    id="mini-apps"
    title="TG Mini Apps"
    pitch="Полноценное приложение прямо внутри Telegram"
    description="Кастомный красивый интерфейс под ваш бренд — не шаблонный вид, а свой дизайн и UX. Каталог, личный кабинет, форма записи, калькулятор: клиент пользуется, не выходя из мессенджера, без установки отдельного приложения. Единый стиль с ботом, быстрый доступ из чата, оплата в Telegram."
    flowSteps={['Клиент нажимает кнопку в боте', 'Открывается Mini App', 'Взаимодействие', 'Данные в бот/CRM']}
    benefits={['Кастомный интерфейс под бренд', 'Без установки приложения', 'Оплата в Telegram', 'Единый стиль с ботом']}
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="34" y="16" width="52" height="88" rx="6" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="26" r="3" />
      <path class="svg-draw" pathLength="1" d="M42 38h36M42 48h28M42 58h32M42 68h24" />
      <rect class="svg-draw text-[var(--color-accent)]" pathLength="1" x="44" y="76" width="32" height="18" rx="3" stroke-width="2" />
      <path class="svg-draw" pathLength="1" d="M52 84h16" opacity="0.7" />
    </svg>
  </ServiceShowcase>

  <!-- 4. Автоматизация -->
  <ServiceShowcase
    id="automation"
    title="Автоматизация"
    pitch="Всё, что делается по алгоритму или рутиной — можно отдать системе"
    description="Автоматизации бывают разные: цепочки сервисов (заявка → CRM → письмо клиенту), обработка по правилам, рутина по расписанию. Общее одно — если есть алгоритм или повторяющиеся действия, их можно формализовать и поручить n8n или скрипту. Без людей в цепочке, без забытых шагов."
    flowSteps={['Триггер (событие/расписание)', 'Обработка по алгоритму', 'Действия (CRM, почта, таблица)', 'Уведомление или тишина']}
    benefits={['Любая рутина и алгоритм', 'Работает 24/7', 'Нет человеческого фактора', 'Масштабируется']}
    caseSlug="voice-to-text"
    caseTitle="Голосовые в текст: 40 войсов в день"
    caseMetric="−100 мин/день, 10 ч/нед вернули клиенту"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle class="svg-draw" pathLength="1" cx="40" cy="40" r="14" />
      <path class="svg-draw" pathLength="1" d="M40 26v-4M40 54v4M26 40h-4M54 40h4" opacity="0.6" />
      <circle class="svg-draw" pathLength="1" cx="80" cy="40" r="14" />
      <path class="svg-draw" pathLength="1" d="M80 26v-4M80 54v4M66 40h-4M94 40h4" opacity="0.6" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="80" r="14" />
      <path class="svg-draw" pathLength="1" d="M60 66v-4M60 94v4M46 80h-4M74 80h4" opacity="0.6" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M52 46l16-16M56 74l12-20M68 46L54 62" stroke-width="2" />
    </svg>
  </ServiceShowcase>

  <!-- 5. Парсинг -->
  <ServiceShowcase
    id="parsing"
    title="Парсинг"
    pitch="Данные из любых источников — в вашу таблицу, автоматически"
    description="Мониторинг цен конкурентов, сбор контактов, отслеживание новостей и каналов — скрипт собирает данные откуда скажете и кладёт в удобном виде."
    flowSteps={['Источники (сайты/каналы/API)', 'Скрипт парсит', 'Фильтрация', 'Данные в таблицу/базу']}
    benefits={['Экономия часов ручного сбора', 'Актуальные данные', 'Масштабируется', 'Запуск по расписанию']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: мониторинг каналов"
    caseMetric="Мониторинг без ручного труда"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle class="svg-draw" pathLength="1" cx="48" cy="42" r="18" />
      <path class="svg-draw" pathLength="1" d="M62 56L78 72" stroke-width="2" />
      <path class="svg-draw" pathLength="1" d="M20 78h80M24 88h72M28 98h64" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M26 78l3 3 5-6M44 88l4 4 6-7" stroke-width="1.5" />
    </svg>
  </ServiceShowcase>

  <!-- 6. Автопостинг -->
  <ServiceShowcase
    id="autoposting"
    title="Автопостинг"
    pitch="Контент создаётся и публикуется сам — вы только одобряете"
    description="AI генерирует текст и картинку, система публикует в Telegram, VK, Дзен по расписанию. Вы тратите 2 минуты на проверку вместо часа на создание."
    flowSteps={['Идея/источник', 'AI пишет текст', 'AI рисует картинку', 'Модерация (1 кнопка)', 'Публикация в N каналов']}
    benefits={['Контент 24/7', 'Кросс-постинг', 'AI-генерация', 'Контроль одной кнопкой']}
    caseSlug="ai-content-conveyor"
    caseTitle="AI-конвейер для автопостинга"
    caseMetric="30–40 мин → 2 мин на пост"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="24" y="28" width="72" height="48" rx="4" />
      <path class="svg-draw" pathLength="1" d="M32 40h56M32 50h44M32 60h38" />
      <path class="svg-draw" pathLength="1" d="M36 82v8M36 90h12M60 82v8M60 90h12M84 82v8M84 90h12" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M40 76l6 6 12-12 8 8" stroke-width="2" />
    </svg>
  </ServiceShowcase>

  <!-- 7. Скрипты -->
  <ServiceShowcase
    id="scripts"
    title="Скрипты"
    pitch="Любая рутина, которую вы делаете руками — можно автоматизировать"
    description="Python-скрипт под вашу задачу. Обработка файлов, генерация отчётов, массовая рассылка, конвертация данных — запуск одной кнопкой или по расписанию."
    flowSteps={['Задача', 'Скрипт (Python)', 'Результат (файл/отчёт/действие)']}
    benefits={['Точно под задачу', 'Одна кнопка', 'По расписанию', 'С документацией']}
    caseSlug="vk-autoposter"
    caseTitle="Автопостер для ВКонтакте"
    caseMetric="10 мин → 1 сек на публикацию"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="24" y="24" width="72" height="68" rx="4" />
      <path class="svg-draw" pathLength="1" d="M28 36h64M28 44h48M28 52h56M28 60h40" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M34 44l2-1.5M34 52l2-1.5M34 60l2-1.5" stroke-width="2" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M60 98v-6M60 92l-6 4 6 4 6-4" />
    </svg>
  </ServiceShowcase>

  <!-- 8. Интеграции -->
  <ServiceShowcase
    id="integrations"
    title="Интеграции"
    pitch="Связываю любые сервисы, чтобы данные текли автоматически"
    description="CRM не дружит с мессенджером? Таблица не синхронится с базой? Связываю что угодно с чем угодно: Telegram, 1C, Bitrix, Google Sheets, любые API."
    flowSteps={['Сервис A', 'API/webhook', 'n8n/скрипт', 'Сервис B']}
    benefits={['Единый поток данных', 'Нет ручного переноса', 'Любые сервисы', 'Двусторонняя синхронизация']}
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="20" y="28" width="36" height="64" rx="5" />
      <path class="svg-draw" pathLength="1" d="M28 40h20M28 50h16M28 60h22" />
      <rect class="svg-draw" pathLength="1" x="64" y="28" width="36" height="64" rx="5" />
      <path class="svg-draw" pathLength="1" d="M72 40h20M72 50h16M72 60h22" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M56 60h8" stroke-width="2.5" />
      <polyline class="svg-draw text-[var(--color-accent)]" pathLength="1" points="52,56 60,60 68,56" fill="none" />
      <polyline class="svg-draw text-[var(--color-accent)]" pathLength="1" points="52,64 60,60 68,64" fill="none" />
    </svg>
  </ServiceShowcase>

  <!-- CTA -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        Не понял, что нужно?
      </h2>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Расскажи задачу — подскажу, какой вариант подойдёт и что могу сделать.
      </p>
      <div class="mt-8">
        <Button href="/contact" variant="primary">Обсудить задачу</Button>
      </div>
    </div>
  </section>
</BaseLayout>
