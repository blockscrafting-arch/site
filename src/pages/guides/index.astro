---
/**
 * База знаний / Инструкции: блок «Для заказчика», категории, поиск.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const sorted = [...guides].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

/** Инструкции для заказчика (без тех.фона) — показываем первым блоком. */
const clientGuides = sorted.filter((g) => g.data.forClient === true);

const categoryLabels: Record<string, string> = {
  setup: 'Установка и настройка',
  integrations: 'Сервисы и интеграции',
  faq: 'Вопросы и ответы',
  other: 'Прочее',
};
const categoryIntro: Record<string, string> = {
  setup: 'Как поднять сервер, домен, окружение и куда положить ключи.',
  integrations: 'Подключение Telegram, OpenAI, таблиц, n8n и других сервисов.',
  faq: 'Когда что выбрать, лимиты, бэкапы и типовые вопросы.',
  other: 'Дополнительные материалы.',
};

const groups = new Map<string, typeof sorted>();
for (const g of sorted) {
  const cat = g.data.category ?? 'other';
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(g);
}
const order = ['setup', 'integrations', 'faq', 'other'];
const sortedGroups = order.filter((k) => groups.has(k));
---

<BaseLayout
  title="Инструкции — vlad.execute(_)"
  description="Пошаговые инструкции для заказчиков и разработчиков: чеклист к старту, API-ключи, VPS, домен, Telegram, n8n."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 relative">
    <div class="absolute right-0 sm:-right-10 top-0 opacity-[0.2] w-[250px] h-[250px] pointer-events-none z-[-1] text-[var(--color-accent)]" aria-hidden="true" style="perspective: 1000px;">
      <svg class="w-full h-full" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <!-- Обложка (задняя часть, видна по краям) -->
        <path d="M 100 165 Q 45 185 10 155 L 10 55 Q 45 85 100 65 Q 155 85 190 55 L 190 155 Q 155 185 100 165 Z" fill="var(--color-accent-muted)" stroke="none" />
        
        <!-- Левый блок страниц (толщина) -->
        <path d="M 15 150 L 15 60 Q 45 90 95 70 L 95 160 Q 45 180 15 150 Z" />
        <!-- Правый блок страниц (толщина) -->
        <path d="M 185 150 L 185 60 Q 155 90 105 70 L 105 160 Q 155 180 185 150 Z" />
        
        <!-- Центральный корешок -->
        <line x1="100" y1="65" x2="100" y2="165" />
        
        <!-- Несколько декоративных линий текста на левой странице -->
        <line x1="30" y1="80" x2="80" y2="70" opacity="0.4" />
        <line x1="30" y1="95" x2="85" y2="85" opacity="0.4" />
        <line x1="30" y1="110" x2="75" y2="100" opacity="0.4" />

        <!-- Перелистываемая страница -->
        <g class="animate-page" style="transform-origin: 100px 110px;">
          <!-- Сама страница -->
          <path d="M 100 160 Q 155 180 185 150 L 185 60 Q 155 90 100 70 Z" fill="var(--color-bg)" />
          <!-- Текст на перелистываемой странице -->
          <line x1="115" y1="85" x2="170" y2="95" stroke-width="2" opacity="0.5" />
          <line x1="115" y1="100" x2="160" y2="110" stroke-width="2" opacity="0.5" />
          <line x1="115" y1="115" x2="165" y2="125" stroke-width="2" opacity="0.5" />
        </g>
      </svg>
    </div>
    <h1 class="guides-page-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl">
      Инструкции
    </h1>
    <p class="mt-2 text-[var(--color-text-muted)] max-w-2xl">
      Часть материалов — <strong class="text-[var(--color-text)]">для заказчиков</strong>: что сделать и что подготовить перед стартом. Остальное — технические гайды по настройке и интеграциям.
    </p>

    <!-- Блок для заказчика (не технаря) -->
    {clientGuides.length > 0 && (
      <section class="guides-client-block mt-10 rounded-2xl border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 p-6 sm:p-8" aria-labelledby="guides-for-client">
        <h2 id="guides-for-client" class="text-xl font-display font-semibold text-[var(--color-text)] flex items-center gap-2">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-accent)]/20 text-[var(--color-accent)]" aria-hidden="true">✓</span>
          Для заказчика: что подготовить к старту
        </h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)] max-w-xl">
          Эти шаги можно сделать без технических знаний. По каждой теме — короткая пошаговая инструкция.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {clientGuides.map((entry) => (
            <li class="guide-card guide-card-client" data-title={entry.data.title.toLowerCase()} data-desc={(entry.data.description ?? '').toLowerCase()}>
              <a
                href={`/guides/${entry.slug}`}
                class="group block rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-all duration-200 hover:border-[var(--color-accent)]/50 hover:shadow-glow-sm"
              >
                <h3 class="font-display font-semibold text-[var(--color-text)] text-base group-hover:text-[var(--color-accent)] transition-colors">{entry.data.title}</h3>
                {entry.data.description && (
                  <p class="mt-1.5 text-sm text-[var(--color-text-muted)] line-clamp-2">
                    {entry.data.description}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-10">
      <label for="guides-search" class="sr-only">Поиск по инструкциям</label>
      <input
        id="guides-search"
        type="search"
        placeholder="Найти инструкцию..."
        class="guides-search w-full max-w-md rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/20"
        autocomplete="off"
      />
    </div>

    {sorted.length === 0 ? (
      <p class="mt-12 text-[var(--color-text-muted)]">Инструкции скоро появятся.</p>
    ) : (
      <div class="guides-list mt-12">
        <h2 class="text-lg font-semibold text-[var(--color-text-muted)] mb-6">Все инструкции по категориям</h2>
        <div class="space-y-12">
          {sortedGroups.map((catKey) => {
            const items = groups.get(catKey)!;
            const label = categoryLabels[catKey] ?? 'Прочее';
            const intro = categoryIntro[catKey];
            return (
              <section aria-labelledby={`guide-cat-${catKey}`} class="guide-cat-section">
                <h3 id={`guide-cat-${catKey}`} class="text-lg font-display font-semibold text-[var(--color-text)] mb-1">
                  {label}
                </h3>
                {intro && (
                  <p class="text-sm text-[var(--color-text-muted)] mb-4 max-w-2xl">{intro}</p>
                )}
                <ul class="grid gap-4 sm:grid-cols-2" role="list">
                  {items.map((entry) => (
                    <li class="guide-card" data-title={entry.data.title.toLowerCase()} data-desc={(entry.data.description ?? '').toLowerCase()}>
                      <a
                        href={`/guides/${entry.slug}`}
                        class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-200 hover:border-[var(--color-accent)]/50 hover:shadow-glow-sm"
                      >
                        <h4 class="font-display font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">{entry.data.title}</h4>
                        {entry.data.description && (
                          <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2">
                            {entry.data.description}
                          </p>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  (function () {
    const search = document.getElementById('guides-search');
    if (!search) return;
    search.addEventListener('input', () => {
      const q = (search as HTMLInputElement).value.trim().toLowerCase();
      document.querySelectorAll('.guide-card').forEach((el) => {
        const title = (el as HTMLElement).dataset.title ?? '';
        const desc = (el as HTMLElement).dataset.desc ?? '';
        const show = !q || title.includes(q) || desc.includes(q);
        (el as HTMLElement).style.display = show ? '' : 'none';
      });
      document.querySelectorAll('.guide-cat-section').forEach((section) => {
        const cardsInSection = (section as HTMLElement).querySelectorAll('.guide-card');
        const anyVisible = Array.from(cardsInSection).some((el) => (el as HTMLElement).style.display !== 'none');
        (section as HTMLElement).style.display = !q || anyVisible ? '' : 'none';
      });
      const clientBlock = document.querySelector('.guides-client-block');
      if (clientBlock) {
        const clientCards = (clientBlock as HTMLElement).querySelectorAll('.guide-card');
        const clientVisible = !q || Array.from(clientCards).some((el) => (el as HTMLElement).style.display !== 'none');
        (clientBlock as HTMLElement).style.display = clientVisible ? '' : 'none';
      }
    });
  })();
</script>
