---
/**
 * Секция «Частые вопросы» (FAQ).
 * JSON-LD FAQPage для расширенных сниппетов в Яндексе и Google.
 * Визуал: нумерованные вопросы с категорией-бейджем, левый акцент при раскрытии.
 */
interface FaqEntry {
  question: string;
  answer: string;
  /** Краткий лейбл категории, отображается над вопросом */
  category: string;
}

const faqs: FaqEntry[] = [
  {
    category: 'Стоимость',
    question: 'Как понять стоимость ещё до начала работы? Есть хотя бы ориентир?',
    answer:
      'Цена на простые решения начинается от 5 000 ₽. После короткого описания задачи (в Telegram или по форме) называю конкретную вилку ещё до созвона. Всё чётко по ТЗ: беру ваше, составляю своё, согласовываем, работаем.',
  },
  {
    category: 'Сроки',
    question: 'Сколько реально ждать и не растянется ли это на месяцы?',
    answer:
      'Простой бот или воркфлоу в n8n — 1–3 рабочих дня после утверждения ТЗ. Делаю быстро и качественно. Объём фиксируем до старта, чтобы не было «сделали одно, а нужно другое». Всё делаю в срок, а 95% проектов сдаю сильно досрочно.',
  },
  {
    category: 'Интеграции',
    question: 'У нас уже есть Bitrix24 / amoCRM / Google-таблицы / 1С — подключитесь?',
    answer:
      'В большинстве случаев — да. Скажите, что используете, и я оценю возможность подключения ещё на этапе брифа.',
  },
  {
    category: 'Технологии',
    question: 'Зачем n8n, если есть Make или Zapier? Чем это выгоднее для бизнеса?',
    answer:
      'Make и Zapier — подписки в $ и ограничения по числу операций в месяц. n8n разворачивается на вашем VPS: платите только за сервер (~5–10 $/мес), операций — без лимита, данные остаются у вас. Для сложных процессов с циклами, условиями и JavaScript-кодом n8n существенно гибче.',
  },
  {
    category: 'Поддержка',
    question: 'Если бот или автоматизация сломается после сдачи — что произойдёт?',
    answer:
      'На мой код — полная гарантия работоспособности. Если что-то не работает так, как описано в ТЗ — чиню бесплатно, пока не заработает как часы. Нужно постоянное сопровождение (мониторинг сервера, бэкапы, слежение за балансами API) — есть пакет от 3 000–5 000 ₽/мес. При этом важно: всю инфраструктуру (VPS, ключи API, аккаунты сервисов) регистрируем на вас — вы ни от кого не зависите.',
  },
  {
    category: 'Оплата',
    question: 'Работаете по предоплате? Как устроена оплата?',
    answer:
      '50% предоплата перед стартом, 50% после приёмки результата. В некоторых случаях возможна полная постоплата. По договору и без.',
  },
];

/** JSON-LD FAQPage для расширенных сниппетов. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="faq-heading">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="relative w-full mb-4">
    <!-- Декоративный вопросительный знак — как SVG-акцент на других секциях -->
    <div
      class="absolute -z-10 pointer-events-none text-[var(--color-accent)] opacity-[0.12] w-40 h-40 right-0 top-1/2 -translate-y-1/2 translate-x-[15%] hidden sm:block"
      aria-hidden="true"
    >
      <svg class="w-full h-full" viewBox="0 0 120 160" fill="none" stroke="currentColor">
        <path
          d="M30 45 C30 20 90 20 90 55 C90 80 60 80 60 105"
          stroke-width="14"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="60" cy="135" r="8" fill="currentColor" stroke="none" />
      </svg>
    </div>

    <h2 id="faq-heading" class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl text-center">
      Частые вопросы
    </h2>
  </div>

  <p class="reveal mt-4 text-center text-[var(--color-text-muted)] max-w-xl mx-auto" style="animation-delay:.06s">
    То, что обычно спрашивают до начала работы — честно и по существу.
  </p>

  <div class="reveal mt-12 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm overflow-hidden" style="animation-delay:.1s">
    {faqs.map((faq, i) => {
      const num = String(i + 1).padStart(2, '0');
      return (
        <details class="faq-item border-b border-[var(--color-border)] last:border-b-0 group/faq">
          <summary class="flex w-full items-start gap-4 px-5 py-5 sm:px-6 text-left cursor-pointer list-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-inset [&::-webkit-details-marker]:hidden">
            <span class="shrink-0 w-7 pt-0.5 font-mono text-xs font-semibold text-[var(--color-text-muted)] opacity-50 select-none" aria-hidden="true">{num}</span>
            <span class="flex-1 min-w-0">
              <span class="block mb-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-accent)] opacity-70">{faq.category}</span>
              <span class="block text-[0.9375rem] font-medium leading-snug text-[var(--color-text)] group-hover/faq:text-[var(--color-accent)] transition-colors duration-150">{faq.question}</span>
            </span>
            <span class="shrink-0 mt-1 transition-transform duration-300 group-open/faq:rotate-180" aria-hidden="true">
              <svg class="h-5 w-5 text-[var(--color-text-muted)] group-hover/faq:text-[var(--color-accent)] transition-colors duration-150" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
              </svg>
            </span>
          </summary>
          <div class="pl-[2.75rem] pr-5 pb-5 sm:pl-[3.25rem] sm:pr-6">
            <div class="border-l-2 border-[var(--color-accent)] pl-4 opacity-90">
              <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{faq.answer}</p>
            </div>
          </div>
        </details>
      );
    })}
  </div>

  <!-- CTA под FAQ -->
  <p class="reveal mt-8 text-center text-sm text-[var(--color-text-muted)]" style="animation-delay:.15s">
    Не нашли ответ?{' '}
    <a
      href="/contact"
      class="font-medium text-[var(--color-accent)] underline underline-offset-2 hover:opacity-80 transition-opacity"
      data-ym-goal="faq_contact_click"
    >
      Напишите напрямую →
    </a>
  </p>
</section>
