---
import FaqItem from '../features/FaqItem';

const faqs = [
  { question: 'Сколько стоит проект?', answer: 'Зависит от объёма: от разового скрипта до полноценного бота или пайплайна. После описания задачи назову ориентир по срокам и бюджету.' },
  { question: 'Какие сроки на типичный проект?', answer: 'Простой бот или сценарий в n8n — от нескольких дней. Сложные интеграции и AI-агенты — от 1–2 недель. Точные сроки фиксируем после уточнения объёма.' },
  { question: 'Работаете по договору и с НДС/самозанятым?', answer: 'Работаю как самозанятый (НПД): чек через приложение «Мой налог». Договор или оферта — по согласованию под ваш процесс закупки.' },
  { question: 'Работаете с n8n и Telegram?', answer: 'Да. n8n, боты и Mini Apps в Telegram, MAX и VK, интеграции с CRM и мессенджерами — основной стек.' },
  { question: 'Можно ли доработать существующий проект?', answer: 'Да. Подключусь к вашему репозиторию или n8n, доработаю логику, добавлю функции или перенесу на новый стек.' },
  { question: 'Как связаться?', answer: 'Напишите в Telegram (@goutach) или через форму на странице Контакты. Отвечу в течение дня.' },
];

/** JSON-LD FAQPage для расширенных сниппетов в Яндексе и Google. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="faq-heading">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <h2 id="faq-heading" class="reveal text-2xl font-bold text-[var(--color-text)] sm:text-3xl text-center">
    Частые вопросы
  </h2>
  <div class="reveal mt-12 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm overflow-hidden">
    {faqs.map((faq) => (
      <FaqItem client:load question={faq.question} answer={faq.answer} />
    ))}
  </div>
</section>
