---
/**
 * Hero главной: статичный H1 с ротацией услуг (Framer Motion),
 * trust-bar под CTA, marquee скрыта (код сохранён).
 *
 * H1: "Запущу [бота/AI-агента/парсер/автоматизацию].
 *      Будет работать, пока вы спите."
 * Ротация внутри предложения — доказанный паттерн (ресерч 20+ сайтов).
 */
import Button from '../common/Button.astro';
import HeroRotator from '../features/TypewriterHero';
---

<section class="relative h-[calc(100dvh-4rem)] flex flex-col overflow-hidden">
  <!-- Radial glow фон -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[700px] rounded-full bg-[var(--color-accent)]/6 blur-[140px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] rounded-full bg-[var(--color-accent-cyan)]/4 blur-[120px]"></div>
  </div>

  <!-- Контент героя -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 py-8 sm:py-16 sm:px-6 text-center">

    <h1
      class="reveal font-display text-[clamp(2rem,7vw,5rem)] font-black tracking-tighter leading-[1.1] max-w-4xl"
      aria-label="Запущу бота, AI-агента, парсер, автоматизацию. Будет работать, пока вы спите."
    >
      Запущу <HeroRotator client:load /><span aria-hidden="true">.</span>
      <br />
      Будет работать, пока&nbsp;вы&nbsp;спите.
    </h1>

    <div class="reveal mt-6 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4" style="animation-delay:.08s;">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost" dataYmGoal="cta_cases">Смотреть кейсы</Button>
    </div>

    <!-- Trust-bar: социальное доказательство + условия -->
    <div class="reveal mt-5 sm:mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-4" style="animation-delay:.24s;">
      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">от 5 000 ₽</span>
      <span class="h-3.5 w-px bg-[var(--color-border)] hidden sm:block" aria-hidden="true"></span>
      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">MVP за 1–3 дня</span>
      <span class="h-3.5 w-px bg-[var(--color-border)] hidden sm:block" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/[0.08] px-2.5 py-0.5 text-xs sm:text-sm font-medium text-[var(--color-accent)]">
        <svg class="h-3 w-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 2"/>
        </svg>
        Ответ в тот же день
      </span>
    </div>
  </div>

  <!-- Full-bleed marquee strip — скрыта, код сохранён для быстрого включения -->
  <div class="hidden relative z-10 w-full overflow-hidden border-t border-[var(--color-border)] bg-[var(--color-surface)]/40 backdrop-blur-sm py-3 sm:py-3.5" aria-hidden="true">
    <div class="flex animate-marquee w-max">
      <span class="whitespace-nowrap text-sm sm:text-base text-[var(--color-text-muted)]">Боты в мессенджерах&nbsp;&nbsp;•&nbsp;&nbsp;Mini Apps&nbsp;&nbsp;•&nbsp;&nbsp;AI-агенты&nbsp;&nbsp;•&nbsp;&nbsp;Автоматизация&nbsp;&nbsp;•&nbsp;&nbsp;Парсинг&nbsp;&nbsp;•&nbsp;&nbsp;Автопостинг&nbsp;&nbsp;•&nbsp;&nbsp;Скрипты&nbsp;&nbsp;•&nbsp;&nbsp;Интеграции&nbsp;&nbsp;•&nbsp;&nbsp;Telegram&nbsp;&nbsp;•&nbsp;&nbsp;n8n&nbsp;&nbsp;•&nbsp;&nbsp;Python&nbsp;&nbsp;•&nbsp;&nbsp;LLM&nbsp;&nbsp;•&nbsp;&nbsp;RAG&nbsp;&nbsp;•&nbsp;&nbsp;</span>
      <span class="whitespace-nowrap text-sm sm:text-base text-[var(--color-text-muted)]" aria-hidden="true">Боты в мессенджерах&nbsp;&nbsp;•&nbsp;&nbsp;Mini Apps&nbsp;&nbsp;•&nbsp;&nbsp;AI-агенты&nbsp;&nbsp;•&nbsp;&nbsp;Автоматизация&nbsp;&nbsp;•&nbsp;&nbsp;Парсинг&nbsp;&nbsp;•&nbsp;&nbsp;Автопостинг&nbsp;&nbsp;•&nbsp;&nbsp;Скрипты&nbsp;&nbsp;•&nbsp;&nbsp;Интеграции&nbsp;&nbsp;•&nbsp;&nbsp;Telegram&nbsp;&nbsp;•&nbsp;&nbsp;n8n&nbsp;&nbsp;•&nbsp;&nbsp;Python&nbsp;&nbsp;•&nbsp;&nbsp;LLM&nbsp;&nbsp;•&nbsp;&nbsp;RAG&nbsp;&nbsp;•&nbsp;&nbsp;</span>
    </div>
  </div>
</section>
