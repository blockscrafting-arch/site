---
/**
 * Переиспользуемый блок одной услуги на странице /services.
 * Содержит: SVG-иллюстрация, заголовок, pitch, описание, flow-диаграмма, выгоды, мини-кейс.
 */
import ServiceFlowDiagram from '../features/ServiceFlowDiagram.astro';

export interface Props {
  /** Якорь для навигации (без #) */
  id: string;
  /** Название услуги */
  title: string;
  /** Короткий pitch — одна строка */
  pitch: string;
  /** Объяснение простыми словами (2–3 предложения) */
  description: string;
  /** Шаги для flow-диаграммы */
  flowSteps: string[];
  /** Выгоды для бизнеса (3–4 пункта) */
  benefits: string[];
  /** Slug кейса для ссылки (опционально) */
  caseSlug?: string;
  /** Название кейса для карточки */
  caseTitle?: string;
  /** Метрика для мини-кейса (например "60 мин → 2 мин") */
  caseMetric?: string;
  /** Направление: "left" — иллюстрация слева, "right" — справа */
  direction: 'left' | 'right';
}

const { id, title, pitch, description, flowSteps, benefits, caseSlug, caseTitle, caseMetric, direction } = Astro.props;
const isLeft = direction === 'left';
---

<section
  id={id}
  class="service-section-anchor border-b border-[var(--color-border)] py-16 sm:py-24 px-4 sm:px-6"
  aria-labelledby={`service-${id}-heading`}
>
  <div class="mx-auto max-w-6xl">
    <div class={`flex flex-col gap-10 lg:gap-16 ${isLeft ? 'lg:flex-row' : 'lg:flex-row-reverse'}`}>
      <!-- Иллюстрация -->
      <div class="flex-shrink-0 lg:w-1/3 flex items-center justify-center">
        <div class="service-illustration-float reveal w-28 h-28 sm:w-32 sm:h-32 text-[var(--color-accent)]" aria-hidden="true">
          <slot />
        </div>
      </div>
      <!-- Текст и flow -->
      <div class="flex-1 min-w-0">
        <h2 id={`service-${id}-heading`} class="reveal font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl">
          {title}
        </h2>
        <p class="reveal mt-2 text-lg font-medium text-[var(--color-accent)]" style="animation-delay: 0.05s">
          {pitch}
        </p>
        <p class="reveal mt-4 text-[var(--color-text-muted)] leading-relaxed" style="animation-delay: 0.1s">
          {description}
        </p>
        <ServiceFlowDiagram steps={flowSteps} />
        <!-- Выгоды -->
        <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">
          {benefits.map((benefit) => (
            <div
              class="service-benefit-card rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 flex items-start gap-3"
            >
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-accent-muted)] text-[var(--color-accent)]">
                <svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-sm text-[var(--color-text)]">{benefit}</span>
            </div>
          ))}
        </div>
        <!-- Мини-кейс -->
        {caseSlug && caseTitle && (
          <article class="reveal mt-8" style="animation-delay: 0.2s">
            <a
              href={`/cases/${caseSlug}`}
              class="group flex flex-wrap items-center gap-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-accent)] hover:shadow-[0_0_16px_-6px_var(--color-accent-glow)]"
            >
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                  {caseTitle}
                </p>
                {caseMetric && (
                  <p class="mt-1 text-sm text-[var(--color-text-muted)]">
                    {caseMetric}
                  </p>
                )}
              </div>
              <span class="text-sm font-medium text-[var(--color-accent)] flex items-center gap-1">
                Читать кейс
                <svg class="h-4 w-4 svg-icon-reveal service-arrow-icon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </a>
          </article>
        )}
      </div>
    </div>
  </div>
</section>
