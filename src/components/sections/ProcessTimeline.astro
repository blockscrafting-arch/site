---
/**
 * Секция «Как работаю»: 4 шага в сетке, акцент на скорость и отсутствие бюрократии.
 * Сканируется за 3 секунды. CTA после. CSS reveal, без GSAP.
 */
import Button from '../common/Button.astro';

const steps = [
  {
    num: '01',
    title: 'Описываете задачу',
    sub: 'Текстом, голосом или ТЗ — как удобно',
    icon: 'brief',
  },
  {
    num: '02',
    title: 'Предлагаю варианты',
    sub: '3 пакета с ценами — за 1 день',
    icon: 'proto',
  },
  {
    num: '03',
    title: 'Запускаем MVP',
    sub: 'Рабочий прототип за 1–3 дня',
    icon: 'code',
  },
  {
    num: '04',
    title: 'Гарантирую работу',
    sub: 'Баги по ТЗ правлю бесплатно',
    icon: 'launch',
  },
];
---

<section class="py-12 sm:py-16 px-4 sm:px-6" aria-labelledby="process-heading">
  <div class="mx-auto max-w-5xl">
    <h2
      id="process-heading"
      class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl text-center"
    >
      4 шага до запуска
    </h2>

    <ol class="reveal-stagger mt-12 sm:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6" role="list">
      {steps.map((step) => (
        <li class="relative flex flex-col items-center text-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 sm:p-7 gap-2 sm:gap-3 h-full">
          <!-- Номер шага -->
          <span
            class="font-display text-3xl sm:text-5xl font-black text-[var(--color-accent)] leading-none select-none"
            aria-hidden="true"
          >{step.num}</span>

          <!-- Иконка — скрыта на мобилке для компактности -->
          <span class="hidden sm:flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent-muted)] text-[var(--color-accent)] animate-float-icon" aria-hidden="true">
            {step.icon === 'brief' && (
              <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
            {step.icon === 'proto' && (
              <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            )}
            {step.icon === 'code' && (
              <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            )}
            {step.icon === 'launch' && (
              <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
          </span>

          <!-- Заголовок шага -->
          <h3 class="font-display font-semibold text-[var(--color-text)] text-sm sm:text-lg leading-snug">
            {step.title}
          </h3>
          {step.sub && (
            <p class="text-xs text-[var(--color-text-muted)] leading-snug">
              {step.sub}
            </p>
          )}
        </li>
      ))}
    </ol>

    <div class="reveal mt-10 sm:mt-12 text-center" style="animation-delay:.25s">
      <Button href="/contact" variant="primary" dataYmGoal="cta_process">Начать с шага 1</Button>
    </div>
  </div>
</section>
