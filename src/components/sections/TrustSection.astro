---
/**
 * Блок социального доказательства: крупные метрики из реальных проектов.
 * Анимация появления карточек — Framer Motion (островок).
 */
import AnimatedTrustMetrics from '../features/AnimatedTrustMetrics';

const metrics = [
  { value: '10 ч/нед', label: 'Вернули PM: голосовые в текст за вечер (n8n + Whisper), скан по диагонали вместо 2 часов прослушивания.', icon: 'clock' as const },
  { value: '120 → 2 ч', label: 'Постинг в 50+ Telegram-групп: было 120 часов в месяц, стало 2 часа на загрузку контента.', icon: 'chart' as const },
  { value: '1 вечер', label: 'От нуля до AI-ассистента в Telegram: голос, память, напоминания — без абонплат.', icon: 'zap' as const },
];
---

<section class="py-24 sm:py-32 px-4 sm:px-6" aria-labelledby="trust-heading">
  <div class="mx-auto max-w-6xl">
    <div class="relative w-full max-w-3xl mx-auto mb-4">
      <!-- SVG: молния. Контекст — вся ширина; sm+ — справа -->
      <div class="absolute -z-10 pointer-events-none text-[var(--color-accent)] opacity-[0.15] w-48 h-48 left-1/2 -translate-x-1/2 top-0 -translate-y-[55%] sm:w-84 sm:h-84 sm:left-auto sm:right-0 sm:translate-x-[20%] sm:top-1/2 sm:-translate-y-1/2" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 200 200" fill="none" stroke="currentColor">
          <path class="animate-lightning-strike" d="M115 20 L55 105 H105 L90 180 L155 90 H100 Z" stroke-width="4" stroke-linejoin="round" />
          <circle cx="100" cy="100" r="85" stroke-width="2" stroke-dasharray="1 8" opacity="0.3" />
          <path d="M150 40 L160 30 M40 150 L50 140 M40 50 L50 60" stroke-width="3" stroke-linecap="round" opacity="0.5" />
        </svg>
      </div>
      <div class="flex justify-center">
        <h2 id="trust-heading" class="reveal font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl text-center relative z-10">
          Результаты в цифрах
        </h2>
      </div>
    </div>
    <p class="reveal mt-4 text-center text-[var(--color-text-muted)] max-w-2xl mx-auto" style="animation-delay:.06s">
      Показатели из реальных проектов.
    </p>

    <AnimatedTrustMetrics client:visible metrics={metrics} />
  </div>
</section>
