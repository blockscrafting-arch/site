---
/**
 * Детальная страница одной услуги.
 * Генерируется для каждого из 8 id через getStaticPaths.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/common/Button.astro';
import { SERVICES, getServiceById } from '../../data/services';

export function getStaticPaths() {
  return SERVICES.map((svc) => ({ params: { id: svc.id } }));
}

const { id } = Astro.params;
const svc = getServiceById(id);

if (!svc) {
  return Astro.redirect('/services');
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Услуги', item: 'https://vladexecute.ru/services' },
    { '@type': 'ListItem', position: 2, name: svc.title, item: `https://vladexecute.ru/services/${svc.id}` },
  ],
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: svc.title,
  description: svc.seoDescription,
  provider: {
    '@type': 'Person',
    name: 'Владислав Попович',
    url: 'https://vladexecute.ru',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'RUB',
    description: svc.price,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={`${svc.title} — vlad.execute(_)`}
  description={svc.seoDescription}
>
  <!-- Хлебные крошки -->
  <nav class="pt-20 sm:pt-24 px-4 sm:px-6" aria-label="Навигация по разделам">
    <div class="mx-auto max-w-3xl">
      <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
        <li>
          <a href="/services" class="hover:text-[var(--color-accent)] transition-colors">Услуги</a>
        </li>
        <li aria-hidden="true" class="opacity-40">→</li>
        <li class="text-[var(--color-text)]" aria-current="page">{svc.title}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero услуги -->
  <section class="pt-6 pb-8 sm:pt-8 sm:pb-10 px-4 sm:px-6" aria-labelledby="service-h1">
    <div class="mx-auto max-w-3xl">
      <h1
        id="service-h1"
        class="reveal font-display text-3xl font-black tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl"
      >
        {svc.title}
      </h1>
      <p class="reveal mt-3 text-lg text-[var(--color-text-muted)] leading-snug" style="animation-delay:.06s">
        {svc.pitch}
      </p>
      <!-- Цена крупным шрифтом -->
      <div class="reveal mt-5 inline-flex items-center gap-3 rounded-xl border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 px-5 py-3" style="animation-delay:.1s">
        <span class="text-2xl font-black text-[var(--color-accent)]">{svc.price}</span>
        {svc.priceNote && (
          <span class="text-sm text-[var(--color-text-muted)]">{svc.priceNote}</span>
        )}
      </div>
    </div>
  </section>

  <!-- Основной блок: описание + что входит -->
  <section class="px-4 sm:px-6 pb-12" aria-label="Описание услуги">
    <div class="mx-auto max-w-3xl grid gap-10 lg:grid-cols-2">
      <!-- Описание -->
      <div class="reveal" style="animation-delay:.12s">
        <h2 class="font-display text-xl font-bold text-[var(--color-text)] mb-4">О задаче</h2>
        <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
          {svc.description}
        </p>
      </div>

      <!-- Что входит -->
      <div class="reveal" style="animation-delay:.16s">
        <h2 class="font-display text-xl font-bold text-[var(--color-text)] mb-4">Что входит</h2>
        <ul class="space-y-3" role="list">
          {svc.features.map((f) => (
            <li class="flex items-start gap-3 text-base text-[var(--color-text-muted)]">
              <span class="mt-1 shrink-0 text-[var(--color-accent)]" aria-hidden="true">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              {f}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Примеры проектов -->
  {svc.relatedCases.length > 0 && (
    <section class="px-4 sm:px-6 pb-12" aria-labelledby="cases-heading">
      <div class="mx-auto max-w-3xl">
        <h2 id="cases-heading" class="reveal font-display text-xl font-bold text-[var(--color-text)] mb-6" style="animation-delay:.2s">
          Примеры проектов
        </h2>
        <ul class="reveal grid gap-4 sm:grid-cols-2" role="list" style="animation-delay:.22s">
          {svc.relatedCases.map((c) => (
            <li>
              <a
                href={`/cases/${c.slug}`}
                class="group flex flex-col h-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-glow-sm"
              >
                <p class="font-display font-semibold text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-snug">
                  {c.title}
                </p>
                {c.metric && (
                  <p class="mt-2 text-sm font-medium text-[var(--color-accent)]">{c.metric}</p>
                )}
                <p class="mt-3 text-xs text-[var(--color-text-muted)] font-semibold">{c.price}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Отзыв -->
  {svc.review && (
    <section class="px-4 sm:px-6 pb-12" aria-label="Отзыв клиента">
      <div class="mx-auto max-w-3xl">
        <blockquote class="reveal rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8" style="animation-delay:.24s">
          <p class="text-base sm:text-lg text-[var(--color-text)] leading-relaxed">
            «{svc.review.text}»
          </p>
          <footer class="mt-4">
            <cite class="not-italic">
              <span class="block text-sm font-semibold text-[var(--color-text)]">{svc.review.author}</span>
              <span class="text-sm text-[var(--color-text-muted)]">{svc.review.project}</span>
            </cite>
          </footer>
        </blockquote>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="px-4 sm:px-6 pb-20 sm:pb-28" aria-label="Связаться">
    <div class="mx-auto max-w-3xl">
      <div class="reveal rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 sm:p-10 text-center" style="animation-delay:.28s">
        <h2 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
          Готовы обсудить задачу?
        </h2>
        <p class="mt-2 text-[var(--color-text-muted)]">
          Опишите что нужно — назову цену и сроки за один день.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <Button href="https://t.me/goutach" variant="primary" dataYmGoal="cta_telegram" external>
            Написать в Telegram
          </Button>
          <Button href="/contact" variant="outline" dataYmGoal="cta_contact">
            Отправить заявку
          </Button>
        </div>
        <p class="mt-4 text-sm text-[var(--color-text-muted)]">
          Ответ в течение дня
        </p>
      </div>
    </div>
  </section>

  <!-- Навигация по другим услугам -->
  <section class="px-4 sm:px-6 pb-16 border-t border-[var(--color-border)]" aria-label="Другие услуги">
    <div class="mx-auto max-w-3xl pt-10">
      <p class="text-sm text-[var(--color-text-muted)] mb-4">Другие услуги:</p>
      <ul class="flex flex-wrap gap-2" role="list">
        {SERVICES.filter((s) => s.id !== svc.id).map((s) => (
          <li>
            <a
              href={`/services/${s.id}`}
              class="inline-block rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            >
              {s.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
</BaseLayout>
