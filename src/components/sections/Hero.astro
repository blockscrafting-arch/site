---
/**
 * Hero главной: центрированный текст, терминал с метриками (рус.), radial glow, без сторонних иллюстраций.
 * Анимация — CSS (reveal) + IntersectionObserver из BaseLayout. GSAP не используется.
 */
import Button from '../common/Button.astro';
import TypewriterHero from '../features/TypewriterHero';
---

<section class="relative min-h-[100dvh] flex flex-col items-center justify-center px-4 py-20 overflow-hidden sm:min-h-[90vh] sm:py-24 sm:px-6">
  <!-- Radial glow фон -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] rounded-full bg-[var(--color-accent)]/8 blur-[120px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] rounded-full bg-[var(--color-accent-cyan)]/5 blur-[100px]"></div>
  </div>

  <div class="relative z-10 w-full max-w-3xl mx-auto text-center">
    <h1 class="reveal font-display text-3xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl lg:text-7xl min-h-[3em] sm:min-h-[2.4em] flex items-center justify-center">
      <TypewriterHero client:load class="!text-inherit" />
    </h1>

    <p class="reveal mt-3 sm:mt-6 flex items-center justify-center gap-2 text-lg text-[var(--color-text-muted)] sm:text-xl max-w-2xl mx-auto leading-relaxed" style="animation-delay: .1s;">
      <span class="shrink-0 animate-pulse flex items-center justify-center">
        <svg class="h-5 w-5 svg-icon-reveal text-[var(--color-accent)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </span>
      <span class="font-semibold text-[var(--color-accent)]">Экономлю время и бюджет</span>
    </p>

    <p class="reveal mt-2 sm:mt-3 flex items-center justify-center gap-2 text-lg font-medium text-[var(--color-accent)]" style="animation-delay: .11s;">
      <span class="shrink-0 animate-pulse flex items-center justify-center" style="animation-delay: 1s">
        <svg class="h-5 w-5 svg-icon-reveal" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06m-2.7-2.7L3 16.8v4.8m2.58-5.84l5.84-5.84" />
        </svg>
      </span>
      От идеи до запуска
    </p>

    <!-- Бегущая строка: только продукты/услуги (без инструментов); глоссарий подсвечивает термины; в конце первого span « • » для бесшовного стыка -->
    <div class="reveal mt-2 sm:mt-4 w-full overflow-hidden rounded-full bg-[var(--color-surface)]/50 border border-[var(--color-border)] py-3 px-4" style="animation-delay: .12s;" data-glossary>
      <div class="flex animate-marquee w-max">
        <span class="whitespace-nowrap text-sm text-[var(--color-text-muted)]">Боты в мессенджерах • Mini Apps • AI-агенты • Автоматизация • Парсинг • Автопостинг • Скрипты • Интеграции • </span>
        <span class="whitespace-nowrap text-sm text-[var(--color-text-muted)]">Боты в мессенджерах • Mini Apps • AI-агенты • Автоматизация • Парсинг • Автопостинг • Скрипты • Интеграции • </span>
      </div>
    </div>

    <!-- Терминал с метриками (русский, лаконичный) -->
    <div class="reveal mt-4 sm:mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/80 backdrop-blur-md p-4 sm:p-5 text-left font-mono text-xs sm:text-base w-full max-w-xl mx-auto overflow-hidden" style="animation-delay: .2s;">
      <div class="flex gap-2 mb-3 border-b border-[var(--color-border)] pb-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      <div class="text-[var(--color-text-muted)] space-y-2">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <span class="text-[var(--color-accent)] shrink-0">→</span>
          <span class="min-w-0 shrink"><span class="text-[var(--color-text)]">бот</span>.запуск()</span>
          <span class="w-full text-right text-xs sm:text-sm sm:w-auto sm:ml-auto">2 400+ лидов/мес</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <span class="text-[var(--color-accent)] shrink-0">→</span>
          <span class="min-w-0 shrink"><span class="text-[var(--color-text)]">агент</span>.работа()</span>
          <span class="w-full text-right text-xs sm:text-sm sm:w-auto sm:ml-auto">−80% рутины</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <span class="text-[var(--color-accent)] shrink-0">→</span>
          <span class="min-w-0 shrink"><span class="text-[var(--color-text)]">автоматизация</span>()</span>
          <span class="w-full text-right text-xs sm:text-sm sm:w-auto sm:ml-auto">24/7 онлайн</span>
        </div>
      </div>
    </div>

    <div class="reveal mt-6 sm:mt-12 flex flex-wrap items-center justify-center gap-4" style="animation-delay: .3s;">
      <Button href="/contact" variant="primary">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost">Смотреть кейсы</Button>
    </div>
  </div>
</section>
