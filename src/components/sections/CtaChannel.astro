---
/**
 * CTA-секция: призыв подписаться на Telegram-канал (поведенческие факторы, возвраты).
 */
import Button from '../common/Button.astro';
import { site } from '../../utils/site';
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="cta-channel-heading">
  <div
    class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-10 text-center sm:px-10 sm:py-14 transition-shadow duration-200 hover:shadow-glow-sm"
  >
    <h2
      id="cta-channel-heading"
      class="font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl"
    >
      Подписаться на канал
    </h2>
    <p class="mt-3 max-w-xl mx-auto text-[var(--color-text-muted)]">
      Кейсы, экспертные посты и технические решения — в Telegram.
    </p>
    <div class="mt-8">
      <Button href={site.tgChannelContent} variant="primary" external dataYmGoal="telegram_channel_click">
        {site.tgChannelContentHandle}
      </Button>
    </div>
  </div>
</section>
