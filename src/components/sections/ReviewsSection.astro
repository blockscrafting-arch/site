---
/**
 * Секция отзывов: статичный grid (не карусель).
 * Ресерч: grid конвертирует лучше carousel (NN/g).
 * Aggregate rating в заголовке, Kwork как verified source badge.
 */
const reviews = [
  {
    author: 'elena_bukina',
    project: 'Бот на Python с OCR',
    rating: 5,
    text: 'Редкое сочетание профессионализма и скорости выполнения. Рекомендую!',
  },
  {
    author: 'Nsltd',
    project: 'Система парсинга',
    rating: 5,
    text: 'Идеальная работа! Тот случай, один на сотню, когда человек делом подтверждает все свои слова.',
  },
  {
    author: 'postlunapark',
    project: 'Контент-завод: Telegram + VK + Дзен',
    rating: 5,
    text: 'Теперь все время могу потратить на более важные задачи, чем руками всё постить.',
  },
  {
    author: 'wildtorneo',
    project: 'Автоматизация email-рассылки',
    rating: 5,
    text: 'Всё было сделано профессионально, быстро и именно так как нужно! Рекомендую!',
  },
  {
    author: 'vitaly1303',
    project: 'Разработка бота для MAX',
    rating: 5,
    text: 'Все круто!',
  },
  {
    author: 'evgenijjstrannik',
    project: 'Парсер закрытых Telegram-чатов',
    rating: 5,
    text: 'Всё выполнено на высшем уровне, всем рекомендую.',
  },
  {
    author: 'svyat007',
    project: 'Веб-приложение (PWA) + WHOOP API',
    rating: 5,
    text: 'ОООООоооооочень быстро сделал. Я доволен !!',
  },
  {
    author: 'Кирилл Кушнерёв',
    project: 'Интернет-магазин Щенок Игруля',
    rating: 5,
    text: 'Спасибо за оперативную качественную разработку. Стали настоящей командой: предлагал новшества и помогал в реализации всех задумок. Умение слушать и слышать. Обязательно обращусь ещё!',
  },
];

const avgRating = '5.0';
const totalReviews = reviews.length;
---

<section class="reveal py-20 sm:py-28 px-4 sm:px-6 bg-[var(--color-surface)]" aria-labelledby="reviews-section-heading">
  <div class="mx-auto max-w-5xl">

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 mb-4">
        <div class="flex gap-0.5" aria-label={`Средняя оценка: ${avgRating} из 5`}>
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-lg font-bold text-[var(--color-text)]">{avgRating}</span>
      </div>
      <h2 id="reviews-section-heading" class="font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl">
        Все заказы — 5.0
      </h2>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">
        Реальные отзывы с
        <a href="https://kwork.ru/user/goutach" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">
          Kwork
          <svg class="h-3.5 w-3.5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </a>
      </p>
    </div>

    <div class="reveal-stagger grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((r, i) => {
        const isFeatured = r.author === 'Nsltd';
        return (
        <blockquote
          class:list={[
            'relative rounded-2xl border p-6 flex flex-col min-h-[200px]',
            isFeatured
              ? 'sm:col-span-2 border-[var(--color-accent)]/30 bg-[var(--color-bg)]'
              : 'border-[var(--color-border)] bg-[var(--color-bg)]',
          ]}
        >
          <div class="flex gap-0.5 mb-3" aria-label={`Оценка: ${r.rating} из 5`}>
            {Array.from({ length: r.rating }).map(() => (
              <svg class="h-3.5 w-3.5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class:list={['leading-relaxed flex-1', isFeatured ? 'text-lg text-[var(--color-text)]' : 'text-base text-[var(--color-text)]']}>«{r.text}»</p>
          <footer class="mt-4 flex items-center gap-3 border-t border-[var(--color-border)] pt-4">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-sm font-bold text-[var(--color-accent)]">
              {r.author.charAt(0)}
            </div>
            <cite class="not-italic min-w-0">
              <span class="block text-sm font-semibold text-[var(--color-text)]">{r.author}</span>
              <span class="block text-xs text-[var(--color-text-muted)] truncate">{r.project}</span>
            </cite>
          </footer>
        </blockquote>
        );
      })}
    </div>

  </div>
</section>
