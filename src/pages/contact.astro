---
/**
 * Контакты: Telegram и минимальная форма обратной связи.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import ContactForm from '../components/features/ContactForm';
import CopyButton from '../components/features/CopyButton';
import { site } from '../utils/site';

const webhookUrl = typeof import.meta.env.PUBLIC_CONTACT_WEBHOOK === 'string'
  ? import.meta.env.PUBLIC_CONTACT_WEBHOOK
  : '';
---

<BaseLayout
  title="Контакты — vlad.execute(_)"
  description={`Связаться с Владом: форма и Telegram ${site.tgChannelHandle}.`}
>
  <!-- Анимированный самолетик на заднем фоне -->
  <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
    <div class="absolute animate-airplane w-[250px] h-[250px] text-[var(--color-accent)]">
      <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <!-- Бумажный самолетик (вид сбоку-сверху, нос вправо) -->
        <!-- Правое крыло -->
        <path d="M 20 120 L 170 40 L 130 160 Z" fill="var(--color-bg)" />
        <!-- Левое крыло (нижнее) -->
        <path d="M 20 120 L 170 40 L 70 80 Z" />
        <!-- Сгиб/Дно -->
        <path d="M 70 80 L 130 160 L 90 110 Z" fill="currentColor" opacity="0.1" />
        <!-- Линии крыльев и центра -->
        <path d="M 20 120 L 90 110 L 170 40" />
        <path d="M 90 110 L 130 160" />
        <!-- Маленький след-ветер позади -->
        <path d="M 10 130 Q 0 140 -10 150" stroke-width="3" stroke-dasharray="4 4" opacity="0.4" />
        <path d="M 30 145 Q 15 160 5 170" stroke-width="3" stroke-dasharray="4 4" opacity="0.4" />
      </svg>
    </div>
  </div>
  <div class="contact-page reveal-stagger is-visible mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <h1 class="contact-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl">
      Контакты
    </h1>
    <p class="contact-intro mt-2 text-[var(--color-text-muted)]">
      Напишите в Telegram или через форму — отвечу в течение дня.
    </p>

    <section class="contact-telegram mt-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8" aria-labelledby="telegram-heading">
      <h2 id="telegram-heading" class="font-display text-lg font-semibold text-[var(--color-text)]">
        Telegram
      </h2>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Основной канал связи для заказов и вопросов.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Button href={site.tgChannel} variant="primary" external class="shadow-glow-sm">
          Написать в Telegram
        </Button>
        <a
          href={site.tgChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center text-[var(--color-accent)] hover:underline font-medium transition-colors"
        >
          {site.tgChannelHandle} <span class="ml-1 inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
        <CopyButton client:load value={site.tgChannelHandle} label="Скопировать" copiedLabel="Скопировано!" />
      </div>
    </section>

    <section class="contact-form-section mt-10" aria-labelledby="form-heading">
      <h2 id="form-heading" class="font-display text-lg font-semibold text-[var(--color-text)]">
        Форма обратной связи
      </h2>
      <ContactForm client:load webhookUrl={webhookUrl} />
    </section>
  </div>
</BaseLayout>

