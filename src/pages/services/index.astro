---
/**
 * Обзорная страница услуг — world-class hub.
 * Иконки, outcomes, social proof strip, Linear-style card grid.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/common/Button.astro';
import { SERVICES } from '../../data/services';
import { site } from '../../utils/site';

const servicesListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Услуги vlad.execute(_)',
  description: 'Telegram-боты, AI-агенты, Mini Apps, автоматизация, парсинг, автопостинг, скрипты и интеграции.',
  numberOfItems: SERVICES.length,
  itemListElement: SERVICES.map((svc, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: svc.title,
    description: svc.seoDescription,
    url: `${site.url}/services/${svc.id}`,
  })),
};
---

<BaseLayout
  title="Услуги и цены — vlad.execute(_)"
  description="Telegram-боты, AI-агенты, Mini Apps, автоматизация, парсинг, автопостинг, скрипты и интеграции. Готовые решения от 5 000 р. Реальные проекты, реальные цифры."
  schema={servicesListSchema}
>
  <!-- Hero -->
  <section class="pt-6 pb-10 sm:pt-10 sm:pb-12 px-4 sm:px-6" aria-labelledby="services-hero-h1">
    <div class="mx-auto max-w-3xl">
      <p class="svc-eyebrow reveal">
        <span class="svc-eyebrow__dot"></span>
        Автоматизация · Боты · AI-агенты
      </p>
      <h1
        id="services-hero-h1"
        class="reveal font-display text-3xl font-black tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl"
        style="animation-delay:.04s"
      >
        Автоматизирую то,<br class="hidden sm:block" /> что занимает ваше время
      </h1>
      <p class="reveal mt-3 text-lg text-[var(--color-text-muted)] leading-snug max-w-xl" style="animation-delay:.08s">
        Один разработчик — ботики, агенты, парсеры, автопостинг. Готовое решение под задачу за 1–14 дней.
      </p>

      <!-- Social proof strip -->
      <div class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[var(--color-text-muted)]" style="animation-delay:.12s">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          от 5 000 р
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          ответ за 1 день
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-[var(--color-accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          реальные кейсы с цифрами
        </span>
      </div>
    </div>
  </section>

  <!-- Service cards grid -->
  <section class="px-4 sm:px-6 pb-16 sm:pb-20" aria-label="Каталог услуг">
    <div class="mx-auto max-w-5xl">
      <ul
        class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 reveal-stagger"
        role="list"
      >
        {SERVICES.map((svc) => (
          <li>
            <a href={`/services/${svc.id}`} class="svc-hub-card" data-ym-goal="services_card_click">
              <!-- Icon -->
              <div class="svc-hub-card__icon" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={svc.iconPath} />
                </svg>
              </div>

              <!-- Title -->
              <p class="svc-hub-card__title">{svc.title}</p>

              <!-- Outcomes -->
              <ul class="svc-hub-card__outcomes" role="list">
                {svc.outcomes.map((o) => (
                  <li class="svc-hub-card__outcome">{o}</li>
                ))}
              </ul>

              <!-- Footer: price + arrow -->
              <div class="svc-hub-card__footer">
                <span class="svc-hub-card__price">{svc.price}</span>
                <span class="svc-hub-card__arrow" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA под каталогом -->
      <div class="svc-cta-accent reveal mt-14 p-8 sm:p-10 text-center" style="animation-delay:.2s">
        <p class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl relative z-10">
          Не нашли свою задачу?
        </p>
        <p class="mt-2 text-[var(--color-text-muted)] relative z-10">
          Опишите — подберу решение и назову цену за один день.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 relative z-10">
          <Button href="https://t.me/goutach" variant="primary" dataYmGoal="cta_telegram" external>
            Написать в Telegram
          </Button>
          <Button href="/contact" variant="outline" dataYmGoal="cta_contact">
            Отправить заявку
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
