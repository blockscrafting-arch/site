---
/**
 * Детальная страница одной услуги — world-class редизайн.
 * Eyebrow label, pain points секция, feature grid, accent CTA.
 * 3-tier pricing (MVP / Стандарт / Под ключ) с recommended badge.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/common/Button.astro';
import { SERVICES, getServiceById } from '../../data/services';
import { site } from '../../utils/site';

export function getStaticPaths() {
  return SERVICES.map((svc) => ({ params: { id: svc.id } }));
}

const { id } = Astro.params;
const svc = getServiceById(id);

if (!svc) {
  return Astro.redirect('/services');
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: `${site.url}/services` },
    { '@type': 'ListItem', position: 3, name: svc.title, item: `${site.url}/services/${svc.id}` },
  ],
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: svc.title,
  description: svc.seoDescription,
  provider: {
    '@type': 'Person',
    name: 'Владислав Попович',
    url: site.url,
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'RUB',
    description: svc.price,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={`${svc.title} — vlad.execute(_)`}
  description={svc.seoDescription}
  schema={[breadcrumbJsonLd, serviceJsonLd]}
>
  <!-- Хлебные крошки -->
  <nav class="pt-4 sm:pt-6 px-4 sm:px-6" aria-label="Навигация по разделам">
    <div class="mx-auto max-w-3xl">
      <ol class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
        <li><a href="/" class="hover:text-[var(--color-accent)] transition-colors">Главная</a></li>
        <li aria-hidden="true" class="opacity-40">→</li>
        <li><a href="/services" class="hover:text-[var(--color-accent)] transition-colors">Услуги</a></li>
        <li aria-hidden="true" class="opacity-40">→</li>
        <li class="text-[var(--color-text)]" aria-current="page">{svc.title}</li>
      </ol>
    </div>
  </nav>

  <!-- ===== Hero ===== -->
  <section class="pt-6 pb-10 sm:pt-8 sm:pb-12 px-4 sm:px-6" aria-labelledby="service-h1">
    <div class="mx-auto max-w-3xl">
      <!-- Eyebrow label -->
      <p class="svc-eyebrow reveal">
        <span class="svc-eyebrow__dot"></span>
        Услуга
      </p>

      <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between" style="animation-delay:.04s">
        <h1
          id="service-h1"
          class="font-display text-3xl font-black tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl"
        >
          {svc.title}
        </h1>
      </div>

      <p class="reveal mt-3 text-lg text-[var(--color-text-muted)] leading-snug max-w-2xl" style="animation-delay:.08s">
        {svc.pitch}
      </p>

      <span class="reveal inline-flex mt-3 items-center rounded-full bg-[var(--color-accent)]/10 px-3.5 py-1 text-sm font-bold text-[var(--color-accent)]" style="animation-delay:.1s">
        {svc.price}
      </span>

      <!-- CTAs -->
      <div class="reveal mt-6 flex flex-wrap gap-3" style="animation-delay:.12s">
        <Button href="/contact" variant="primary" dataYmGoal="cta_contact_hero">
          Обсудить задачу
        </Button>
        <Button href={site.tgChannel} variant="outline" dataYmGoal="cta_telegram_hero" external>
          Написать в Telegram
        </Button>
      </div>

      <!-- Trust micro-badges -->
      <div class="reveal mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-text-muted)]" style="animation-delay:.14s">
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Оценка бесплатно за 1 день
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Рейтинг 5.0 на Kwork
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Ответ в тот же день
        </span>
      </div>
      <!-- Отзыв клиента (social proof в hero) -->
      {svc.review && (
        <div class="reveal mt-6 flex items-start gap-3 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4" style="animation-delay:.16s">
          <span class="mt-0.5 text-lg leading-none text-[var(--color-text-muted)] select-none" aria-hidden="true">"</span>
          <div>
            <p class="text-sm text-[var(--color-text-muted)] italic leading-relaxed">«{svc.review.text}»</p>
            <p class="mt-1.5 text-xs text-[var(--color-text-muted)]">
              <span class="font-medium text-[var(--color-text)]">{svc.review.author}</span> — {svc.review.project}
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ===== Pain Points ===== -->
  {svc.painPoints && svc.painPoints.length > 0 && (
    <section class="px-4 sm:px-6 pb-12" aria-labelledby="pain-heading">
      <div class="mx-auto max-w-3xl">
        <ul
          class="reveal grid gap-3 sm:grid-cols-2"
          role="list"
          style="animation-delay:.14s"
        >
          {svc.painPoints.map((pain) => (
            <li class="svc-pain-card">
              <svg class="svc-pain-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span class="svc-pain-text">{pain}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===== О задаче ===== -->
  <section class="px-4 sm:px-6 pb-12" aria-label="Описание услуги">
    <div class="mx-auto max-w-3xl">
      <div class="reveal rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8" style="animation-delay:.14s">
        <h2 class="font-display text-xl font-bold text-[var(--color-text)] mb-3">О задаче</h2>
        <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
          {svc.description}
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Что входит — Feature Grid ===== -->
  <section class="px-4 sm:px-6 pb-14" aria-labelledby="features-heading">
    <div class="mx-auto max-w-3xl">
      <h2
        id="features-heading"
        class="reveal font-display text-xl font-bold text-[var(--color-text)] mb-5"
        style="animation-delay:.15s"
      >
        Что входит
      </h2>
      <ul class="reveal grid gap-3 sm:grid-cols-2" role="list" style="animation-delay:.18s">
        {svc.features.map((f) => (
          <li class="svc-feature-card">
            <svg class="svc-feature-card__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="svc-feature-card__text">{f}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Варианты сотрудничества ===== -->
  {svc.packages && svc.packages.length > 0 && (
    <section class="px-4 sm:px-6 pb-14" aria-labelledby="packages-heading">
      <div class="mx-auto max-w-3xl">
        <h2
          id="packages-heading"
          class="reveal font-display text-xl font-bold text-[var(--color-text)] mb-2"
          style="animation-delay:.19s"
        >
          Варианты
        </h2>
        <p class="reveal text-sm text-[var(--color-text-muted)] mb-6" style="animation-delay:.2s">
          Выберите подходящий формат — или опишите задачу, подберу вариант.
        </p>

        <div class="reveal grid gap-4 sm:grid-cols-3" style="animation-delay:.22s">
          {/* Mobile: recommended first */}
          {[...svc.packages].sort((a, b) => (b.recommended ? 1 : 0) - (a.recommended ? 1 : 0)).map((pkg) => (
            <div
              class:list={[
                'relative flex flex-col rounded-2xl border p-5 sm:p-6 transition-all duration-300',
                pkg.recommended
                  ? 'border-[var(--color-accent)] bg-[var(--color-accent)]/[0.04] shadow-glow-sm'
                  : 'border-[var(--color-border)] bg-[var(--color-surface)]',
              ]}
              style={pkg.recommended ? `order: -1` : ''}
            >
              {pkg.recommended && (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center rounded-full bg-[var(--color-accent)] px-3 py-0.5 text-xs font-bold text-white">
                  Рекомендуем
                </span>
              )}

              <h3 class="font-display text-base font-bold text-[var(--color-text)]">{pkg.name}</h3>
              <p class="mt-1 text-2xl font-black text-[var(--color-accent)]">{pkg.price}</p>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-snug">{pkg.description}</p>

              <ul class="mt-4 flex-1 space-y-2" role="list">
                {pkg.items.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-[var(--color-text-muted)]">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a
                href={pkg.recommended ? site.tgChannel : '/contact'}
                target={pkg.recommended ? '_blank' : undefined}
                rel={pkg.recommended ? 'noopener noreferrer' : undefined}
                data-ym-goal="package_click"
                class:list={[
                  'mt-5 block w-full rounded-xl py-2.5 text-center text-sm font-semibold transition-colors',
                  pkg.recommended
                    ? 'bg-[var(--color-accent)] text-white hover:opacity-90'
                    : 'border border-[var(--color-border)] text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]',
                ]}
              >
                {pkg.recommended ? 'Выбрать' : pkg.name === 'MVP' ? 'Начать с MVP' : 'Обсудить'}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== Примеры проектов ===== -->
  {svc.relatedCases.length > 0 && (
    <section class="px-4 sm:px-6 pb-12" aria-labelledby="cases-heading">
      <div class="mx-auto max-w-3xl">
        <h2
          id="cases-heading"
          class="reveal font-display text-xl font-bold text-[var(--color-text)] mb-2"
          style="animation-delay:.2s"
        >
          Меньше слов. Больше метрик.
        </h2>
        <ul class="reveal grid gap-4 sm:grid-cols-2" role="list" style="animation-delay:.24s">
          {svc.relatedCases.map((c) => (
            <li>
              <a
                href={`/cases/${c.slug}`}
                data-ym-goal="service_case_click"
                class="group flex flex-col h-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-glow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
              >
                <p class="font-display font-semibold text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-snug">
                  {c.title}
                </p>
                {c.metric && (
                  <p class="mt-2 text-sm font-bold text-[var(--color-accent)]">{c.metric}</p>
                )}
                <div class="mt-auto pt-4 flex items-center justify-end">
                  <span class="text-xs text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity">
                    Читать кейс →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===== Accent CTA ===== -->
  <section class="px-4 sm:px-6 pb-20 sm:pb-28" aria-label="Связаться">
    <div class="mx-auto max-w-3xl">
      <div class="svc-cta-accent reveal p-8 sm:p-10 text-center" style="animation-delay:.28s">
        <h2 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl relative z-10">
          Бесплатная оценка за 1 день
        </h2>
        <p class="mt-2 text-[var(--color-text-muted)] relative z-10">
          Опишите задачу — назову цену и сроки. Без обязательств.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 relative z-10">
          <Button href="/contact" variant="primary" dataYmGoal="cta_contact">
            Начать проект
          </Button>
          <Button href={site.tgChannel} variant="outline" dataYmGoal="cta_telegram" external>
            Написать в Telegram
          </Button>
        </div>
        <p class="mt-4 text-sm text-[var(--color-text-muted)] relative z-10">
          Ответ в течение дня
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Другие услуги ===== -->
  <section class="px-4 sm:px-6 pb-16 border-t border-[var(--color-border)]" aria-label="Другие услуги">
    <div class="mx-auto max-w-3xl pt-10">
      <p class="text-sm text-[var(--color-text-muted)] mb-4">Другие услуги:</p>
      <ul class="flex flex-wrap gap-2" role="list">
        {SERVICES.filter((s) => s.id !== svc.id).map((s) => (
          <li>
            <a
              href={`/services/${s.id}`}
              class="inline-block rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors"
            >
              {s.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
