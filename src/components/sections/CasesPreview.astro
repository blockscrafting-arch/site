---
/**
 * Превью кейсов на главной: bento-сетка, первый кейс wide.
 * Метрика крупным шрифтом как главный визуал карточки. Без SVG-иллюстраций.
 * CSS reveal, без GSAP.
 */
import { getCollection } from 'astro:content';
const allCases = await getCollection('cases');
const cases = allCases.filter((c) => !c.data.draft).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
/** 6 новейших кейсов по дате — блок обновляется автоматически при добавлении. */
const featured = cases.slice(0, 6);
---

<section class="py-20 sm:py-28 px-4 sm:px-6 relative overflow-hidden bg-[var(--color-surface)]" aria-labelledby="cases-preview-heading">
  <div class="mx-auto max-w-6xl">
    <h2 id="cases-preview-heading" class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl text-center">
      Меньше рук. Больше результата.
    </h2>

    <div class="reveal-stagger mt-16 grid gap-4 sm:grid-cols-2">
      {featured.map((c, i) => {
        const metric = c.data.metrics?.[0];
        const isWide = i === 0;
        return (
          <a
            href={`/cases/${c.slug}`}
            class:list={[
              'case-preview-card group block rounded-2xl border border-[var(--color-border)] p-6 sm:p-8 relative overflow-hidden border-t-2',
              isWide && 'sm:col-span-2',
            ]}
            style={c.data.accentColor ? `border-top-color: ${c.data.accentColor}; background: color-mix(in srgb, ${c.data.accentColor} 4%, var(--color-bg))` : ''}
          >
            {/* Верхняя часть: метрика до → после или одиночное значение */}
            {metric && metric.before != null && metric.after != null ? (
              <span class:list={[
                'flex items-baseline flex-wrap gap-x-2 font-display font-black leading-none',
                isWide ? 'gap-y-1' : '',
              ]}>
                <span class:list={[
                  'text-[var(--color-text-muted)] opacity-50 line-through',
                  isWide ? 'text-3xl sm:text-4xl' : 'text-2xl sm:text-3xl',
                ]}>{metric.before}</span>
                <span class="text-[var(--color-text-muted)] opacity-30 text-xl font-normal">→</span>
                <span class:list={[
                  'text-[var(--color-accent)]',
                  isWide ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl',
                ]}>{metric.after}</span>
              </span>
            ) : metric && metric.value && (
              <span class:list={[
                'block font-display font-black text-[var(--color-accent)] leading-none',
                isWide ? 'text-5xl sm:text-6xl' : 'text-4xl sm:text-5xl',
              ]}>
                {metric.value}
              </span>
            )}
            {metric && (
              <span class="block mt-2 text-sm text-[var(--color-text-muted)]">{metric.label}</span>
            )}

            <h3 class="mt-6 font-display font-semibold text-[var(--color-text)] text-lg">{c.data.title}</h3>
            <p class="mt-2 text-base text-[var(--color-text-muted)] line-clamp-2">{c.data.description}</p>

            {/* Glow при hover */}
            <div class="absolute -bottom-24 -right-24 w-48 h-48 rounded-full bg-[var(--color-accent)]/0 group-hover:bg-[var(--color-accent)]/5 blur-3xl transition-all duration-500 pointer-events-none" aria-hidden="true"></div>
          </a>
        );
      })}

      {/* Карточка «Все кейсы» — заполняет пустую ячейку в bento-сетке */}
      <a
        href="/cases"
        class="case-preview-card group flex flex-col items-center justify-center text-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-muted)]/20 hover:bg-[var(--color-surface-muted)]/50 p-6 sm:p-8 relative overflow-hidden transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
      >
        <span class="text-xl font-display font-medium text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
          Все кейсы <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
        <span class="mt-2 text-sm text-[var(--color-text-muted)]">Ещё {cases.length - featured.length} проектов</span>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 rounded-full bg-[var(--color-accent)]/0 group-hover:bg-[var(--color-accent)]/5 blur-3xl transition-all duration-500 pointer-events-none" aria-hidden="true"></div>
      </a>
    </div>
  </div>
</section>
