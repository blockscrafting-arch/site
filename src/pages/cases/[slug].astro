---
/**
 * Страница одного кейса с уникальным оформлением (accentColor, layout).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Badge from '../../components/common/Badge.astro';
import Button from '../../components/common/Button.astro';
import { site } from '../../utils/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const cases = await getCollection('cases');
  return cases.filter((c) => !c.data.draft).map((entry) => ({ params: { slug: entry.slug } }));
};

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug');
const cases = await getCollection('cases');
const entry = cases.find((e) => e.slug === slug);
if (!entry) throw new Error(`Case not found: ${slug}`);

const { Content } = await entry.render();
const data = entry.data;
const { title, description, result, stack, metrics, accentColor, layout, problem, testimonial, productLogo, productLink, productName, screenshots, date, heroImage } = data;
const caseOgImage = heroImage ?? (screenshots && screenshots.length > 0 ? screenshots[0] : undefined);

/** Похожие кейсы: пересечение категорий, добор по дате. */
const published = cases.filter((c) => !c.data.draft && c.slug !== slug);
const myCats = new Set(data.categories ?? []);
const withScore = published.map((c) => {
  const overlap = (c.data.categories ?? []).filter((cat) => myCats.has(cat)).length;
  const t = c.data.date?.getTime() ?? 0;
  return { entry: c, overlap, t };
});
withScore.sort((a, b) => {
  if (b.overlap !== a.overlap) return b.overlap - a.overlap;
  return b.t - a.t;
});
let relatedCases = withScore.filter((x) => x.overlap > 0).slice(0, 3).map((x) => x.entry);
if (relatedCases.length < 3) {
  const taken = new Set(relatedCases.map((c) => c.slug));
  const filler = withScore
    .map((x) => x.entry)
    .filter((c) => !taken.has(c.slug))
    .slice(0, 3 - relatedCases.length);
  relatedCases = [...relatedCases, ...filler];
}
const showProductCard = productLogo && productLink;
const accent = accentColor ?? '#10b981';
const layoutType = layout ?? 'default';

const caseUrl = `${site.url}/cases/${slug}`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Кейсы', item: `${site.url}/cases` },
    { '@type': 'ListItem', position: 3, name: title, item: caseUrl },
  ],
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? undefined,
  url: caseUrl,
  author: { '@id': `${site.url}/#person` },
  ...(date && { datePublished: date.toISOString().slice(0, 10) }),
};
---

<BaseLayout title={`${title} — Кейсы | vlad.execute(_)`} description={description} schema={[breadcrumbSchema, articleSchema]} image={caseOgImage} ogType="article" publishedTime={date ? date.toISOString().slice(0, 10) : undefined}>
  <article
    class="case-detail"
    style={`--case-accent: ${accent}; --case-accent-glow: ${accent}40`}
    data-layout={layoutType}
  >
    <header
      class="case-hero rounded-b-3xl border-b border-[var(--color-border)] px-4 py-16 sm:px-6 sm:py-20 lg:px-8"
      style={{ backgroundColor: `${accent}12`, borderColor: `${accent}30` }}
    >
      <div class="mx-auto max-w-3xl case-hero-inner reveal-stagger is-visible">
        <a
          href="/cases"
          data-ym-goal="cta_cases"
          class="group case-back mb-6 inline-flex items-center text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
        >
          <span class="mr-1 inline-block transition-transform duration-300 group-hover:-translate-x-1">←</span> Кейсы
        </a>
        <h1 class="case-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl">
          {title}
        </h1>
        {description && (
          <p class="case-desc mt-4 text-lg text-[var(--color-text-muted)]">{description}</p>
        )}
        {showProductCard && (
          <section class="case-product-card mt-6" aria-labelledby="case-product-heading">
            <h2 id="case-product-heading" class="sr-only">Продукт</h2>
            <a
              href={productLink}
              target="_blank"
              rel="noopener noreferrer"
              data-ym-goal="case_product_open"
              class="case-product-card__link group flex flex-col sm:flex-row items-center gap-4 sm:gap-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 transition-all duration-300 hover:border-[var(--case-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--case-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]"
            >
              <div class="case-product-card__logo flex-shrink-0 w-24 h-24 sm:w-28 sm:h-28 rounded-xl overflow-hidden bg-[var(--color-surface-muted)] flex items-center justify-center p-2 ring-1 ring-[var(--color-border)]">
                <img
                  src={productLogo}
                  alt={productName ?? 'Логотип продукта'}
                  class="max-w-full max-h-full object-contain"
                  width="96"
                  height="96"
                  loading="lazy"
                />
              </div>
              <div class="case-product-card__body flex-1 text-center sm:text-left min-w-0">
                {productName && (
                  <span class="font-display text-xl font-semibold text-[var(--color-text)] block">{productName}</span>
                )}
                <span class="inline-flex items-center gap-1.5 mt-1 text-sm font-medium text-[var(--case-accent)] group-hover:underline">
                  Открыть в Telegram
                  <svg class="w-4 h-4 flex-shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </span>
              </div>
            </a>
          </section>
        )}
        {((stack ?? []).length > 0) && (
          <div class="case-stack mt-6 flex flex-wrap gap-2">
            {(stack ?? []).map((s) => (
              <Badge variant="emerald">{s}</Badge>
            ))}
          </div>
        )}
        {result && (
          <p
            class="case-result mt-6 rounded-xl px-4 py-3 text-sm font-medium"
            style={{ backgroundColor: `${accent}20`, color: accent }}
          >
            <strong>Результат:</strong> {result}
          </p>
        )}
        {metrics && metrics.length > 0 && (
          <ul class="case-metrics mt-6 flex flex-wrap gap-3" role="list">
            {metrics.map((m) => (
              <li
                class="rounded-xl border px-4 py-3 text-sm bg-[var(--color-surface)] border-[var(--color-border)]"
              >
                <span class="font-bold" style={{ color: accent }}>
                  {m.prefix ?? ''}{m.value}{m.suffix ?? ''}
                </span>
                <span class="text-[var(--color-text-muted)]"> — {m.label}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="case-body reveal-stagger mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      {problem && (
        <section class="case-problem mb-10 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <h2 class="font-display text-lg font-semibold text-[var(--color-text)]">Проблема</h2>
          <p class="mt-2 text-[var(--color-text-muted)]">{problem}</p>
        </section>
      )}
      {screenshots && screenshots.length > 0 && (
        <section class="case-screenshots mb-10" aria-label="Скриншоты проекта">
          <div class={`grid gap-4 ${screenshots.length === 1 ? '' : 'sm:grid-cols-2'}`}>
            {screenshots.map((src, i) => (
              <button
                type="button"
                class="case-screenshot-thumb group relative block w-full overflow-hidden rounded-2xl ring-1 ring-[var(--color-border)] cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--case-accent)]"
                data-src={src}
                data-alt={`${title} — скриншот ${i + 1}`}
                aria-label={`Открыть скриншот ${i + 1} на весь экран`}
              >
                <img
                  src={src}
                  alt={`${title} — скриншот ${i + 1}`}
                  class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
                <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-300 group-hover:bg-black/30">
                  <span class="flex items-center gap-2 rounded-full bg-black/70 px-4 py-2 text-sm font-medium text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100">
                    <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0zm-3-3v6m-3-3h6" />
                    </svg>
                    Открыть
                  </span>
                </span>
              </button>
            ))}
          </div>
        </section>
      )}
      <div class="prose prose-invert max-w-none prose-headings:font-display prose-a:text-[var(--color-accent)]">
        <Content />
      </div>
      {testimonial && (
        <blockquote
          class="mt-12 rounded-2xl border-l-4 px-6 py-4 italic text-[var(--color-text-muted)]"
          style={{ borderColor: accent }}
        >
          "{testimonial.text}" — {testimonial.author}
        </blockquote>
      )}
      {relatedCases.length > 0 && (
        <section class="case-related mt-14" aria-labelledby="case-related-heading">
          <h2 id="case-related-heading" class="font-display text-lg font-semibold text-[var(--color-text)]">
            Похожие кейсы
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {relatedCases.map((rel) => (
              <li>
                <a
                  href={`/cases/${rel.slug}`}
                  data-ym-goal="case_related_click"
                  class="block h-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 transition-all hover:border-[var(--color-accent)]/50 hover:shadow-glow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
                >
                  <span class="font-display font-semibold text-[var(--color-text)]">{rel.data.title}</span>
                  {rel.data.description && (
                    <span class="mt-2 block text-sm text-[var(--color-text-muted)] line-clamp-2">{rel.data.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="case-cta mt-14 flex flex-wrap gap-4">
        <Button href="/contact" variant="primary" dataYmGoal="cta_contact">
          Обсудить похожий проект
        </Button>
        <Button href="/cases" variant="ghost" dataYmGoal="cta_cases">
          Все кейсы
        </Button>
      </div>
    </div>
  </article>
</BaseLayout>

<!-- Лайтбокс для скриншотов кейса -->
<div
  id="case-lightbox"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/92 backdrop-blur-md p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Просмотр скриншота"
>
  <button
    id="case-lightbox-close"
    type="button"
    class="absolute right-4 top-4 rounded-full p-2 text-white/60 transition-colors hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50"
    aria-label="Закрыть"
  >
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <img
    id="case-lightbox-img"
    src=""
    alt=""
    class="max-h-[92vh] max-w-full rounded-2xl object-contain shadow-2xl"
  />
</div>

<script>
  (function () {
    const lb = document.getElementById('case-lightbox');
    const img = document.getElementById('case-lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('case-lightbox-close');

    function open(src: string, alt: string) {
      if (!lb || !img) return;
      img.src = src;
      img.alt = alt;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!lb || !img) return;
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
      setTimeout(() => { img.src = ''; }, 200);
    }

    document.querySelectorAll<HTMLButtonElement>('.case-screenshot-thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(btn.dataset.src ?? '', btn.dataset.alt ?? '');
      });
    });

    closeBtn?.addEventListener('click', close);

    lb?.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  })();
</script>
