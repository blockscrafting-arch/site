---
/**
 * Hero главной: центрированный текст, терминал с метриками (рус.), radial glow, без сторонних иллюстраций.
 * Анимация — CSS (reveal) + IntersectionObserver из BaseLayout. GSAP не используется.
 */
import Button from '../common/Button.astro';
import TypewriterHero from '../features/TypewriterHero';
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center px-4 py-24 sm:px-6 overflow-hidden">
  <!-- Radial glow фон -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] rounded-full bg-[var(--color-accent)]/8 blur-[120px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] rounded-full bg-[var(--color-accent-cyan)]/5 blur-[100px]"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <h1 class="reveal font-display text-4xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl lg:text-7xl">
      <TypewriterHero client:load class="!text-inherit min-h-[1.2em] inline-block" />
    </h1>

    <p class="reveal mt-6 text-lg text-[var(--color-text-muted)] sm:text-xl max-w-2xl mx-auto leading-relaxed" style="animation-delay: .1s;">
      Telegram-боты, AI-агенты, n8n — от идеи до запуска. <br class="hidden sm:block" />
      <span class="font-semibold text-[var(--color-accent)]">Экономлю время и бюджет.</span>
    </p>

    <!-- Терминал с метриками (русский, лаконичный) -->
    <div class="reveal mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/80 backdrop-blur-md p-5 text-left font-mono text-sm sm:text-base max-w-xl mx-auto overflow-hidden" style="animation-delay: .2s;">
      <div class="flex gap-2 mb-3 border-b border-[var(--color-border)] pb-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      <div class="text-[var(--color-text-muted)] space-y-2">
        <div class="flex items-center"><span class="text-[var(--color-accent)] mr-2">→</span> <span class="text-[var(--color-text)]">бот</span>.запуск() <span class="text-[var(--color-text-muted)] ml-auto text-xs sm:text-sm">2 400+ лидов/мес</span></div>
        <div class="flex items-center"><span class="text-[var(--color-accent)] mr-2">→</span> <span class="text-[var(--color-text)]">агент</span>.работа() <span class="text-[var(--color-text-muted)] ml-auto text-xs sm:text-sm">−80% рутины</span></div>
        <div class="flex items-center"><span class="text-[var(--color-accent)] mr-2">→</span> <span class="text-[var(--color-text)]">автоматизация</span>() <span class="text-[var(--color-text-muted)] ml-auto text-xs sm:text-sm">24/7 онлайн</span></div>
      </div>
    </div>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-4" style="animation-delay: .3s;">
      <Button href="/contact" variant="primary">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost">Смотреть кейсы</Button>
    </div>
  </div>
</section>
