---
/**
 * Визуал для страницы «Обо мне»: абстрактный блок «разработчик + инструменты».
 */
---

<figure class="about-visual rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 flex items-center justify-center" aria-hidden="true">
  <svg viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[200px] h-auto opacity-90">
    <!-- Голова/аватар (абстрактно) -->
    <circle cx="50" cy="45" r="22" fill="var(--color-surface-muted)" stroke="var(--color-accent)" stroke-width="2" />
    <circle cx="50" cy="42" r="6" fill="var(--color-accent)" opacity="0.8" />
    <!-- Тело/блок -->
    <rect x="35" y="72" width="30" height="28" rx="4" fill="var(--color-surface-muted)" stroke="var(--color-border)" stroke-width="1" />
    <path d="M42 82 L58 82 M42 88 L55 88" stroke="var(--color-text-muted)" stroke-width="1.2" stroke-opacity="0.7" stroke-linecap="round" />
    <!-- Инструменты справа -->
    <rect x="95" y="35" width="28" height="18" rx="3" fill="var(--color-surface-muted)" stroke="var(--color-accent)" stroke-width="1.2" />
    <path d="M100 45 L118 45" stroke="var(--color-accent)" stroke-width="1" stroke-linecap="round" />
    <rect x="95" y="58" width="28" height="18" rx="3" fill="var(--color-surface-muted)" stroke="var(--color-accent-cyan)" stroke-width="1.2" />
    <circle cx="104" cy="67" r="2.5" fill="var(--color-accent-cyan)" />
    <rect x="95" y="81" width="28" height="18" rx="3" fill="var(--color-surface-muted)" stroke="var(--color-accent)" stroke-width="1.2" />
    <path d="M100 88 L102 92 L106 88 L108 92" stroke="var(--color-accent)" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <!-- Связь -->
    <path d="M65 58 L88 52" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="3 2" fill="none" stroke-opacity="0.8" />
  </svg>
</figure>
