---
/**
 * Секция «Проблема — Решение»: горизонтальный скролл с карточками.
 */
import GlitchHeading from '../features/GlitchHeading';
const items = [
  { problem: 'Менеджеры тонут в заявках', solution: 'AI-бот квалифицирует и распределяет за секунды', icon: 'inbox' },
  { problem: 'Рутина съедает часы каждый день', solution: 'n8n-воркфлоу делает рутину за вас 24/7', icon: 'clock' },
  { problem: 'Клиенты ждут ответа часами', solution: 'Чат-бот отвечает мгновенно и передаёт живому менеджеру', icon: 'chat' },
  { problem: 'Данные размазаны по таблицам и чатам', solution: 'Один бот или агент собирает всё в CRM и отчёты', icon: 'db' },
  { problem: 'Нужно масштабировать, но руки не доходят', solution: 'Автоматизация под ключ: от брифа до запуска', icon: 'rocket' },
];
---

<section class="py-20 sm:py-28 overflow-hidden" aria-labelledby="problem-solution-heading">
  <div class="problem-solution-header mb-12 px-4 sm:px-6 text-center">
    <h2 id="problem-solution-heading" class="reveal problem-solution-heading font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl md:text-4xl" aria-label="Узнаёте себя?">
      <GlitchHeading text="Узнаёте себя?" client:visible preset="encrypted" />
    </h2>
    <p class="reveal problem-solution-desc mt-4 text-[var(--color-text-muted)] max-w-2xl mx-auto" style="animation-delay:.06s">
      Проблемы, которые я решаю автоматизацией и ботами.
    </p>
    <p class="problem-solution-swipe-hint sm:hidden mt-3 text-sm text-[var(--color-text-muted)] flex items-center justify-center gap-2" aria-hidden="true">
      <span>Листайте</span>
      <svg class="h-4 w-4 shrink-0 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </p>
  </div>
  <div class="problem-solution-wrap relative px-4 sm:px-6">
    <div class="problem-solution-fade sm:hidden pointer-events-none absolute right-4 top-0 bottom-8 w-12 z-[1]" style="background: linear-gradient(to left, var(--color-bg) 0%, transparent 100%);" aria-hidden="true"></div>
    <button
      type="button"
      class="problem-solution-prev absolute left-0 top-1/2 z-10 -translate-y-1/2 hidden sm:flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] shadow-lg transition-colors hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] disabled:opacity-40 disabled:pointer-events-none"
      aria-label="Предыдущая карточка"
    >
      <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button
      type="button"
      class="problem-solution-next absolute right-0 top-1/2 z-10 -translate-y-1/2 hidden sm:flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] shadow-lg transition-colors hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] disabled:opacity-40 disabled:pointer-events-none"
      aria-label="Листать вправо"
    >
      <svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
    <div class="problem-solution-track flex gap-6 pb-4 pl-4 pr-4 sm:pl-14 sm:pr-14 overflow-x-auto snap-x snap-mandatory scrollbar-hide cursor-grab" style="scrollbar-width: none; -ms-overflow-style: none;" data-horizontal-scroll>
    {items.map((item, i) => (
      <article
        class="problem-solution-card flex-shrink-0 w-[85vw] sm:w-[400px] snap-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 shadow-lg"
        style={`animation-delay: ${i * 0.1}s`}
      >
        <div class="flex items-start gap-4">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-[var(--color-accent-muted)] text-[var(--color-accent)]" aria-hidden="true">
            {item.icon === 'inbox' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293H7.586a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 003.586 13H2" /></svg>)}
            {item.icon === 'clock' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>)}
            {item.icon === 'chat' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>)}
            {item.icon === 'db' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" /></svg>)}
            {item.icon === 'rocket' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>)}
          </span>
          <div>
            <p class="text-[var(--color-text-muted)] text-sm font-medium">{item.problem}</p>
            <p class="mt-2 text-[var(--color-text)] font-semibold">{item.solution}</p>
          </div>
        </div>
      </article>
    ))}
    </div>
    <div class="problem-solution-bar mt-2 h-1 w-full overflow-hidden rounded-full bg-[var(--color-surface-muted)]" role="presentation">
      <div class="problem-solution-bar-fill h-full rounded-full bg-[var(--color-accent)] transition-[width] duration-150" style="width: 0%"></div>
    </div>
  </div>
</section>

<script>
  // На ПК: колёсико мыши — горизонтальный скролл, перетаскивание — листание
  const track = document.querySelector('[data-horizontal-scroll]');
  if (track) {
    track.addEventListener('wheel', function (e) {
      const canScrollLeft = track.scrollLeft > 0;
      const maxScroll = track.scrollWidth - track.clientWidth;
      const canScrollRight = track.scrollLeft < maxScroll;
      if (e.deltaY !== 0 && (e.deltaY > 0 ? canScrollRight : canScrollLeft)) {
        track.scrollLeft += e.deltaY;
        e.preventDefault();
      }
    }, { passive: false });

    let isDown = false, startX, startScrollLeft;
    track.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return;
      isDown = true;
      startX = e.clientX;
      startScrollLeft = track.scrollLeft;
      track.classList.add('cursor-grabbing', 'select-none');
      track.classList.remove('cursor-grab');
    });
    function stopDrag() {
      isDown = false;
      track?.classList.remove('cursor-grabbing', 'select-none');
      track?.classList.add('cursor-grab');
    }
    window.addEventListener('mouseleave', stopDrag);
    window.addEventListener('mouseup', stopDrag);
    track.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = startScrollLeft - (e.clientX - startX);
    });

    // Кнопки влево/вправо и полоска прогресса
    const prevBtn = document.querySelector('.problem-solution-prev');
    const nextBtn = document.querySelector('.problem-solution-next');
    const barFill = document.querySelector('.problem-solution-bar-fill');
    const step = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (prevBtn) {
        prevBtn.disabled = track.scrollLeft <= 0;
      }
      if (nextBtn) {
        nextBtn.disabled = maxScroll <= 0 || track.scrollLeft >= maxScroll - 1;
      }
      if (barFill) {
        const pct = maxScroll > 0 ? (track.scrollLeft / maxScroll) * 100 : 0;
        barFill.style.width = pct + '%';
      }
    };
    step();
    track.addEventListener('scroll', step);
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -track.clientWidth * 0.85, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: track.clientWidth * 0.85, behavior: 'smooth' });
      });
    }
    const bar = document.querySelector('.problem-solution-bar');
    if (bar && barFill) {
      bar.addEventListener('click', (e) => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (maxScroll <= 0) return;
        const rect = bar.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const pct = Math.max(0, Math.min(1, x / rect.width));
        track.scrollTo({ left: pct * maxScroll, behavior: 'smooth' });
      });
      bar.classList.add('cursor-pointer');
    }
  }
</script>
