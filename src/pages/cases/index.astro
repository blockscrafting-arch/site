---
/**
 * Список кейсов с фильтрацией по категории и уникальными карточками.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/common/Badge.astro';

const allCases = await getCollection('cases');
const cases = allCases.filter((c) => !c.data.draft);
const sorted = [...cases].sort((a, b) => {
  const dateA = a.data.date?.getTime() ?? 0;
  const dateB = b.data.date?.getTime() ?? 0;
  return dateB - dateA;
});

const categories = [
  { id: 'all', label: 'Все' },
  { id: 'bot', label: 'Боты' },
  { id: 'ai-agent', label: 'AI-агенты' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'mini-app', label: 'Mini Apps' },
  { id: 'parser', label: 'Парсеры' },
  { id: 'script', label: 'Скрипты' },
  { id: 'autoposting', label: 'Автопостинг' },
] as const;
---

<BaseLayout
  title="Кейсы — vlad.execute(_)"
  description="Реальные проекты: автоматизация, боты, AI-агенты, n8n, Python."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 relative">
    <div class="relative flex justify-center sm:justify-start">
      <div class="relative inline-flex items-center justify-center">
        <div class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-[60%] sm:-translate-x-[55%] w-28 h-28 sm:w-40 sm:h-40 opacity-[0.3] text-[var(--color-accent)] pointer-events-none -z-10" aria-hidden="true">
          <svg class="w-full h-full" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Вылетающие документы -->
            <g class="animate-doc-1">
              <rect x="45" y="25" width="36" height="48" rx="4" fill="var(--color-bg)" stroke="currentColor" />
              <line x1="52" y1="38" x2="74" y2="38" />
              <line x1="52" y1="50" x2="68" y2="50" />
              <line x1="52" y1="62" x2="72" y2="62" />
            </g>
            <g class="animate-doc-2">
              <rect x="118" y="35" width="36" height="48" rx="4" fill="var(--color-bg)" stroke="currentColor" />
              <line x1="125" y1="48" x2="147" y2="48" />
              <line x1="125" y1="60" x2="141" y2="60" />
            </g>
            <!-- Корпус дипломата -->
            <rect x="25" y="88" width="150" height="85" rx="8" fill="var(--color-bg)" />
            <line x1="25" y1="118" x2="175" y2="118" stroke-width="1.5" opacity="0.5" />
            <line x1="25" y1="148" x2="175" y2="148" stroke-width="1.5" opacity="0.5" />
            <!-- Ручка сверху -->
            <path d="M 65 88 V 48 C 65 38 135 38 135 48 V 88" stroke-width="5" fill="none" />
            <line x1="55" y1="88" x2="145" y2="88" stroke-width="2" />
            <!-- Замки -->
            <rect x="48" y="78" width="18" height="18" rx="3" fill="currentColor" stroke="none" />
            <rect x="134" y="78" width="18" height="18" rx="3" fill="currentColor" stroke="none" />
          </svg>
        </div>
        <h1 class="reveal cases-page-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl relative z-10">
          Кейсы
        </h1>
      </div>
    </div>
    <p class="mt-2 text-[var(--color-text-muted)]">
      Разборы реальных проектов с результатами и цифрами.
    </p>

    <div class="cases-filters mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Фильтр по категории">
      {categories.map((cat) => (
        <button
          type="button"
          class="cases-filter-btn rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] data-[active]:border-[var(--color-accent)] data-[active]:bg-[var(--color-accent-muted)] data-[active]:text-[var(--color-accent)]"
          data-category={cat.id}
          data-active={cat.id === 'all' ? 'true' : undefined}
        >
          {cat.label}
        </button>
      ))}
    </div>

    {sorted.length === 0 ? (
      <p class="mt-12 text-[var(--color-text-muted)]">Кейсы скоро появятся.</p>
    ) : (
      <ul class="reveal-stagger cases-grid mt-10 grid gap-6 sm:grid-cols-2" role="list">
        {sorted.map((entry) => {
          const accent = entry.data.accentColor ?? '#10b981';
          const cats = entry.data.categories?.length ? entry.data.categories : [];
          const categoryList = cats.join(' ');
          return (
            <li class="case-card-item" data-category={categoryList}>
              <a
                href={`/cases/${entry.slug}`}
                class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-300 hover:border-opacity-80 hover:shadow-glow-sm"
              >
                <span
                  class="mb-4 block h-1 w-12 rounded-full"
                  style={{ backgroundColor: accent }}
                  aria-hidden="true"
                />
                <h2 class="font-display font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                  {entry.data.title}
                </h2>
                <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2">
                  {entry.data.description}
                </p>
                {entry.data.result && (
                  <p class="mt-3 text-sm font-medium line-clamp-2" style={{ color: accent }}>
                    {entry.data.result}
                  </p>
                )}
                {entry.data.metrics && entry.data.metrics.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" role="list">
                    {entry.data.metrics.slice(0, 3).map((m) => (
                      <li class="rounded-md bg-[var(--color-surface-muted)] px-2 py-1 text-xs font-medium text-[var(--color-text-muted)]">
                        <span style={{ color: accent }}>{m.value}</span> — {m.label}
                      </li>
                    ))}
                  </ul>
                )}
                {entry.data.stack && entry.data.stack.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {entry.data.stack.map((s) => (
                      <Badge variant="gray">{s}</Badge>
                    ))}
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.cases-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.category;
      document.querySelectorAll('.cases-filter-btn').forEach((b) => b.removeAttribute('data-active'));
      btn.setAttribute('data-active', 'true');
      document.querySelectorAll('.case-card-item').forEach((el) => {
        const itemCats = ((el as HTMLElement).dataset.category ?? '').split(' ').filter(Boolean);
        const show = cat === 'all' || itemCats.includes(cat);
        (el as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>
