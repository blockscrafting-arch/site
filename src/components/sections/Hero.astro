---
/**
 * Hero главной: контент по центру, full-bleed marquee внизу.
 * Trust-bar — чистый текст без иконок. Акцент на typewriter.
 */
import Button from '../common/Button.astro';
import TypewriterHero from '../features/TypewriterHero';
---

<section class="relative min-h-[100dvh] flex flex-col overflow-hidden">
  <!-- Radial glow фон -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[700px] rounded-full bg-[var(--color-accent)]/6 blur-[140px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] rounded-full bg-[var(--color-accent-cyan)]/4 blur-[120px]"></div>
  </div>

  <!-- Основной контент героя — занимает всё пространство кроме ленты -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 py-16 sm:py-20 sm:px-6 text-center">
    <p class="reveal text-lg sm:text-xl font-medium text-[var(--color-text-muted)] tracking-wide">
      Вы по адресу.
    </p>

    <h1 class="reveal mt-3 sm:mt-5 font-display text-[clamp(2.4rem,8vw,6rem)] font-black tracking-tighter leading-[1.05] min-h-[1.15em] flex items-center justify-center max-w-4xl" style="animation-delay:.05s;">
      <TypewriterHero client:load />
    </h1>

    <div class="reveal mt-8 sm:mt-12 flex flex-wrap items-center justify-center gap-4" style="animation-delay:.15s;">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost" dataYmGoal="cta_cases">Смотреть кейсы</Button>
    </div>

    <!-- Trust-bar: чистый текст, без иконок -->
    <p class="reveal mt-6 sm:mt-8 text-sm sm:text-base text-[var(--color-text-muted)]" style="animation-delay:.22s;">
      13 реализованных проектов
      <span class="mx-3 opacity-40" aria-hidden="true">·</span>
      от 5 000 ₽
      <span class="mx-3 opacity-40" aria-hidden="true">·</span>
      ответ в течение дня
    </p>
  </div>

  <!-- Full-bleed marquee strip — снизу, перед следующей секцией -->
  <div class="relative z-10 w-full overflow-hidden border-t border-[var(--color-border)] bg-[var(--color-surface)]/40 backdrop-blur-sm py-3 sm:py-3.5" aria-hidden="true">
    <div class="flex animate-marquee w-max">
      <span class="whitespace-nowrap text-sm sm:text-base text-[var(--color-text-muted)]">Боты в мессенджерах&nbsp;&nbsp;•&nbsp;&nbsp;Mini Apps&nbsp;&nbsp;•&nbsp;&nbsp;AI-агенты&nbsp;&nbsp;•&nbsp;&nbsp;Автоматизация&nbsp;&nbsp;•&nbsp;&nbsp;Парсинг&nbsp;&nbsp;•&nbsp;&nbsp;Автопостинг&nbsp;&nbsp;•&nbsp;&nbsp;Скрипты&nbsp;&nbsp;•&nbsp;&nbsp;Интеграции&nbsp;&nbsp;•&nbsp;&nbsp;Telegram&nbsp;&nbsp;•&nbsp;&nbsp;n8n&nbsp;&nbsp;•&nbsp;&nbsp;Python&nbsp;&nbsp;•&nbsp;&nbsp;LLM&nbsp;&nbsp;•&nbsp;&nbsp;RAG&nbsp;&nbsp;•&nbsp;&nbsp;</span>
      <span class="whitespace-nowrap text-sm sm:text-base text-[var(--color-text-muted)]" aria-hidden="true">Боты в мессенджерах&nbsp;&nbsp;•&nbsp;&nbsp;Mini Apps&nbsp;&nbsp;•&nbsp;&nbsp;AI-агенты&nbsp;&nbsp;•&nbsp;&nbsp;Автоматизация&nbsp;&nbsp;•&nbsp;&nbsp;Парсинг&nbsp;&nbsp;•&nbsp;&nbsp;Автопостинг&nbsp;&nbsp;•&nbsp;&nbsp;Скрипты&nbsp;&nbsp;•&nbsp;&nbsp;Интеграции&nbsp;&nbsp;•&nbsp;&nbsp;Telegram&nbsp;&nbsp;•&nbsp;&nbsp;n8n&nbsp;&nbsp;•&nbsp;&nbsp;Python&nbsp;&nbsp;•&nbsp;&nbsp;LLM&nbsp;&nbsp;•&nbsp;&nbsp;RAG&nbsp;&nbsp;•&nbsp;&nbsp;</span>
    </div>
  </div>
</section>
