---
/**
 * Визуализация автоматизации для Hero.
 * Схема: Telegram (Заявка) -> n8n (Обработка/AI) -> CRM (Сделка).
 * Стеклянные карточки, градиенты, анимация потока данных.
 */
const nodes = [
  { id: 'tg', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14v-4l4 2-4 2zm2.14-5.83l-1.38 6.4c-.08.38-.34.48-.68.29l-1.89-1.39-9.92 4.09c-.44.17-.45.43.1.66l2.55 7.97 5.96 2.01c2.72.91 3.23.4 3.73-2.67l.68-3.15c.34-1.57.68-3.14 1.02-4.71.04-.19-.07-.29-.25-.21z', label: 'Telegram', sub: 'New Lead', color: '#229ED9' },
  { id: 'n8n', icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5', label: 'n8n', sub: 'Process & AI', color: '#ff6b6b' },
  { id: 'crm', icon: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z', label: 'CRM / Sheets', sub: 'New Deal', color: '#10b981' },
];
---

<div class="relative w-full h-[280px] sm:h-[320px] select-none flex items-center justify-center scale-90 sm:scale-100 origin-center">
  <!-- Connections -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="line-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#229ED9" stop-opacity="0.2" />
        <stop offset="50%" stop-color="#ff6b6b" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#10b981" stop-opacity="0.2" />
      </linearGradient>
      <mask id="line-mask">
        <path d="M70 140 C140 140, 160 140, 230 140" stroke="white" stroke-width="4" fill="none" />
      </mask>
    </defs>
    <!-- Background Line -->
    <path d="M80 140 L240 140" stroke="url(#line-gradient)" stroke-width="2" stroke-dasharray="6 4" />
    
    <!-- Moving Packet Animation -->
    <circle r="4" fill="#fff" filter="url(#glow)">
      <animateMotion dur="3s" repeatCount="indefinite" path="M80 140 L240 140" />
    </circle>
  </svg>

  <!-- Nodes Container -->
  <div class="relative flex items-center gap-8 sm:gap-16 z-10">
    <!-- Telegram Node -->
    <div class="glass-card flex flex-col items-center gap-3 p-4 rounded-2xl w-28 bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xl transform transition hover:-translate-y-1 hover:shadow-cyan-500/20">
      <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-[#229ED9]/10 text-[#229ED9]">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.48-1.02-2.38-1.63-1.05-.71-.37-1.1.23-1.73.15-.16 2.8-2.58 2.85-2.8.01-.05.01-.1-.06-.14-.07-.04-.17-.03-.25-.01-.11.02-1.91 1.21-5.38 3.56-.51.35-1.01.53-1.44.52-.47-.01-1.38-.27-2.06-.48-.83-.26-1.48-.4-1.42-.84.03-.23.35-.47.96-.72 3.76-1.63 6.27-2.7 7.52-3.21 3.56-1.44 4.31-1.69 4.8-1.7.11 0 .35.03.5.16.13.11.17.27.18.42-.01.07-.01.13-.02.2z"/></svg>
      </div>
      <div class="text-center">
        <div class="font-bold text-sm text-[var(--color-text)]">Telegram</div>
        <div class="text-xs text-[var(--color-text-muted)]">New Lead</div>
      </div>
    </div>

    <!-- n8n Node (Center) -->
    <div class="glass-card flex flex-col items-center gap-3 p-5 rounded-2xl w-32 bg-[var(--color-surface)] border border-[var(--color-accent)] shadow-2xl shadow-emerald-500/10 transform scale-110 z-20">
      <div class="w-14 h-14 rounded-xl flex items-center justify-center bg-[var(--color-accent)] text-white shadow-lg shadow-emerald-500/30 animate-pulse-slow">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
      </div>
      <div class="text-center">
        <div class="font-bold text-sm text-[var(--color-text)]">n8n Core</div>
        <div class="text-xs text-[var(--color-text-muted)]">AI Processing</div>
      </div>
    </div>

    <!-- CRM Node -->
    <div class="glass-card flex flex-col items-center gap-3 p-4 rounded-2xl w-28 bg-[var(--color-surface)] border border-[var(--color-border)] shadow-xl transform transition hover:-translate-y-1 hover:shadow-purple-500/20">
      <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-purple-500/10 text-purple-500">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
      </div>
      <div class="text-center">
        <div class="font-bold text-sm text-[var(--color-text)]">CRM</div>
        <div class="text-xs text-[var(--color-text-muted)]">Create Deal</div>
      </div>
    </div>
  </div>
</div>

<style>
  .glass-card {
    backdrop-filter: blur(12px);
    background: rgba(var(--color-surface-rgb), 0.6);
  }
  @keyframes pulse-slow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.9; }
  }
  .animate-pulse-slow {
    animation: pulse-slow 3s ease-in-out infinite;
  }
</style>
