---
/**
 * Навигация по сайту (десктоп и мобильная панель).
 * В мобильной панели передаётся проп mobile — вертикальный список без горизонтального скролла.
 */
export interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const navItems = [
  { href: '/', label: 'Главная' },
  { href: '/services', label: 'Услуги' },
  { href: '/cases', label: 'Кейсы' },
  { href: '/blog', label: 'Блог' },
  { href: '/reviews', label: 'Отзывы' },
  { href: '/about', label: 'Обо мне' },
  { href: '/contact', label: 'Контакты' },
];
const currentPath = Astro.url.pathname;
---

<nav
  class:list={[
    'flex',
    mobile ? 'flex-col gap-6 text-lg' : 'items-center gap-6',
  ]}
  aria-label="Основное меню"
>
  {
    navItems.map(({ href, label }) => {
      const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
      const ymGoals = {
        '/services': 'nav_services',
        '/cases': 'nav_cases',
        '/reviews': 'nav_reviews',
        '/about': 'nav_about',
        '/contact': 'nav_contact',
      };
      const ymAttrs = ymGoals[href] ? { 'data-ym-goal': ymGoals[href] } : {};
      return (
        <a
          href={href}
          {...ymAttrs}
          class:list={[
            'nav-link relative text-sm font-medium transition-colors rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)]',
            mobile ? 'block w-full py-3 px-1' : 'px-1 py-0.5',
            isActive
              ? 'text-[var(--color-accent)] nav-link-active'
              : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
          ]}
        >
          {label}
        </a>
      );
    })
  }
</nav>
