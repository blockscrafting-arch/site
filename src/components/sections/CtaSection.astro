---
/**
 * Финальный CTA на главной. Минималистичный glow-блок. CSS reveal, без GSAP.
 */
import Button from '../common/Button.astro';
import { site } from '../../utils/site';
---

<section class="py-24 sm:py-32 px-4 sm:px-6" aria-labelledby="cta-heading">
  <div class="reveal mx-auto max-w-2xl text-center">
    <div class="relative rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-10 lg:p-14 overflow-hidden">
      <!-- Glow accent фон -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[200px] rounded-full bg-[var(--color-accent)]/10 blur-[80px]"></div>
      </div>

      <h2 id="cta-heading" class="relative flex flex-wrap items-center justify-center gap-2 text-center font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl md:text-3xl lg:text-4xl">
        <span class="shrink-0 animate-float-icon flex items-center justify-center">
          <svg class="h-8 w-8 svg-icon-reveal text-[var(--color-accent)] sm:h-9 sm:w-9" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </span>
        Готовы снять рутину с плеч?
      </h2>
      <p class="relative mt-4 text-[var(--color-text-muted)]">
        Опишите задачу — подберу решение и назову сроки. Отвечу в течение дня.
      </p>
      <div class="relative mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact" variant="primary">Обсудить задачу</Button>
        <a
          href={site.tgChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          Написать в Telegram
        </a>
      </div>
    </div>
  </div>
</section>
