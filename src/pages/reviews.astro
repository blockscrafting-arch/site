---
/**
 * Страница всех отзывов с фильтрацией по категории.
 * Данные из src/data/reviews.ts — единый источник правды.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import { reviews, CATEGORY_LABELS } from '../data/reviews';
import type { ReviewCategory } from '../data/reviews';
import { site } from '../utils/site';

const avgRating = '5.0';
const totalReviews = reviews.length;

const filterCategories: { id: ReviewCategory | 'all'; label: string }[] = [
  { id: 'all', label: 'Все' },
  { id: 'bot', label: 'Telegram-боты' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'parser', label: 'Парсинг' },
  { id: 'web-app', label: 'Web-приложение' },
  { id: 'content-factory', label: 'Контент-завод' },
];
---

<BaseLayout
  title="Отзывы клиентов — vlad.execute(_)"
  description={`${totalReviews} отзывов о проектах: Telegram-боты, автоматизация, парсинг, web-приложения. Средняя оценка ${avgRating} из 5.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Отзывы клиентов vlad.execute(_)',
    description: `${totalReviews} реальных отзывов о проектах. Средняя оценка ${avgRating} из 5.`,
    numberOfItems: totalReviews,
    itemListElement: reviews.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Review',
        reviewBody: r.text,
        author: { '@type': 'Person', name: r.author },
        name: r.project,
        reviewRating: {
          '@type': 'Rating',
          ratingValue: r.rating,
          bestRating: 5,
        },
        itemReviewed: {
          '@type': 'Person',
          name: 'Владислав Попович',
          url: site.url,
        },
      },
    })),
  }}
>
  <div class="mx-auto max-w-5xl px-4 pt-6 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8">

    <!-- Заголовок -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <div class="flex gap-0.5" aria-label={`Средняя оценка: ${avgRating} из 5`}>
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-2xl font-bold text-[var(--color-text)]">{avgRating}</span>
        <span class="text-sm text-[var(--color-text-muted)]">/ {totalReviews} отзывов</span>
      </div>
      <h1 class="font-display text-3xl font-black tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl">
        Отзывы клиентов
      </h1>
      <p class="mt-3 text-base sm:text-lg text-[var(--color-text-muted)]">
        Реальные отзывы от клиентов. Часть — с
        <a
          href="https://kwork.ru/user/goutach"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-medium text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors"
        >
          Kwork
          <svg class="h-3.5 w-3.5 text-[var(--color-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </a>
      </p>
    </div>

    <!-- Фильтры -->
    <div id="reviews-filters-inflow" class="relative -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <div
        class="flex items-center gap-2 overflow-x-auto pb-2"
        style="scrollbar-width: thin;"
        role="tablist"
        aria-label="Фильтр по категории"
      >
        {filterCategories.map((cat) => (
          <button
            type="button"
            class="reviews-filter-btn flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)] data-[active]:bg-[var(--color-accent-muted)] data-[active]:text-[var(--color-accent)]"
            data-category={cat.id}
            data-active={cat.id === 'all' ? 'true' : undefined}
          >
            {cat.label}
          </button>
        ))}
      </div>
      <div class="absolute right-0 top-0 bottom-2 w-14 pointer-events-none sm:hidden bg-[linear-gradient(to_right,transparent_0%,var(--color-accent-muted)_35%,var(--color-bg)_100%)]"></div>
    </div>

    <!-- Grid отзывов -->
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {reviews.map((r) => (
        <li class="reviews-card-item" data-category={r.category}>
          <blockquote class="h-full rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 flex flex-col min-h-[200px]">
            <span class="mb-2 inline-block self-start rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-[10px] font-medium text-[var(--color-text-muted)]">
              {r.label}
            </span>
            <div class="flex gap-0.5 mb-3" aria-label={`Оценка: ${r.rating} из 5`}>
              {Array.from({ length: r.rating }).map(() => (
                <svg class="h-3.5 w-3.5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-base leading-relaxed text-[var(--color-text)] flex-1">«{r.text}»</p>
            <footer class="mt-4 flex items-center gap-3 border-t border-[var(--color-border)] pt-4">
              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-sm font-bold text-[var(--color-accent)]">
                {r.author.charAt(0).toUpperCase()}
              </div>
              <cite class="not-italic min-w-0">
                <span class="block text-sm font-semibold text-[var(--color-text)]">{r.author}</span>
                <span class="block text-xs text-[var(--color-text-muted)] truncate">{r.project}</span>
              </cite>
            </footer>
          </blockquote>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <div class="mt-14 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 sm:p-10 text-center">
      <h2 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        Хотите такой же результат?
      </h2>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Опишите задачу — обсудим решение и назову цену за один день.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <Button href="/contact" variant="primary" dataYmGoal="cta_contact_from_reviews">
          Обсудить задачу
        </Button>
        <Button href="https://t.me/goutach" variant="outline" dataYmGoal="cta_telegram_from_reviews" external>
          Написать в Telegram
        </Button>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  (function () {
    document.querySelectorAll('.reviews-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.category;
        document.querySelectorAll('.reviews-filter-btn').forEach((b) => {
          b.removeAttribute('data-active');
          if ((b as HTMLElement).dataset.category === cat) b.setAttribute('data-active', 'true');
        });
        document.querySelectorAll('.reviews-card-item').forEach((el) => {
          (el as HTMLElement).style.display =
            cat === 'all' || (el as HTMLElement).dataset.category === cat ? '' : 'none';
        });
      });
    });
  })();
</script>
