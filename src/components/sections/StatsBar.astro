---
/**
 * Notion-стиль: крупные статистики в ряд.
 * Между кейсами и отзывами — числовое подкрепление доверия.
 */
const stats = [
  { value: '20+', label: 'проектов запущено' },
  { value: '5.0', label: 'рейтинг на Kwork' },
  { value: '1–3 дня', label: 'от задачи до MVP' },
  { value: '100%', label: 'положительных отзывов' },
];
---

<section class="py-16 sm:py-20 px-4 sm:px-6" aria-label="Статистика">
  <div class="mx-auto max-w-4xl">
    <div class="reveal grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-6 text-center">
      {stats.map((s, i) => (
        <div style={`animation-delay:${i * 0.06}s`}>
          <span class="block font-display text-3xl font-black text-[var(--color-accent)] sm:text-4xl leading-none">
            {s.value}
          </span>
          <span class="mt-2 block text-sm text-[var(--color-text-muted)]">
            {s.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
