---
/**
 * Визуализация "Терминал с кодом" для страницы About.
 * Показывает "интерфейс" TypeScript с определением стека.
 */
const codeLines = [
  { text: 'interface Developer {', indent: 0, color: 'text-blue-400' },
  { text: '  name: "Vlad";', indent: 2, color: 'text-purple-400' },
  { text: '  role: "Automation Architect";', indent: 2, color: 'text-green-400' },
  { text: '  stack: {', indent: 2, color: 'text-yellow-400' },
  { text: '    primary: ["n8n", "Python", "Telegram"];', indent: 4, color: 'text-gray-300' },
  { text: '    ai: ["OpenAI", "Claude", "RAG"];', indent: 4, color: 'text-gray-300' },
  { text: '    db: ["Postgres", "Supabase"];', indent: 4, color: 'text-gray-300' },
  { text: '  };', indent: 2, color: 'text-yellow-400' },
  { text: '}', indent: 0, color: 'text-blue-400' },
];
---

<div class="rounded-xl border border-[var(--color-border)] bg-[#1e1e1e] shadow-2xl overflow-hidden font-mono text-sm leading-relaxed select-none transform transition-transform duration-500 hover:scale-[1.01]">
  <!-- Header -->
  <div class="flex items-center gap-2 px-4 py-3 border-b border-[#333] bg-[#252526]">
    <div class="flex gap-1.5">
      <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
      <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
      <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
    </div>
    <div class="ml-4 text-xs text-gray-500 font-sans">about-me.ts — VLAD.EXECUTE</div>
  </div>
  
  <!-- Content -->
  <div class="p-6 overflow-x-auto">
    <code class="block">
      {codeLines.map((line, i) => (
        <div class="flex">
          <span class="w-8 text-gray-600 text-right mr-4 select-none flex-shrink-0">{i + 1}</span>
          <span style={`padding-left: ${line.indent * 0.5}rem`} class={line.color}>
            {line.text}
          </span>
        </div>
      ))}
      <div class="flex mt-2">
        <span class="w-8 text-gray-600 text-right mr-4 select-none flex-shrink-0">{codeLines.length + 1}</span>
        <span class="animate-pulse text-gray-400">_</span>
      </div>
    </code>
  </div>
</div>
