---
/**
 * Страница «Обо мне»: фото, цифры-блок, отзывы с Kwork, стек.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import { Image } from 'astro:assets';
import vladPortrait from '../assets/vlad-portrait.png';
import { site } from '../utils/site';

const stack = [
  { name: 'Telegram', icon: 'chat' },
  { name: 'n8n', icon: 'flow' },
  { name: 'Python', icon: 'code' },
  { name: 'Node.js', icon: 'circle' },
  { name: 'OpenAI', icon: 'brain' },
  { name: 'Gemini', icon: 'sparkle' },
  { name: 'OpenRouter', icon: 'arrows' },
  { name: 'Supabase', icon: 'database' },
  { name: 'PostgreSQL', icon: 'database' },
  { name: 'Google Sheets', icon: 'table' },
  { name: 'Airtable', icon: 'table' },
  { name: 'Docker', icon: 'box' },
  { name: 'RAG', icon: 'search' },
  { name: 'webhook', icon: 'link' },
];

const metrics = [
  { value: '100%', label: 'положительных отзывов' },
  { value: 'от 5 000 р', label: 'стоимость проектов' },
  { value: '1–3 дня', label: 'MVP под ключ' },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: 'Владислав Попович',
  jobTitle: 'Разработчик AI-агентов и Telegram-ботов',
  url: site.url,
  image: `${site.url}/images/vlad-portrait.png`,
  sameAs: [site.tgChannel, site.kwork],
  description: 'Разработчик и автоматизатор: Telegram-боты, AI-агенты, n8n, Python.',
};

---

<BaseLayout
  title="Владислав Попович — разработка AI-ботов и автоматизации"
  description="Владислав Попович — разработчик AI-агентов, Telegram-ботов и автоматизации. 100% положительных отзывов, от 5 000 р."
  schema={aboutSchema}
>
  <div class="mx-auto max-w-3xl px-4 pt-6 pb-16 sm:px-6 sm:pt-10 sm:pb-24 lg:px-8">

    <!-- Hero: большое фото с градиентом исчезания, текст выплывает из зоны фейда -->
    <div class="reveal -mx-4 sm:-mx-0">
      <div class="flex flex-col sm:flex-row sm:items-center">

        <!-- Фото: без рамки, фадится снизу (mobile) / вправо (desktop) -->
        <div class="relative shrink-0 sm:w-[300px] lg:w-[340px]">
          <Image
            src={vladPortrait}
            alt="Владислав Попович — разработчик и автоматизатор"
            width={400}
            height={560}
            format="webp"
            quality={85}
            class="block w-full h-[300px] sm:w-[300px] sm:h-[440px] lg:w-[340px] lg:h-[490px] object-cover object-[50%_6%] grayscale"
          />
          <!-- Mobile: фейд снизу -->
          <div
            class="sm:hidden absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to bottom, transparent 50%, var(--color-bg) 98%);"
            aria-hidden="true"
          />
          <!-- Desktop: фейд вправо -->
          <div
            class="hidden sm:block absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to right, transparent 35%, var(--color-bg) 90%);"
            aria-hidden="true"
          />
          <!-- Desktop: мягкий фейд снизу (убираем жёсткий нижний край) -->
          <div
            class="hidden sm:block absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to bottom, transparent 70%, var(--color-bg) 100%);"
            aria-hidden="true"
          />
        </div>

        <!-- Текст: выплывает из зоны фейда -->
        <div class="relative z-10 px-4 sm:px-0 sm:-ml-14 lg:-ml-18 pt-0 pb-6 sm:pb-0 sm:pt-4">
          <h1 class="font-display text-3xl font-black tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl">
            Владислав Попович
          </h1>
          <p class="mt-3 text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-sm">
            Разработчик и автоматизатор. Telegram-боты, AI-агенты, n8n-воронки, парсеры — под ключ.
          </p>
          <p class="mt-2 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
            Работаю с бизнесом по РФ. Ответ в течение дня.
          </p>
        </div>

      </div>
    </div>

    <!-- Цифры -->
    <div class="reveal mt-10 grid grid-cols-3 gap-4 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-center sm:p-8" style="animation-delay:.1s">
      {metrics.map((m) => (
        <div>
          <p class="text-xl sm:text-2xl font-black text-[var(--color-accent)]">{m.value}</p>
          <p class="mt-1 text-xs sm:text-sm text-[var(--color-text-muted)] leading-tight">{m.label}</p>
        </div>
      ))}
    </div>

    <!-- Манифест (короткая цитата) -->
    <blockquote class="reveal mt-10 border-l-4 border-[var(--color-accent)] pl-6 py-2" style="animation-delay:.14s">
      <p class="text-lg font-medium text-[var(--color-text)] sm:text-xl leading-relaxed italic">
        «Делаю так, чтобы рутину за вас делали боты и автоматизация — а вы занимались тем, что реально приносит деньги.»
      </p>
    </blockquote>

    <!-- Кому помогаю -->
    <section class="reveal mt-12" aria-labelledby="audience-heading" style="animation-delay:.18s">
      <h2 id="audience-heading" class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        Кому помогаю
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-glow-sm">
          <span class="inline-block text-xl text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          <h3 class="mt-2 font-display text-base font-semibold text-[var(--color-text)]">Бизнесу</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">Меньше ручных операций — предсказуемый процесс. Заявки, квалификация, отчёты — в автоматизацию.</p>
        </div>
        <div class="group rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-glow-sm">
          <span class="inline-block text-xl text-[var(--color-accent)] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          <h3 class="mt-2 font-display text-base font-semibold text-[var(--color-text)]">Основателям и командам</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">«Цифровой экзоскелет»: объём работы отдела в одиночку или малой командой. Боты и агенты как усиление.</p>
        </div>
      </div>
    </section>

    <!-- Канал -->
    <p class="reveal mt-8 text-[var(--color-text-muted)]" style="animation-delay:.22s">
      В канале <a href={site.tgChannelContent} data-ym-goal="telegram_channel_click" class="text-[var(--color-accent)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded" target="_blank" rel="noopener noreferrer">{site.tgChannelContentHandle}</a> — кейсы, баги и решения без рекламы.
    </p>

    <!-- Отзывы — ссылка на главную (без дублирования) -->
    <section class="reveal mt-14" aria-labelledby="reviews-heading" style="animation-delay:.26s">
      <h2 id="reviews-heading" class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        Отзывы клиентов
      </h2>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Все отзывы — с Kwork, реальные заказы, реальные оценки.
      </p>
      <div class="mt-4 flex items-center gap-3">
        <div class="flex gap-0.5" aria-label="Рейтинг 5.0 из 5">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-4 w-4 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-sm font-semibold text-[var(--color-text)]">5.0</span>
      </div>
      <a
        href="/#reviews-section-heading"
        class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] hover:underline transition-colors"
      >
        Читать отзывы
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </section>

    <!-- Стек -->
    <section class="reveal mt-14" aria-labelledby="stack-heading" style="animation-delay:.3s">
      <h2 id="stack-heading" class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        С чем работаю
      </h2>
      <ul class="mt-5 flex flex-wrap gap-3" role="list">
        {stack.map((tech) => (
          <li>
            <span class="group inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text)] transition-colors hover:border-[var(--color-accent)] hover:shadow-glow-sm">
              <span class="flex h-4 w-4 shrink-0 text-[var(--color-accent)] transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3 animate-float-icon" aria-hidden="true">
                {tech.icon === 'chat' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>)}
                {tech.icon === 'flow' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>)}
                {tech.icon === 'code' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>)}
                {tech.icon === 'circle' && (<svg class="h-4 w-4 svg-icon-reveal" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /></svg>)}
                {tech.icon === 'brain' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>)}
                {tech.icon === 'sparkle' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>)}
                {tech.icon === 'arrows' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>)}
                {tech.icon === 'database' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" /></svg>)}
                {tech.icon === 'table' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>)}
                {tech.icon === 'box' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>)}
                {tech.icon === 'search' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>)}
                {tech.icon === 'link' && (<svg class="h-4 w-4 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>)}
              </span>
              <span>{tech.name}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <div class="reveal mt-14 flex flex-wrap items-center gap-4" style="animation-delay:.36s">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
      <a href={site.tgChannel} data-ym-goal="telegram_click" class="group text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors" target="_blank" rel="noopener noreferrer">
        Написать в Telegram <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>


</BaseLayout>

