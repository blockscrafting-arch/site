---
/**
 * Страница «Обо мне»: одна колонка, цитата-манифест, pill-теги стека.
 * Без сторонних иллюстраций — текст и типографика как визуал.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import { site } from '../utils/site';

const stack = [
  { name: 'Telegram', icon: '💬' },
  { name: 'n8n', icon: '⚡' },
  { name: 'Python', icon: '🐍' },
  { name: 'Node.js', icon: '🟢' },
  { name: 'OpenAI', icon: '🧠' },
  { name: 'Gemini', icon: '✨' },
  { name: 'OpenRouter', icon: '🔀' },
  { name: 'Supabase', icon: '🗄️' },
  { name: 'PostgreSQL', icon: '🐘' },
  { name: 'Google Sheets', icon: '📊' },
  { name: 'Airtable', icon: '📋' },
  { name: 'Docker', icon: '🐳' },
  { name: 'RAG', icon: '🔍' },
  { name: 'webhook', icon: '🔗' },
];
---

<BaseLayout
  title="Обо мне — vlad.execute(_)"
  description="Влад — разработчик и автоматизатор. Telegram-боты, AI-агенты, n8n, Python."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <!-- Заголовок -->
    <h1 class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl">
      Обо мне
    </h1>

    <!-- Цитата-манифест -->
    <blockquote class="reveal mt-10 border-l-4 border-[var(--color-accent)] pl-6 py-2" style="animation-delay:.08s">
      <p class="text-xl font-medium text-[var(--color-text)] sm:text-2xl leading-relaxed italic">
        «Делаю так, чтобы рутину за вас делали боты и&nbsp;воркфлоу, а&nbsp;вы&nbsp;— только то, что реально приносит деньги.»
      </p>
    </blockquote>

    <!-- Основной текст -->
    <div class="reveal mt-12 space-y-6 text-[var(--color-text-muted)] text-lg leading-relaxed" style="animation-delay:.14s">
      <p>
        Я Влад — разработчик и автоматизатор. Не&nbsp;«просто настройщик n8n»: собираю системы под ключ — от идеи до запуска на вашем сервере. Telegram-боты, AI-агенты, парсинг, интеграции с CRM и таблицами.
      </p>
      <p>
        Без воды и лишних слоёв: сразу к&nbsp;делу и к результату в&nbsp;цифрах.
      </p>
    </div>

    <!-- Кому помогаю -->
    <div class="reveal mt-14 grid gap-4 sm:grid-cols-2" style="animation-delay:.2s">
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
        <span class="text-2xl" aria-hidden="true">→</span>
        <h2 class="mt-2 font-display text-lg font-semibold text-[var(--color-text)]">Бизнесу</h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Меньше ручных операций, меньше штат на рутине. Заявки, квалификация, отчёты — в автоматизацию. Предсказуемый процесс и экономия.</p>
      </div>
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
        <span class="text-2xl" aria-hidden="true">→</span>
        <h2 class="mt-2 font-display text-lg font-semibold text-[var(--color-text)]">Основателям и командам</h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">«Цифровой экзоскелет»: объём работы отдела — в одиночку или малой командой. Боты и агенты как усиление.</p>
      </div>
    </div>

    <!-- Канал -->
    <p class="reveal mt-10 text-[var(--color-text-muted)]" style="animation-delay:.24s">
      В канале <a href={site.tgChannelContent} class="text-[var(--color-accent)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded" target="_blank" rel="noopener noreferrer">{site.tgChannelContentHandle}</a> разбираю кейсы, баги и решения — без рекламы, с пользой для тех, кто сам внедряет автоматизацию.
    </p>

    <!-- Стек: pill-теги -->
    <section class="reveal mt-14" aria-labelledby="stack-heading" style="animation-delay:.3s">
      <h2 id="stack-heading" class="font-display text-lg font-semibold text-[var(--color-text)]">
        С чем работаю
      </h2>
      <ul class="mt-5 flex flex-wrap gap-3" role="list">
        {stack.map((tech) => (
          <li>
            <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm font-medium text-[var(--color-text)]">
              <span aria-hidden="true">{tech.icon}</span>
              {tech.name}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <div class="reveal mt-14 flex flex-wrap items-center gap-4" style="animation-delay:.36s">
      <Button href="/contact" variant="primary">Обсудить задачу</Button>
      <a href={site.tgChannel} class="text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors" target="_blank" rel="noopener noreferrer">
        Написать в Telegram →
      </a>
    </div>
  </div>
</BaseLayout>
