---
/**
 * Hero главной: H1 с CSS-ротацией услуг (zero JS),
 * подзаголовок, trust-bar под CTA.
 *
 * Секция: `min-h-[calc(100svh-4rem)]` — первый экран под фиксированный хедер (`h-16`),
 * чтобы на мобиле следующая секция не была видна без скролла.
 */
import Button from '../common/Button.astro';

const rotatorWords = ['заявки', 'поддержку', 'контент', 'рассылки'] as const;

const proofCases = [
  { metric: '120 ч → 2 ч', label: 'Постинг в 50+ групп Telegram', slug: 'telegram-roi-posting' },
  { metric: '40 мин → 2 мин', label: 'Пост в Telegram + VK + Дзен', slug: 'ai-content-conveyor' },
  { metric: '10 статей/день', label: 'AI-конвейер без копирайтера', slug: 'dzen-content-pipeline' },
  { metric: '100% перехват', label: 'Негатив с WB — в бота, не в отзывы', slug: 'wb-furniture-bot' },
] as const;

const proofCycleDuration = proofCases.length * 5;
---

<section class="relative flex flex-col overflow-hidden py-4 sm:py-6 lg:py-8 min-h-[calc(100svh-4rem)]">
  <div class="absolute inset-0 pointer-events-none hero-bg-dots" aria-hidden="true"></div>

  <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 sm:px-6 text-center">

    <h1
      class="reveal font-display text-[clamp(2rem,7vw,4.5rem)] font-black tracking-tighter leading-[1.1] max-w-4xl"
      aria-label="Заявки, поддержку, контент и рассылки — на автопилот"
    >
      <span class="hero-rotator text-[var(--color-accent)]">
        {rotatorWords.map((word, i) => (
          <span class="hero-rotator__word" style={`animation-delay:${i * 3.5}s`}>{word}</span>
        ))}
      </span>
      <br />
      <span class="min-w-0">— на&nbsp;автопилот</span>
    </h1>

    <p class="reveal mt-3 sm:mt-4 text-base sm:text-lg text-[var(--color-text-muted)] max-w-xl mx-auto leading-relaxed" style="animation-delay:.35s">
      AI-боты и&nbsp;автоматизация, которые окупаются с&nbsp;первого дня. Работающее решение — за&nbsp;дни, не&nbsp;недели.
    </p>

    <div class="reveal mt-4 sm:mt-6 flex flex-wrap items-center justify-center gap-3 sm:gap-4" style="animation-delay:.65s;">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost" dataYmGoal="cta_cases">Кейсы с цифрами</Button>
    </div>

    <!-- Proof-метрика: CSS-ротация между кейсами (zero JS) -->
    <div class="reveal mt-4 sm:mt-5 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-3" style="animation-delay:.85s">
      <div class="hero-proof-rotator">
        {proofCases.map((pc, i) => (
          <div
            class="hero-proof-rotator__item"
            style={`animation-delay:${i * 5}s; animation-duration:${proofCycleDuration}s`}
          >
            <div class="flex items-center gap-4">
              <div>
                <span class="block font-display text-2xl sm:text-3xl font-black text-[var(--color-accent)] leading-none">{pc.metric}</span>
                <span class="block mt-1 text-xs sm:text-sm text-[var(--color-text-muted)]">{pc.label}</span>
              </div>
              <a href={`/cases/${pc.slug}`} class="text-sm font-medium text-[var(--color-accent)] hover:underline whitespace-nowrap">Кейс →</a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="reveal mt-3 sm:mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-4" style="animation-delay:1s;">
      <a
        href="https://kwork.ru/user/goutach"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs sm:text-sm text-[var(--color-text-muted)] hover:text-[#F5A500] transition-colors"
        aria-label="Профиль на Kwork — рейтинг 5.0"
      >
        <span class="flex gap-0.5" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-3 w-3 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </span>
        5.0 на Kwork
      </a>
      <span class="h-3.5 w-px bg-[var(--color-border)] hidden sm:block" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/[0.08] px-2.5 py-0.5 text-xs sm:text-sm font-medium text-[var(--color-accent)]">
        <svg class="h-3 w-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 2"/>
        </svg>
        Ответ в тот же день
      </span>
    </div>
  </div>
</section>
