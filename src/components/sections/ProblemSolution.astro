---
/**
 * Секция «Знакомо?»: три строки боль → решение.
 * Сканируется за 3 секунды: зачёркнутая/приглушённая боль, жирное решение.
 * Никакого горизонтального скролла, никаких карточек.
 */
import Button from '../common/Button.astro';

const items = [
  {
    problem: 'Менеджеры тонут в заявках',
    solution: 'Бот сам квалифицирует заявки',
  },
  {
    problem: 'Рутина съедает 20+ часов в неделю',
    solution: 'Автоматизация делает это 24/7',
  },
  {
    problem: 'Клиенты ждут ответа часами',
    solution: 'Бот отвечает за 5 секунд',
  },
];
---

<section class="py-20 sm:py-28 px-4 sm:px-6" aria-labelledby="problem-solution-heading">
  <div class="mx-auto max-w-3xl">

    <h2
      id="problem-solution-heading"
      class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl"
    >
      Знакомо?
    </h2>
    <p class="reveal mt-4 text-base sm:text-lg text-[var(--color-text-muted)]" style="animation-delay:.06s">
      Проблемы, которые я закрываю автоматизацией.
    </p>

    <ul class="reveal-stagger mt-10 sm:mt-14" role="list">
      {items.map((item) => (
        <li class="problem-solution-row flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-8 py-6 sm:py-7 border-b border-[var(--color-border)] last:border-0">
          <!-- Боль -->
          <p class="flex items-center gap-3 sm:flex-1 text-base sm:text-xl text-[var(--color-text-muted)]">
            <span
              class="inline-flex flex-shrink-0 h-5 w-5 items-center justify-center rounded-full"
              style="background: rgba(239,68,68,0.14);"
              aria-hidden="true"
            >
              <svg class="h-2.5 w-2.5" viewBox="0 0 10 10" fill="none" stroke="#f87171" stroke-width="2.5" stroke-linecap="round">
                <line x1="2" y1="2" x2="8" y2="8"/>
                <line x1="8" y1="2" x2="2" y2="8"/>
              </svg>
            </span>
            {item.problem}
          </p>

          <!-- Стрелка — только на десктопе -->
          <span class="hidden sm:block text-[var(--color-accent)] font-bold text-2xl flex-shrink-0 select-none" aria-hidden="true">→</span>

          <!-- Решение -->
          <p class="flex items-center gap-3 sm:flex-1 font-semibold text-base sm:text-xl text-[var(--color-text)] pl-8 sm:pl-0">
            <span
              class="inline-flex sm:hidden flex-shrink-0 h-5 w-5 items-center justify-center rounded-full text-[var(--color-accent)] flex-shrink-0"
              aria-hidden="true"
            >
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 6h8M7 3l3 3-3 3"/>
              </svg>
            </span>
            {item.solution}
          </p>
        </li>
      ))}
    </ul>

    <div class="reveal mt-10 sm:mt-12" style="animation-delay:.2s">
      <Button href="/contact" variant="outline" dataYmGoal="cta_problems">Хочу решить эти задачи</Button>
    </div>
  </div>
</section>
