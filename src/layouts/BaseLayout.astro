---
/**
 * Базовый layout для всех страниц.
 * Подключает глобальные стили, Header, Footer, глоссарий, OG/Twitter meta.
 * Dark-first дизайн, нативный скролл (без Lenis — стабильный layout), View Transitions.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GlossaryActivator from '../components/features/GlossaryActivator';
import CustomCursor from '../components/features/CustomCursor.astro';
import ScrollProgress from '../components/features/ScrollProgress.astro';
import BackToTop from '../components/features/BackToTop.astro';
import glossaryData from '../content/glossary.json';
import { site } from '../utils/site';

/** Один или несколько JSON-LD объектов для страницы (Article, BreadcrumbList, FAQPage и т.д.). */
type SchemaObject = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  /** Путь к OG-картинке (от корня) или полный URL. По умолчанию site.ogImage */
  image?: string;
  /** Дополнительные JSON-LD схемы для вывода в head (кейсы, инструкции, FAQ). */
  schema?: SchemaObject | SchemaObject[];
  /** og:type — "website" по умолчанию, "article" для кейсов/гайдов. */
  ogType?: string;
  /** ISO-дата публикации для article:published_time (только при ogType="article"). */
  publishedTime?: string;
  /** Запрещает индексацию страницы (404 и т.п.). */
  noindex?: boolean;
}

const { title, description = site.description, image, schema: pageSchema, ogType = 'website', publishedTime, noindex } = Astro.props;
const desc = description ?? site.description;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${site.url}${path}`;
const ogImageUrl = image?.startsWith('http') ? image : `${site.url}${image ?? site.ogImage}`;

/** Темы для AEO/GEO: помогают ИИ и поиску сопоставлять запросы с услугами. */
const knowsAboutTopics = [
  'Telegram-боты',
  'Mini Apps для Telegram, MAX и VK',
  'автоматизация бизнес-процессов',
  'n8n',
  'AI-агенты',
  'интеграции API',
  'Python-скрипты',
  'парсинг данных',
  'автопостинг',
] as const;

/** JSON-LD для главной: WebSite + Person + ProfessionalService + ContactPoint (AEO/GEO 2026). */
const schemaOrg = path === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      publisher: { '@id': `${site.url}/#person` },
      inLanguage: 'ru',
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: 'Влад Попович',
      givenName: 'Влад',
      familyName: 'Попович',
      jobTitle: 'Разработчик и автоматизатор',
      url: site.url,
      image: `${site.url}/images/vlad-portrait.png`,
      description: site.description,
      knowsAbout: [...knowsAboutTopics],
      sameAs: [site.tgChannel, site.tgChannelContent, site.kwork, site.max],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#business`,
      name: site.name,
      url: site.url,
      description: desc,
      areaServed: 'RU',
      founder: { '@id': `${site.url}/#person` },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: site.email,
        url: site.tgChannel,
        availableLanguage: 'Russian',
      },
    },
  ],
} : null;

/** Объединяем главную схему и страничные (Article, BreadcrumbList и т.д.). */
const schemaList: SchemaObject[] = [];
if (schemaOrg) schemaList.push(schemaOrg);
if (pageSchema) schemaList.push(...(Array.isArray(pageSchema) ? pageSchema : [pageSchema]));

/** Экранирует </script> в JSON для безопасной вставки в тег script (защита от XSS). */
const safeGlossaryJson = JSON.stringify(glossaryData).replace(/<\/script/gi, '\\u003c/script');
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content="ru_RU" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />
    {site.yandexVerification && (
      <meta name="yandex-verification" content={site.yandexVerification} />
    )}
    {site.googleVerification && (
      <meta name="google-site-verification" content={site.googleVerification} />
    )}
    {schemaList.length > 0 && schemaList.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {site.yandexMetrikaId != null && (
      <script is:inline define:vars={{ counterId: site.yandexMetrikaId }}>
        window.__YM_COUNTER_ID__ = counterId;
        window.dataLayer = window.dataLayer || [];
        (function (m, e, t, r, i, k, a) {
          m[i] =
            m[i] ||
            function () {
              (m[i].a = m[i].a || []).push(arguments);
            };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === r) {
              return;
            }
          }
          k = e.createElement(t);
          a = e.getElementsByTagName(t)[0];
          k.async = 1;
          k.src = r;
          a.parentNode.insertBefore(k, a);
        })(
          window,
          document,
          "script",
          "https://mc.yandex.ru/metrika/tag.js?id=" + counterId,
          "ym",
        );
        ym(counterId, "init", {
          ssr: true,
          webvisor: true,
          clickmap: true,
          ecommerce: "dataLayer",
          referrer: document.referrer,
          url: location.href,
          accurateTrackBounce: true,
          trackLinks: true,
        });
      </script>
    )}
    {site.yandexMetrikaId != null && (
      <noscript>
        <div>
          <img
            src={`https://mc.yandex.ru/watch/${site.yandexMetrikaId}`}
            alt=""
            style="position:absolute;left:-9999px"
            width="1"
            height="1"
          />
        </div>
      </noscript>
    )}
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">
    <a href="#main-content" class="skip-link">
      Перейти к содержимому
    </a>
    <CustomCursor />
    <ScrollProgress />
    <BackToTop />
    <script type="application/json" id="glossary-data" set:html={safeGlossaryJson}></script>
    <GlossaryActivator client:idle />
    <Header />
    <main id="main-content" class="flex-1 pt-16" data-glossary>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      /** Lightweight scroll-reveal: добавляет .is-visible по IntersectionObserver */
      function _initReveal() {
        var els = document.querySelectorAll('.reveal, .reveal-stagger');
        if (!els.length) return;
        var io = new IntersectionObserver(function(entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-visible');
              io.unobserve(entries[i].target);
            }
          }
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      }
      requestAnimationFrame(function(){ requestAnimationFrame(_initReveal); });
      document.addEventListener('astro:after-swap', function() {
        requestAnimationFrame(function(){ requestAnimationFrame(_initReveal); });
      });
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
      });
    </script>
    {site.yandexMetrikaId != null && (
      <script is:inline>
        (function () {
          var scrollMarks = { 25: false, 50: false, 75: false, 100: false };
          function ymReach(target) {
            var id = window.__YM_COUNTER_ID__;
            if (typeof window.ym !== 'function' || typeof id !== 'number') return;
            try {
              window.ym(id, 'reachGoal', target);
            } catch (e) {
              console.warn('[metrika]', e);
            }
          }
          function onDocClick(e) {
            var el = e.target && e.target.closest && e.target.closest('[data-ym-goal]');
            if (!el) return;
            var g = el.getAttribute('data-ym-goal');
            if (g) ymReach(g);
          }
          var scrollTimer = null;
          function onScroll() {
            if (scrollTimer) return;
            scrollTimer = requestAnimationFrame(function () {
              scrollTimer = null;
              var doc = document.documentElement;
              var h = doc.scrollHeight - doc.clientHeight;
              if (h <= 0) return;
              var p = ((doc.scrollTop || 0) / h) * 100;
              [25, 50, 75, 100].forEach(function (th) {
                if (!scrollMarks[th] && p >= th - 0.5) {
                  scrollMarks[th] = true;
                  ymReach('scroll_depth_' + th);
                }
              });
              var path = location.pathname;
              if (/^\/guides\/.+/.test(path) && p >= 90) {
                try {
                  var key = 'ym_guide_read_' + path;
                  if (!sessionStorage.getItem(key)) {
                    sessionStorage.setItem(key, '1');
                    ymReach('guide_read');
                  }
                } catch (err) {
                  console.warn('[metrika] guide_read', err);
                }
              }
            });
          }
          function bind() {
            document.addEventListener('click', onDocClick, true);
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
          }
          function resetScrollMarks() {
            scrollMarks = { 25: false, 50: false, 75: false, 100: false };
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bind);
          } else {
            bind();
          }
          document.addEventListener('astro:after-swap', function () {
            resetScrollMarks();
            requestAnimationFrame(onScroll);
          });
        })();
      </script>
    )}
  </body>
</html>
