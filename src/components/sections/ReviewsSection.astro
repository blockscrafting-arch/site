---
/**
 * Секция отзывов с каруселью — главная страница.
 * Данные синхронизированы с about.astro.
 */
const reviews = [
  {
    author: 'elena_bukina',
    project: 'Бот на Python с OCR',
    rating: 5,
    text: 'Редкое сочетание профессионализма и скорости выполнения. Рекомендую!',
  },
  {
    author: 'Nsltd',
    project: 'Система парсинга',
    rating: 5,
    text: 'Идеальная работа! Тот случай, один на сотню, когда человек делом подтверждает все свои слова.',
  },
  {
    author: 'postlunapark',
    project: 'Автопостинг N8N: Telegram + VK + Дзен',
    rating: 5,
    text: 'Теперь все время могу потратить на более важные задачи, чем руками всё постить.',
  },
  {
    author: 'wildtorneo',
    project: 'Автоматизация email-рассылки',
    rating: 5,
    text: 'Всё было сделано профессионально, быстро и именно так как нужно! Рекомендую!',
  },
  {
    author: 'evgenijjstrannik',
    project: 'Парсер закрытых Telegram-чатов',
    rating: 5,
    text: 'Всё выполнено на высшем уровне, всем рекомендую.',
  },
];
---

<section class="reveal py-16 sm:py-20" aria-labelledby="reviews-section-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

    <div class="flex items-start justify-between gap-4 mb-8">
      <div>
        <h2 id="reviews-section-heading" class="font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl">
          Что говорят клиенты
        </h2>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">Реальные отзывы с Kwork — 100% положительных.</p>
      </div>
      <div class="flex items-center gap-2 shrink-0 mt-1">
        <button
          id="rev-main-prev"
          type="button"
          aria-label="Предыдущий отзыв"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] disabled:opacity-30 disabled:cursor-not-allowed"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <span id="rev-main-counter" class="min-w-[2.5rem] text-center text-xs text-[var(--color-text-muted)] tabular-nums">1 / {reviews.length}</span>
        <button
          id="rev-main-next"
          type="button"
          aria-label="Следующий отзыв"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] disabled:opacity-30 disabled:cursor-not-allowed"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl" aria-live="polite" aria-atomic="true">
      <div id="rev-main-track" class="flex" style="transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);">
        {reviews.map((r) => (
          <article class="rev-main-slide min-w-full" aria-label={`Отзыв от ${r.author}`}>
            <blockquote class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8">
              <span class="absolute top-5 right-6 font-display text-6xl leading-none text-[var(--color-accent)] opacity-10 select-none pointer-events-none" aria-hidden="true">"</span>
              <div class="flex gap-1 mb-4" aria-label={`Оценка: ${r.rating} из 5`}>
                {Array.from({ length: r.rating }).map(() => (
                  <svg class="h-4 w-4 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-base text-[var(--color-text)] leading-relaxed sm:text-lg">«{r.text}»</p>
              <footer class="mt-5 flex items-center gap-3 border-t border-[var(--color-border)] pt-4">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-sm font-bold text-[var(--color-accent)]">
                  {r.author.charAt(0).toUpperCase()}
                </div>
                <cite class="not-italic">
                  <span class="block text-sm font-semibold text-[var(--color-text)]">{r.author}</span>
                  <span class="text-xs text-[var(--color-text-muted)]">{r.project}</span>
                </cite>
              </footer>
            </blockquote>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-4 flex justify-center gap-2" role="tablist" aria-label="Переключение отзывов">
      {reviews.map((_, i) => (
        <button
          type="button"
          role="tab"
          class="rev-main-dot h-2 rounded-full bg-[var(--color-border)] transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
          style={i === 0 ? 'width:1.5rem;background:var(--color-accent)' : 'width:0.5rem'}
          data-index={i}
          aria-label={`Отзыв ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        />
      ))}
    </div>

  </div>
</section>

<script>
  (function () {
    const track = document.getElementById('rev-main-track');
    const dots = document.querySelectorAll<HTMLButtonElement>('.rev-main-dot');
    const prevBtn = document.getElementById('rev-main-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('rev-main-next') as HTMLButtonElement | null;
    const counter = document.getElementById('rev-main-counter');
    const total = dots.length;
    let current = 0;

    function goTo(n: number) {
      current = Math.max(0, Math.min(n, total - 1));
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        const active = i === current;
        d.style.width = active ? '1.5rem' : '0.5rem';
        d.style.background = active ? 'var(--color-accent)' : 'var(--color-border)';
        d.setAttribute('aria-selected', String(active));
      });
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    let touchStartX = 0;
    track?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    track?.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
    }, { passive: true });

    goTo(0);
  })();
</script>
