---
/**
 * Визуальный разделитель между секциями: градиентная линия.
 */
interface Props {
  /** Вариант: line (тонкая линия), wave (волна — опционально). */
  variant?: 'line' | 'fade';
}
const { variant = 'line' } = Astro.props;
---

{variant === 'line' && (
  <div class="section-divider h-px w-full max-w-2xl mx-auto my-0 bg-gradient-to-r from-transparent via-[var(--color-accent)]/40 to-transparent" aria-hidden="true"></div>
)}
{variant === 'fade' && (
  <div class="section-divider-fade h-16 w-full bg-gradient-to-b from-transparent to-[var(--color-bg)]" aria-hidden="true"></div>
)}
