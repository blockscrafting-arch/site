---
/**
 * Контакты: Telegram, блог, Kwork, e-mail и форма обратной связи.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/common/Button.astro';
import ContactForm from '../components/features/ContactForm';
import CopyButton from '../components/features/CopyButton';
import { site } from '../utils/site';

const webhookUrl = typeof import.meta.env.PUBLIC_CONTACT_WEBHOOK === 'string'
  ? import.meta.env.PUBLIC_CONTACT_WEBHOOK
  : '';
---

<BaseLayout
  title="Контакты — vlad.execute(_)"
  description={`Связаться с Владом: Telegram ${site.tgChannelHandle}, e-mail, блог ${site.tgChannelContentHandle}, Kwork. Форма обратной связи.`}
>
  <!-- Анимированный самолетик (FontAwesome paper-plane), физика полёта через wobble -->
  <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden" aria-hidden="true">
    <div class="absolute animate-airplane w-[120px] h-[120px] sm:w-[160px] sm:h-[160px] text-[var(--color-accent)] opacity-[0.05]">
      <svg viewBox="0 0 512 512" fill="currentColor" stroke="none" class="w-full h-full animate-airplane-wobble" aria-hidden="true">
        <path d="M476 3.2L12.5 270.6c-18.1 10.4-15.8 35.6 2.2 43.2L121 358.4l287.3-253.2c5.5-4.9 13.3 2.6 8.6 8.3L176 407v80.5c0 23.6 28.5 32.9 42.5 15.8L282 426l124.6 52.2c14.2 6 30.4-2.9 33-18.2l72-432C515 7.8 493.3-6.8 476 3.2z" />
      </svg>
    </div>
  </div>
  <div class="contact-page reveal-stagger is-visible mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <h1 class="contact-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl">
      Контакты
    </h1>
    <p class="contact-intro mt-2 text-[var(--color-text-muted)]">
      Напишите в Telegram, на e-mail, закажите на Kwork или через форму — отвечу в течение дня.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:gap-6" aria-label="Связь и ресурсы">
      <!-- Основной контакт (занимает 2 колонки на sm) -->
      <section class="sm:col-span-2 rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 shadow-sm transition-all hover:border-[var(--color-accent)]/50 hover:shadow-glow-sm relative overflow-hidden group" aria-labelledby="telegram-heading">
        <!-- Декоративный фон-градиент -->
        <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-[var(--color-accent)] opacity-5 blur-3xl pointer-events-none transition-opacity group-hover:opacity-10"></div>
        
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div>
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2AABEE]/10 text-[#2AABEE] mb-4 transition-transform group-hover:scale-110">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.05-.19-.02-.27 0-.12.03-1.98 1.25-5.58 3.68-.53.36-1.01.54-1.44.53-.48-.01-1.39-.27-2.07-.49-.83-.27-1.49-.41-1.43-.87.03-.24.36-.49 1-.76 3.92-1.7 6.53-2.82 7.82-3.35 3.73-1.54 4.51-1.81 5.01-1.82.11 0 .36.03.49.14.11.09.14.22.15.34.02.1-.01.24-.02.31z"/>
              </svg>
            </div>
            <h2 id="telegram-heading" class="font-display text-xl font-bold text-[var(--color-text)]">
              Написать лично
            </h2>
            <p class="mt-2 max-w-md text-[var(--color-text-muted)] text-sm sm:text-base">
              Основной канал связи для заказов, обсуждения проектов и рабочих вопросов.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
            <Button href={site.tgChannel} variant="primary" external dataYmGoal="telegram_click" class="shadow-glow-sm flex-shrink-0 w-full sm:w-auto justify-center">
              Перейти в Telegram
            </Button>
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-[var(--color-text)] bg-[var(--color-background)] border border-[var(--color-border)] px-3 py-[9px] rounded-lg select-all">{site.tgChannelHandle}</span>
              <CopyButton client:load value={site.tgChannelHandle} iconOnly copiedLabel="Скопировано!" />
            </div>
          </div>
        </div>
      </section>

      <!-- Блог -->
      <a href={site.tgChannelContent} target="_blank" rel="noopener noreferrer" data-ym-goal="telegram_channel_click" class="group relative overflow-hidden flex flex-col justify-between rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 transition-all hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-glow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-background)]">
        <div class="absolute -right-10 -top-10 w-32 h-32 rounded-full bg-[var(--color-accent)] opacity-5 blur-2xl pointer-events-none transition-opacity group-hover:opacity-10"></div>
        <div class="relative z-10">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] mb-4 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-[var(--color-text)] transition-colors group-hover:text-[var(--color-accent)]">
            Мой блог
          </h3>
          <p class="mt-2 text-[var(--color-text-muted)] text-sm leading-relaxed">
            Пишу про автоматизацию, AI-агентов, n8n и делюсь результатами своих кейсов.
          </p>
        </div>
        <div class="relative z-10 mt-6 flex items-center text-[var(--color-accent)] font-medium text-sm">
          {site.tgChannelContentHandle} <span class="ml-1 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </div>
      </a>

      <!-- Kwork -->
      <a href={site.kwork} target="_blank" rel="noopener noreferrer" data-ym-goal="outbound_kwork" class="group relative overflow-hidden flex flex-col justify-between rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 transition-all hover:-translate-y-1 hover:border-[#F5A500] hover:shadow-[0_0_15px_rgba(245,165,0,0.2)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F5A500] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-background)]">
        <div class="absolute -right-10 -top-10 w-32 h-32 rounded-full bg-[#F5A500] opacity-5 blur-2xl pointer-events-none transition-opacity group-hover:opacity-15"></div>
        <div class="relative z-10">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#1c1c1e] border border-[#F5A500]/25 mb-4 transition-transform group-hover:scale-110" aria-hidden="true">
            <span class="font-black text-xl text-[#F5A500]" style="font-family:sans-serif;line-height:1;">K</span>
          </div>
          <h3 class="font-display text-lg font-bold text-[var(--color-text)] transition-colors group-hover:text-[#F5A500]">
            Я на Kwork
          </h3>
          <p class="mt-2 text-[var(--color-text-muted)] text-sm leading-relaxed">
            Заказывайте услуги через безопасную сделку на популярной фриланс-бирже.
          </p>
        </div>
        <div class="relative z-10 mt-6 flex items-center text-[#F5A500] font-medium text-sm">
          {site.kworkHandle} <span class="ml-1 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </div>
      </a>

      <!-- MAX -->
      <a href={site.max} target="_blank" rel="noopener noreferrer" data-ym-goal="outbound_max" class="group relative overflow-hidden flex flex-col justify-between rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 transition-all hover:-translate-y-1 hover:border-[#4F46E5] hover:shadow-[0_0_15px_rgba(79,70,229,0.15)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4F46E5] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-background)]">
        <div class="absolute -right-10 -top-10 w-32 h-32 rounded-full bg-[#4F46E5] opacity-5 blur-2xl pointer-events-none transition-opacity group-hover:opacity-10"></div>
        <div class="relative z-10">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#4F46E5]/10 mb-4 transition-transform group-hover:scale-110">
            <img src="/max-logo.png" alt="МАХ" class="w-6 h-6 object-contain" />
          </div>
          <h3 class="font-display text-lg font-bold text-[var(--color-text)] transition-colors group-hover:text-[#4F46E5]">
            Я в МАХ
          </h3>
          <p class="mt-2 text-[var(--color-text-muted)] text-sm leading-relaxed">
            Мой профиль на платформе МАХ — свяжитесь со мной или посмотрите портфолио.
          </p>
        </div>
        <div class="relative z-10 mt-6 flex items-center text-[#4F46E5] font-medium text-sm">
          {site.maxHandle} <span class="ml-1 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </div>
      </a>

      <!-- E-mail -->
      <div class="group relative overflow-hidden flex flex-col justify-between rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8 transition-all hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-glow-sm">
        <div class="absolute -right-10 -top-10 w-32 h-32 rounded-full bg-[var(--color-accent)] opacity-5 blur-2xl pointer-events-none transition-opacity group-hover:opacity-10"></div>
        <div class="relative z-10">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] mb-4 transition-transform group-hover:scale-110">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-[var(--color-text)]">
            E-mail
          </h3>
          <p class="mt-2 text-[var(--color-text-muted)] text-sm leading-relaxed">
            Для писем и официальных запросов.
          </p>
        </div>
        <div class="relative z-10 mt-6 flex flex-wrap items-center gap-2">
          <a href={`mailto:${site.email}`} data-ym-goal="mailto_click" class="text-[var(--color-accent)] font-medium text-sm hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-background)] rounded">
            {site.email}
          </a>
          <CopyButton client:load value={site.email} iconOnly copiedLabel="Скопировано!" />
        </div>
      </div>
    </div>

    <section class="contact-form-section mt-10" aria-labelledby="form-heading">
      <h2 id="form-heading" class="font-display text-lg font-semibold text-[var(--color-text)]">
        Форма обратной связи
      </h2>
      <ContactForm client:load webhookUrl={webhookUrl} />
    </section>
  </div>
</BaseLayout>

