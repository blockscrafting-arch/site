---
/**
 * Sticky CTA для мобильных: появляется после скролла из Hero,
 * исчезает когда видна финальная CTA-секция. Thumb zone.
 * sm:hidden — на десктопе не показывается.
 */
import Button from '../common/Button.astro';
import { site } from '../../utils/site';
---

<!-- Мобильная версия: полноширинная кнопка внизу -->
<div
  id="sticky-cta-mobile"
  class="fixed bottom-0 left-0 right-0 z-40 sm:hidden translate-y-full transition-transform duration-300 ease-in-out"
  aria-hidden="true"
>
  <div class="mx-4 mb-4">
    <Button href={site.tgChannel} variant="primary" external dataYmGoal="sticky_cta_telegram" class="w-full gap-2 rounded-xl py-3.5 shadow-lg shadow-[var(--color-accent)]/20">
      <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248-1.97 9.289c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c-.242-.213-.054-.333-.373-.12L7.16 14.25l-2.97-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.666.336z"/>
      </svg>
      Написать в Telegram
    </Button>
  </div>
</div>

<!-- Десктопная версия: компактная кнопка справа внизу -->
<div
  id="sticky-cta-desktop"
  class="fixed bottom-6 right-6 z-40 hidden sm:block translate-y-[calc(100%+2rem)] transition-transform duration-300 ease-in-out"
  aria-hidden="true"
>
  <a
    href={site.tgChannel}
    target="_blank"
    rel="noopener noreferrer"
    data-ym-goal="sticky_cta_telegram"
    class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-white shadow-lg shadow-[var(--color-accent)]/25 transition-all duration-200 hover:scale-105 hover:shadow-xl hover:shadow-[var(--color-accent)]/30"
  >
    <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248-1.97 9.289c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c-.242-.213-.054-.333-.373-.12L7.16 14.25l-2.97-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.666.336z"/>
    </svg>
    Написать в Telegram
  </a>
</div>

<script>
  /**
   * Показываем sticky CTA после скролла на 60% высоты viewport (прошли hero).
   * Скрываем когда финальный CTA (#cta-heading) входит в зону видимости.
   */
  function initStickyCta() {
    const ctaMobile = document.getElementById('sticky-cta-mobile');
    const ctaDesktop = document.getElementById('sticky-cta-desktop');
    if (!ctaMobile && !ctaDesktop) return;

    const finalCtaSection = document.getElementById('cta-heading')?.closest('section') as HTMLElement | null;
    let finalCtaVisible = false;
    const scrollThreshold = window.innerHeight * 0.6;

    const update = () => {
      const shouldShow = window.scrollY > scrollThreshold && !finalCtaVisible;
      if (ctaMobile) {
        ctaMobile.classList.toggle('translate-y-full', !shouldShow);
        ctaMobile.toggleAttribute('aria-hidden', !shouldShow);
      }
      if (ctaDesktop) {
        ctaDesktop.classList.toggle('translate-y-[calc(100%+2rem)]', !shouldShow);
        ctaDesktop.toggleAttribute('aria-hidden', !shouldShow);
      }
    };

    if (finalCtaSection) {
      const io = new IntersectionObserver((entries) => {
        finalCtaVisible = entries[0]?.isIntersecting ?? false;
        update();
      }, { threshold: 0.3 });
      io.observe(finalCtaSection);
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initStickyCta();
  document.addEventListener('astro:after-swap', initStickyCta);
</script>
