---
/**
 * Подвал сайта: копирайт, ссылки на разделы, контакт (Telegram), исполнитель.
 */
import { site } from '../../utils/site';
const year = new Date().getFullYear();
const payerShort = site.legal.payerName.split(' ').map((p, i) => (i === 0 ? p : p[0] + '.')).join(' ');
---

<footer class="footer-animate border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-sm text-[var(--color-text-muted)]">
        © {year} vlad.execute(_). Разработка и автоматизация.
      </p>
      <nav class="flex flex-wrap justify-center gap-4 sm:gap-6 text-sm" aria-label="Подвал">
        <a href="/services" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Услуги</a>
        <a href="/cases" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Кейсы</a>
        <a href="/guides" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Инструкции</a>
        <a href="/about" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Обо мне</a>
        <a href="/contact" data-ym-goal="nav_contact" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Контакты</a>
        <a href="/legal/privacy" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Политика конфиденциальности</a>
        <a href="/legal/requisites" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">Реквизиты</a>
      </nav>
    </div>
    <p class="mt-4 text-center text-sm text-[var(--color-text-muted)]">
      Telegram: <a href={site.tgChannel} data-ym-goal="telegram_click" class="text-[var(--color-accent)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded" target="_blank" rel="noopener noreferrer">{site.tgChannelHandle}</a>
    </p>
    <p class="mt-2 text-center text-xs text-[var(--color-text-muted)]">
      Исполнитель: <a href="/legal/requisites" class="text-[var(--color-accent)] hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded">плательщик НПД {payerShort}</a>
    </p>
  </div>
</footer>
