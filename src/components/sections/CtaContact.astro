---
/**
 * CTA: обсудить задачу (переход на контакты).
 */
import Button from '../common/Button.astro';
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24" aria-labelledby="cta-contact-heading">
  <div
    class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-muted)]/50 px-6 py-10 text-center sm:px-10 sm:py-14"
  >
    <h2
      id="cta-contact-heading"
      class="font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl"
    >
      Обсудить задачу
    </h2>
    <p class="mt-3 max-w-xl mx-auto text-[var(--color-text-muted)]">
      Опишите задачу — предложу решение и ориентир по срокам.
    </p>
    <div class="mt-8">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
    </div>
  </div>
</section>
