---
/**
 * Секция «Как я работаю»: таймлайн из 5 шагов. CSS reveal, без GSAP.
 */
const steps = [
  { title: 'Брифинг', desc: 'Уточняем задачу, каналы, желаемый результат.', icon: 'brief' },
  { title: 'Прототип', desc: 'Схема или MVP за 1–2 дня, чтобы проверить гипотезу.', icon: 'proto' },
  { title: 'Разработка', desc: 'Собираю бота/воркфлоу, тестируем на реальных сценариях.', icon: 'code' },
  { title: 'Запуск', desc: 'Деплой, инструкции, передача доступа.', icon: 'launch' },
  { title: 'Поддержка', desc: 'Правки и доработки по договорённости.', icon: 'support' },
];
---

<section class="py-24 sm:py-32 px-4 sm:px-6" aria-labelledby="process-heading">
  <div class="mx-auto max-w-3xl relative">
    <div class="absolute right-0 sm:-right-10 top-0 sm:-top-10 w-60 h-60 sm:w-84 sm:h-84 opacity-[0.15] text-[var(--color-accent)] pointer-events-none -z-10 animate-float-icon" aria-hidden="true">
      <svg class="w-full h-full animate-gears-slow" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <!-- Шестеренка: центральное кольцо и зубья -->
        <circle cx="100" cy="100" r="32" fill="var(--color-bg)" />
        <circle cx="100" cy="100" r="38" fill="none" />
        <!-- 8 зубьев -->
        <line x1="100" y1="58" x2="100" y2="42" />
        <line x1="142" y1="100" x2="158" y2="100" />
        <line x1="100" y1="142" x2="100" y2="158" />
        <line x1="58" y1="100" x2="42" y2="100" />
        <line x1="128" y1="68" x2="138" y2="58" />
        <line x1="128" y1="132" x2="138" y2="142" />
        <line x1="72" y1="132" x2="62" y2="142" />
        <line x1="72" y1="68" x2="62" y2="58" />
      </svg>
    </div>

    <div class="relative flex justify-center mb-4">
      <h2 id="process-heading" class="reveal font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl md:text-4xl text-center relative z-10">
        Как мы работаем
      </h2>
    </div>
    <p class="reveal mt-4 text-center text-[var(--color-text-muted)]" style="animation-delay:.06s">
      От брифа до запуска — прозрачно и по шагам.
    </p>

    <ol class="reveal-stagger relative mt-16 space-y-8 pl-0" role="list">
      <span class="absolute left-5 top-10 bottom-10 w-0.5 bg-gradient-to-b from-[var(--color-accent)]/40 via-[var(--color-accent)]/20 to-transparent" aria-hidden="true"></span>
      {steps.map((step) => (
        <li class="relative flex gap-6">
          <span class="relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-[var(--color-accent-muted)] text-[var(--color-accent)] ring-4 ring-[var(--color-bg)] animate-float-icon" aria-hidden="true">
            {step.icon === 'brief' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>)}
            {step.icon === 'proto' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>)}
            {step.icon === 'code' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>)}
            {step.icon === 'launch' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>)}
            {step.icon === 'support' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>)}
          </span>
          <div>
            <h3 class="font-display font-semibold text-[var(--color-text)]">{step.title}</h3>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
