---
/**
 * Hero главной: H1 с CSS-ротацией услуг (zero JS),
 * подзаголовок, trust-bar под CTA.
 */
import Button from '../common/Button.astro';

const rotatorWords = ['заявки', 'поддержку', 'контент', 'рассылки'] as const;
---

<section class="relative flex flex-col overflow-hidden py-8 sm:py-12 lg:py-14">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[700px] rounded-full bg-[var(--color-accent)]/6 blur-[140px]"></div>
    <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] rounded-full bg-[var(--color-accent-cyan)]/4 blur-[120px]"></div>
  </div>

  <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-4 py-2 sm:py-4 sm:px-6 text-center">

    <h1
      class="reveal font-display text-[clamp(2rem,7vw,4.5rem)] font-black tracking-tighter leading-[1.1] max-w-4xl"
      aria-label="Автоматизируйте заявки, поддержку, контент и рассылки — результат за 1–3 дня"
    >
      <span class="min-w-0">Автоматизируйте</span>
      <br />
      <span class="hero-rotator text-[var(--color-accent)]">
        {rotatorWords.map((word, i) => (
          <span class="hero-rotator__word" style={`animation-delay:${i * 3.5}s`}>{word}</span>
        ))}
      </span>
      <br />
      <span class="min-w-0">— результат за&nbsp;1–3&nbsp;дня</span>
    </h1>

    <p class="reveal mt-5 sm:mt-6 text-base sm:text-lg text-[var(--color-text-muted)] max-w-xl mx-auto leading-relaxed" style="animation-delay:.05s">
      Задачи, которые отнимали часы, работают сами. Боты, AI&#8209;агенты, n8n&#8209;воронки — от&nbsp;брифа до&nbsp;запуска.
    </p>

    <div class="reveal mt-6 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4" style="animation-delay:.08s;">
      <Button href="/contact" variant="primary" dataYmGoal="cta_contact">Обсудить задачу</Button>
      <Button href="/cases" variant="ghost" dataYmGoal="cta_cases">Смотреть кейсы</Button>
    </div>

    <div class="reveal mt-5 sm:mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-4" style="animation-delay:.24s;">
      <span class="text-xs sm:text-sm text-[var(--color-text-muted)]">от 5 000 ₽</span>
      <span class="h-3.5 w-px bg-[var(--color-border)] hidden sm:block" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-1 text-xs sm:text-sm text-[var(--color-text-muted)]">
        <span class="flex gap-0.5" aria-label="Рейтинг 5.0 из 5">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-3 w-3 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </span>
        5.0 на Kwork
      </span>
      <span class="h-3.5 w-px bg-[var(--color-border)] hidden sm:block" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/[0.08] px-2.5 py-0.5 text-xs sm:text-sm font-medium text-[var(--color-accent)]">
        <svg class="h-3 w-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l3 2"/>
        </svg>
        Ответ в тот же день
      </span>
    </div>
  </div>
</section>
