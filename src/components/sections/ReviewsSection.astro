---
/**
 * Секция отзывов: статичный grid (не карусель).
 * Ресерч: grid конвертирует лучше carousel (NN/g).
 * Aggregate rating в заголовке, Kwork как verified source badge.
 */
import { reviews as allReviews } from '@/data/reviews';

const reviews = allReviews.slice(0, 5);
const avgRating = '5.0';
const totalReviews = allReviews.length;
---

<section class="reveal py-20 sm:py-28 px-4 sm:px-6 bg-[var(--color-surface)]" aria-labelledby="reviews-section-heading">
  <div class="mx-auto max-w-5xl">

    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 mb-4">
        <div class="flex gap-0.5" aria-label={`Средняя оценка: ${avgRating} из 5`}>
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-lg font-bold text-[var(--color-text)]">{avgRating}</span>
      </div>
      <h2 id="reviews-section-heading" class="font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl">
        Все заказы — 5.0
      </h2>
    </div>

    <div class="reveal-stagger grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((r, i) => {
        const isFeatured = r.author === 'Nsltd';
        return (
        <blockquote
          class:list={[
            'relative rounded-2xl border p-6 flex flex-col min-h-[200px]',
            isFeatured
              ? 'sm:col-span-2 border-[var(--color-accent)]/30 bg-[var(--color-bg)]'
              : 'border-[var(--color-border)] bg-[var(--color-bg)]',
          ]}
        >
          {r.label && (
            <span class="mb-2 inline-block rounded-full border border-[var(--color-border)] px-2.5 py-0.5 text-[10px] font-medium text-[var(--color-text-muted)]">
              {r.label}
            </span>
          )}
          <div class="flex gap-0.5 mb-3" aria-label={`Оценка: ${r.rating} из 5`}>
            {Array.from({ length: r.rating }).map(() => (
              <svg class="h-3.5 w-3.5 text-[#F5A500]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class:list={['leading-relaxed flex-1', isFeatured ? 'text-lg text-[var(--color-text)]' : 'text-base text-[var(--color-text)]']}>«{r.text}»</p>
          <footer class="mt-4 flex items-center gap-3 border-t border-[var(--color-border)] pt-4">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)]/15 text-sm font-bold text-[var(--color-accent)]">
              {r.author.charAt(0)}
            </div>
            <cite class="not-italic min-w-0">
              <span class="block text-sm font-semibold text-[var(--color-text)]">{r.author}</span>
              <span class="block text-xs text-[var(--color-text-muted)] truncate">{r.project}</span>
            </cite>
          </footer>
        </blockquote>
        );
      })}
    </div>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-6">
      <a
        href="/reviews"
        data-ym-goal="reviews_all"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        Все отзывы →
      </a>
      <span class="hidden sm:inline text-[var(--color-border)]">|</span>
      <a
        href="/contact"
        data-ym-goal="cta_after_reviews"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent)] hover:underline transition-colors"
      >
        Хотите такой же результат? Обсудить задачу →
      </a>
    </div>

  </div>
</section>
