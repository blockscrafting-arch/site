---
/**
 * Страница «Услуги» — детальный разбор продуктовой линейки «на пальцах».
 * Hero, sticky quick-nav, 8 сервис-блоков с flow-диаграммами и мини-кейсами, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceShowcase from '../components/sections/ServiceShowcase.astro';
import ServiceQuickNav from '../components/features/ServiceQuickNav.astro';
import Button from '../components/common/Button.astro';

const quickNavItems = [
  { id: 'telegram-bots', label: 'Telegram-боты' },
  { id: 'ai-agents', label: 'AI-агенты' },
  { id: 'mini-apps', label: 'Mini Apps' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'parsing', label: 'Парсинг' },
  { id: 'autoposting', label: 'Автопостинг' },
  { id: 'scripts', label: 'Скрипты' },
  { id: 'integrations', label: 'Интеграции' },
];
---

<BaseLayout
  title="Услуги — vlad.execute(_)"
  description="Telegram-боты, AI-агенты, автоматизация, парсинг — объясняю на пальцах, что это и зачем бизнесу. С примерами реальных кейсов."
>
  <!-- Hero -->
  <section class="pt-24 pb-6 sm:pt-32 sm:pb-8 px-4 sm:px-6 relative" aria-labelledby="services-hero-heading">
    <div class="mx-auto max-w-3xl text-center grid gap-2 sm:gap-3 relative">
      <div class="relative flex justify-center">
        <h1 id="services-hero-heading" class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl relative z-10">
          Что я делаю и зачем это бизнесу
        </h1>
      </div>
      <p class="reveal text-lg text-[var(--color-text-muted)] leading-snug" style="animation-delay: 0.06s">
        Простыми словами — с примерами и цифрами из реальных проектов.
      </p>
    </div>
  </section>

  <!-- Sticky quick-nav -->
  <ServiceQuickNav items={quickNavItems} />

  <!-- 1. Telegram-боты -->
  <ServiceShowcase
    id="telegram-bots"
    title="Telegram-боты"
    pitch="Один бот — приём заявок, поддержка, рассылки и админка в одном чате"
    description="Многофункциональный бот под ваши процессы: приём заявок и запись на приём, ответы по FAQ и передача диалога менеджеру, рассылки и проверка подписок. В том же чате — админ-панель: модерация, настройки, отчёты и запуск скриптов без отдельных сервисов. Кнопки, меню, публикация постов в каналы и группы. Клиент общается в привычном мессенджере, вы управляете всем из одного окна."
    flowSteps={['Клиент пишет', 'Бот распознаёт запрос', 'Обработка (CRM/база/скрипт)', 'Ответ или админка в чате']}
    benefits={['Заявки, поддержка и рассылки в одном боте', 'Админка и отчёты прямо в чате', 'Проверка подписок, кнопки, посты', '24/7, масштаб без найма']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: контент на автопилоте"
    caseMetric="60 мин → 2 мин на пост"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path class="svg-draw service-chat-pop" pathLength="1" d="M26 46h40v36c0 2-2 4-4 4H30c-2 0-4-2-4-4V46z" style="animation-delay: 0.15s" />
      <path class="svg-draw" pathLength="1" d="M26 50h40M32 60h28M32 70h20" />
      <circle cx="38" cy="80" r="2.5" class="service-typing-dot" />
      <circle cx="46" cy="80" r="2.5" class="service-typing-dot" />
      <circle cx="54" cy="80" r="2.5" class="service-typing-dot" />
      <rect class="svg-draw service-chat-pop" pathLength="1" x="58" y="22" width="36" height="44" rx="4" style="animation-delay: 0.45s" />
      <path class="svg-draw" pathLength="1" d="M64 30h24M64 38h18M64 46h22" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M76 72v10M76 82h-6M76 82h6" stroke-width="2" />
    </svg>
  </ServiceShowcase>

  <!-- 2. AI-агенты: робот с подмигиванием -->
  <ServiceShowcase
    id="ai-agents"
    title="AI-агенты"
    pitch="Цифровой сотрудник с памятью и вашими регламентами"
    description="Агент на базе LLM и RAG: анализирует документы, отвечает клиентам по вашим правилам, готовит черновики и отчёты. Не устаёт, не забывает контекст — вы тратите время на решение задач, а не на рутину."
    flowSteps={['Запрос', 'AI анализирует контекст (RAG/память)', 'Генерирует ответ', 'Результат']}
    benefits={['Помнит контекст', 'Работает с документами', 'Учится на ваших данных', 'Заменяет рутину отдела']}
    caseSlug="ai-lawyer"
    caseTitle="ИИ-юрист: анализ и КП по ГОСТу"
    caseMetric="15 условий проверки за секунды"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="30" y="30" width="60" height="60" rx="12" />
      <circle class="svg-draw text-[var(--color-accent)]" pathLength="1" cx="45" cy="55" r="4" stroke-width="2" />
      <circle class="svg-draw text-[var(--color-accent)] service-robot-blink" pathLength="1" cx="75" cy="55" r="4" stroke-width="2" />
      <path class="svg-draw" pathLength="1" d="M45 75 Q 60 85 75 75" />
      <path class="svg-draw" pathLength="1" d="M60 30 V 15" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="12" r="3" />
      <path class="svg-draw" pathLength="1" d="M30 60 H 15 M 90 60 H 105" opacity="0.5" />
    </svg>
  </ServiceShowcase>

  <!-- 3. Mini Apps: интерфейс приложения (баланс, кнопки, список, таб-бар) -->
  <ServiceShowcase
    id="mini-apps"
    title="TG Mini Apps"
    pitch="Приложение под ваш бренд внутри Telegram — без отдельной установки"
    description="Веб-приложение в одном стиле с ботом: каталог, запись на приём, личный кабинет, калькулятор. Клиент открывает по кнопке в чате, пользуется и платит, не выходя из мессенджера. Свой дизайн и UX, а не шаблон — как будто встроенный раздел вашего продукта."
    flowSteps={['Клиент нажимает кнопку в боте', 'Открывается Mini App', 'Взаимодействие', 'Данные в бот/CRM']}
    benefits={['Кастомный интерфейс под бренд', 'Без установки приложения', 'Оплата в Telegram', 'Единый стиль с ботом']}
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="28" y="12" width="64" height="96" rx="8" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="22" r="2.5" />
      <path class="service-fade-in" pathLength="1" d="M38 32h44M38 38h28" style="animation-delay: 0.2s" />
      <rect class="svg-draw text-[var(--color-accent)] service-fade-in service-btn-pulse" pathLength="1" x="38" y="48" width="32" height="14" rx="3" stroke-width="2" style="animation-delay: 0.3s" />
      <path class="svg-draw" pathLength="1" d="M44 56h8M52 56h4" opacity="0.8" />
      <rect class="svg-draw text-[var(--color-accent)] service-fade-in" pathLength="1" x="74" y="48" width="32" height="14" rx="3" stroke-width="2" style="animation-delay: 0.35s" />
      <path class="svg-draw" pathLength="1" d="M80 56h8M90 56h4" opacity="0.8" />
      <path class="service-fade-in" pathLength="1" d="M38 76h44M42 84h36M42 92h28" style="animation-delay: 0.45s" />
      <path class="svg-draw" pathLength="1" d="M36 100h48" opacity="0.4" />
      <circle cx="44" cy="104" r="1.5" fill="currentColor" class="service-fade-in" style="animation-delay: 0.5s" />
      <circle cx="60" cy="104" r="1.5" fill="currentColor" opacity="0.5" class="service-fade-in" style="animation-delay: 0.55s" />
      <circle cx="76" cy="104" r="1.5" fill="currentColor" opacity="0.5" class="service-fade-in" style="animation-delay: 0.6s" />
    </svg>
  </ServiceShowcase>

  <!-- 4. Автоматизация: сигнал бежит по пунктирным линиям -->
  <ServiceShowcase
    id="automation"
    title="Автоматизация"
    pitch="Цепочки и рутину ведёт система — вы только проверяете результат"
    description="Заявка ушла в CRM, клиенту улетело письмо, отчёт собрался по расписанию — без вашего участия. Собираю воронки в n8n: триггер (форма, webhook, расписание) → обработка по правилам → действия (таблицы, почта, мессенджеры). Один раз настроили — работает 24/7, без забытых шагов."
    flowSteps={['Триггер (событие/расписание)', 'Обработка по алгоритму', 'Действия (CRM, почта, таблица)', 'Уведомление или тишина']}
    benefits={['Любая рутина и алгоритм', 'Работает 24/7', 'Нет человеческого фактора', 'Масштабируется']}
    caseSlug="voice-to-text"
    caseTitle="Голосовые в текст: 40 войсов в день"
    caseMetric="−100 мин/день, 10 ч/нед вернули клиенту"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="20" y="40" width="24" height="24" rx="4" />
      <rect class="svg-draw text-[var(--color-accent)]" pathLength="1" x="65" y="20" width="30" height="30" rx="6" stroke-width="2" />
      <rect class="svg-draw" pathLength="1" x="65" y="70" width="30" height="30" rx="6" />
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M44 52 H 55 V 35 H 65" stroke-dasharray="4 4" stroke-width="1.5" />
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M44 52 H 55 V 85 H 65" stroke-dasharray="4 4" stroke-width="1.5" style="animation-delay: 0.6s" />
      <circle class="svg-draw" pathLength="1" cx="55" cy="52" r="2" fill="currentColor" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M72 35 L 80 43 L 88 35" stroke-width="1.5" />
    </svg>
  </ServiceShowcase>

  <!-- 5. Парсинг: лупа движется, под ней строки увеличены (clipPath в координатах группы) -->
  <ServiceShowcase
    id="parsing"
    title="Парсинг"
    pitch="Данные из сайтов и каналов — в таблицу или базу, по расписанию"
    description="Цены конкурентов, контакты, новости, посты из каналов — собираю откуда нужно и отдаю в удобном виде: таблица, CSV, база. Запуск по кнопке или по расписанию. Вы получаете актуальные данные без ручного копирования."
    flowSteps={['Источники (сайты/каналы/API)', 'Скрипт парсит', 'Фильтрация', 'Данные в таблицу/базу']}
    benefits={['Экономия часов ручного сбора', 'Актуальные данные', 'Масштабируется', 'Запуск по расписанию']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: мониторинг каналов"
    caseMetric="Мониторинг без ручного труда"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <defs>
        <clipPath id="magnify-parsing">
          <circle cx="0" cy="0" r="16" />
        </clipPath>
      </defs>
      <path class="svg-draw" pathLength="1" d="M18 48h84M18 58h72M18 68h78" opacity="0.4" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M22 48l2 2 4-4M40 58l2 2 4-4" stroke-width="1.5" opacity="0.6" />
      <g class="service-scan-glass">
        <circle class="svg-draw text-[var(--color-accent)]" pathLength="1" cx="0" cy="0" r="16" stroke-width="2" />
        <path class="svg-draw" pathLength="1" d="M12 12 L 20 20" stroke-width="2" />
        <g clip-path="url(#magnify-parsing)">
          <g transform="scale(1.4)">
            <path class="text-[var(--color-accent)]" d="M-40 -10 h80 M-40 0 h70 M-40 10 h76" stroke-width="2.5" opacity="0.9" />
          </g>
        </g>
      </g>
      <path class="svg-draw" pathLength="1" d="M20 88h80M24 96h72M28 104h64" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M26 88l3 3 5-6M44 96l4 4 6-7" stroke-width="1.5" />
    </svg>
  </ServiceShowcase>

  <!-- 6. Автопостинг: календарь, часы, самолётик, AI-звёзды -->
  <ServiceShowcase
    id="autoposting"
    title="Автопостинг"
    pitch="Контент по расписанию: AI пишет и рисует, вы только нажимаете «опубликовать»"
    description="Идея или источник → AI генерирует текст и картинку → вы проверяете и одной кнопкой отправляете в Telegram, VK, Дзен. Публикация по расписанию, кросс-постинг в несколько каналов. Вместо часа на пост — пара минут на контроль."
    flowSteps={['Идея/источник', 'AI пишет текст', 'AI рисует картинку', 'Модерация (1 кнопка)', 'Публикация в N каналов']}
    benefits={['Контент 24/7', 'Кросс-постинг', 'AI-генерация', 'Контроль одной кнопкой']}
    caseSlug="ai-content-conveyor"
    caseTitle="AI-конвейер для автопостинга"
    caseMetric="30–40 мин → 2 мин на пост"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="22" y="32" width="48" height="44" rx="4" />
      <path class="svg-draw" pathLength="1" d="M22 40h48M34 48h4M44 48h4M54 48h4M34 56h4M44 56h4M54 56h4" />
      <circle class="svg-draw text-[var(--color-accent)]" pathLength="1" cx="72" cy="42" r="14" stroke-width="2" />
      <path class="svg-draw" pathLength="1" d="M72 38v8M68 42h8" />
      <path class="svg-draw text-[var(--color-accent)] service-fly-away" pathLength="1" d="M88 28 L 102 38 L 95 42 L 102 46 L 88 56" stroke-width="2" fill="none" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M28 22 L 30 26 L 28 28 L 26 26 Z" opacity="0.8" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M92 72 L 94 76 L 92 78 L 90 76 Z" opacity="0.6" class="animate-pulse" style="animation-duration: 2s" />
      <path class="svg-draw" pathLength="1" d="M20 88h80M24 96h72M28 104h64" opacity="0.5" />
    </svg>
  </ServiceShowcase>

  <!-- 7. Скрипты: терминал с анимацией печати строк -->
  <ServiceShowcase
    id="scripts"
    title="Скрипты"
    pitch="Точечный код под задачу: файлы, отчёты, конвертация — без лишних систем"
    description="Когда не нужен целый воркфлоу или бот — пишу скрипт на Python под одну задачу. Обработка и конвертация файлов, генерация отчётов из таблиц и баз, массовая выгрузка или рассылка. Запуск вручную одной кнопкой или по расписанию. Идеально для разовых задач и регулярной рутины, которую нецелесообразно тянуть в n8n."
    flowSteps={['Входные данные (файлы/таблица/API)', 'Скрипт обрабатывает', 'Результат: файл, отчёт или действие']}
    benefits={['Ровно под вашу задачу', 'Без лишних сервисов', 'Запуск по кнопке или cron', 'С комментариями и инструкцией']}
    caseSlug="vk-autoposter"
    caseTitle="Автопостер для ВКонтакте"
    caseMetric="10 мин → 1 сек на публикацию"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="15" y="25" width="90" height="70" rx="6" />
      <line class="svg-draw" pathLength="1" x1="15" y1="45" x2="105" y2="45" />
      <circle cx="25" cy="35" r="2" fill="currentColor" opacity="0.5" />
      <circle cx="33" cy="35" r="2" fill="currentColor" opacity="0.5" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M25 60 L 35 70 L 25 80" stroke-width="2.5" />
      <line class="text-[var(--color-accent)] animate-pulse" x1="40" y1="80" x2="55" y2="80" stroke-width="2.5" />
      <path class="svg-draw service-terminal-line" pathLength="1" d="M40 58 L 85 58" opacity="0.7" />
      <path class="svg-draw service-terminal-line" pathLength="1" d="M40 68 L 75 68" opacity="0.5" />
    </svg>
  </ServiceShowcase>

  <!-- 8. Интеграции: два сервера, связаны «веревкой» крест-накрест, сигнал по линиям -->
  <ServiceShowcase
    id="integrations"
    title="Интеграции"
    pitch="Связываю сервисы: данные текут туда, куда нужно, без ручного переноса"
    description="CRM не видит заявки из мессенджера? Таблица не обновляется из базы? Собираю мосты между системами: Telegram, 1C, Bitrix, Google Sheets, любые API. Двусторонняя синхронизация или односторонняя выгрузка — под вашу схему работы."
    flowSteps={['Сервис A', 'API/webhook', 'n8n/скрипт', 'Сервис B']}
    benefits={['Единый поток данных', 'Нет ручного переноса', 'Любые сервисы', 'Двусторонняя синхронизация']}
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="18" y="26" width="32" height="68" rx="5" />
      <path class="svg-draw" pathLength="1" d="M26 38h16M26 48h12M26 58h18" />
      <rect class="svg-draw" pathLength="1" x="70" y="26" width="32" height="68" rx="5" />
      <path class="svg-draw" pathLength="1" d="M78 38h16M78 48h12M78 58h18" />
      <!-- Веревка крест-накрест + бегущий сигнал -->
      <path class="svg-draw text-[var(--color-accent)] service-animate-dash-flow" pathLength="1" d="M50 38 L 70 58" stroke-width="2.5" stroke-dasharray="6 6" />
      <path class="svg-draw text-[var(--color-accent)] service-animate-dash-flow" pathLength="1" d="M50 74 L 70 54" stroke-width="2.5" stroke-dasharray="6 6" style="animation-delay: 0.6s" />
    </svg>
  </ServiceShowcase>

  <!-- CTA -->
  <section class="py-16 sm:py-24 px-4 sm:px-6 border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-xl font-bold text-[var(--color-text)] sm:text-2xl">
        Не уверены, с чего начать?
      </h2>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Опишите задачу — подскажу, какой вариант подойдёт и что могу сделать. Ответ в течение дня.
      </p>
      <div class="mt-8">
        <Button href="/contact" variant="primary">Обсудить задачу</Button>
      </div>
    </div>
  </section>
</BaseLayout>
