---
/**
 * Секция «Услуги»: 6 карточек с иконками. Без GSAP, без tilt — CSS reveal.
 */
import Badge from '../common/Badge.astro';
import Button from '../common/Button.astro';

const services = [
  { title: 'Боты в мессенджерах', desc: 'Приём заявок, поддержка, рассылки и мини-приложения в одном чате — Telegram, MAX, VK.', tags: ['Telegram', 'MAX', 'VK'], href: '/services#telegram-bots', icon: 'chat' },
  { title: 'AI-агенты', desc: 'Обработка заявок, аналитика, ответы клиентам на базе LLM и RAG.', tags: ['LLM', 'RAG'], href: '/services#ai-agents', icon: 'brain' },
  { title: 'Mini Apps', desc: 'Веб-приложения внутри мессенджеров: Telegram, MAX, VK — формы, каталоги, личные кабинеты.', tags: ['Telegram', 'MAX', 'VK'], href: '/services#mini-apps', icon: 'app' },
  { title: 'n8n-автоматизация', desc: 'Связываю CRM, мессенджеры, таблицы и сервисы в единые воронки.', tags: ['n8n', 'API'], href: '/services#automation', icon: 'flow' },
  { title: 'Скрипты и парсеры', desc: 'Парсинг данных, интеграции, кастомные решения на Python под задачу.', tags: ['Python', 'API'], href: '/services#parsing', icon: 'code' },
  { title: 'Кастомная разработка', desc: 'Интеграции под ключ, бэкенды, автоматизация под ваш процесс.', tags: ['Python', 'n8n'], href: '/services#integrations', icon: 'wrench' },
];
---

<section class="py-24 sm:py-32 px-4 sm:px-6 relative overflow-hidden" aria-labelledby="services-heading">
  <div class="mx-auto max-w-6xl">
    <div class="relative w-full max-w-3xl mx-auto mb-4">
      <!-- SVG: n8n-ноды. Контекст — вся ширина; sm+ — справа -->
      <div class="absolute -z-10 pointer-events-none text-[var(--color-accent)] opacity-[0.10] sm:opacity-[0.15] w-64 h-64 left-1/2 -translate-x-1/2 top-0 -translate-y-[45%] sm:w-84 sm:h-84 sm:left-auto sm:right-0 sm:translate-x-[20%] sm:top-1/2 sm:-translate-y-1/2" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 300 200" fill="none">
          <g stroke="var(--color-text-muted)" stroke-width="2" opacity="0.6">
            <path d="M 80 100 L 120 100" />
            <path d="M 180 100 C 200 100, 200 50, 220 50" />
            <path d="M 180 100 C 200 100, 200 150, 220 150" />
          </g>
          <g class="animate-data-flow text-[var(--color-accent)]" stroke="currentColor" stroke-width="2" stroke-dasharray="6 12" fill="none" opacity="1">
            <path d="M 80 100 L 120 100" />
            <path d="M 180 100 C 200 100, 200 50, 220 50" />
            <path d="M 180 100 C 200 100, 200 150, 220 150" />
          </g>
          <rect x="20" y="70" width="60" height="60" rx="10" stroke="#3b82f6" stroke-width="3" fill="var(--color-bg)" />
          <rect x="120" y="70" width="60" height="60" rx="10" stroke="#22c55e" stroke-width="3" fill="var(--color-bg)" />
          <rect x="220" y="20" width="60" height="60" rx="10" stroke="#ec4899" stroke-width="3" fill="var(--color-bg)" />
          <rect x="220" y="120" width="60" height="60" rx="10" stroke="#9ca3af" stroke-width="3" stroke-dasharray="6 6" fill="var(--color-bg)" />
        </svg>
      </div>
      <div class="flex justify-center">
        <h2 id="services-heading" class="reveal font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl md:text-4xl text-center relative z-10">
          Решения под ключ
        </h2>
      </div>
    </div>
    <p class="reveal mt-3 text-center text-[var(--color-text-muted)] text-sm sm:text-base max-w-lg mx-auto" style="animation-delay:.06s">
      Меньше ручной работы, больше результата — от идеи до запуска.
    </p>

    <div class="reveal-stagger mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <a
          href={s.href}
          class="service-card group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 overflow-hidden"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent-muted)] text-[var(--color-accent)] group-hover:text-[var(--color-text)] transition-colors animate-float-icon" aria-hidden="true">
            {s.icon === 'chat' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>)}
            {s.icon === 'brain' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>)}
            {s.icon === 'app' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>)}
            {s.icon === 'flow' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>)}
            {s.icon === 'code' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>)}
            {s.icon === 'wrench' && (<svg class="h-5 w-5 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>)}
          </span>
          <h3 class="font-display font-semibold text-[var(--color-text)] text-lg mt-4">{s.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{s.desc}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {s.tags.map((tag) => <Badge variant="gray">{tag}</Badge>)}
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] transition-colors">
            Подробнее
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
    <div class="reveal mt-12 text-center" style="animation-delay: 0.24s">
      <Button href="/services" variant="outline" dataYmGoal="nav_services">Все услуги</Button>
    </div>
  </div>
</section>
