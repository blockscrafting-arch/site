---
/**
 * Шапка сайта: лого, навигация, тема.
 * Адаптив: бургер-меню на мобильных.
 * Анимация: появление при скролле вверх, скрытие при скролле вниз (headroom эффект).
 */
import Navigation from './Navigation.astro';
import ThemeToggle from '../features/ThemeToggle';
import { site } from '../../utils/site';
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 bg-[var(--color-bg)]/80 backdrop-blur-md border-b border-[var(--color-border)]"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] rounded-lg">
        <span class="font-display text-xl font-bold text-[var(--color-text)] tracking-tight">
          vlad<span class="text-[var(--color-accent)]">.execute(_)</span>
        </span>
      </a>
    </div>

    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-6">
      <Navigation />
      <div class="h-4 w-px bg-[var(--color-border)]"></div>
      <ThemeToggle client:load />
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex md:hidden items-center gap-4">
      <ThemeToggle client:load />
      <button
        id="mobile-menu-btn"
        type="button"
        class="group relative z-50 flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] transition-colors hover:bg-[var(--color-surface-muted)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Открыть меню</span>
        <div class="flex flex-col gap-1.5 transition-all duration-300 group-aria-expanded:gap-0">
          <span class="h-0.5 w-5 bg-current transition-all duration-300 group-aria-expanded:rotate-45 group-aria-expanded:translate-y-0.5"></span>
          <span class="h-0.5 w-5 bg-current transition-all duration-300 group-aria-expanded:opacity-0"></span>
          <span class="h-0.5 w-5 bg-current transition-all duration-300 group-aria-expanded:-rotate-45 group-aria-expanded:-translate-y-0.5"></span>
        </div>
      </button>
    </div>
  </div>

</header>

<!-- Mobile Menu Backdrop & Panel (moved out of header to avoid transform issues) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] flex flex-col bg-[var(--color-bg)]/95 backdrop-blur-xl transition-all duration-300 translate-x-full opacity-0 pointer-events-none aria-expanded:translate-x-0 aria-expanded:opacity-100 aria-expanded:pointer-events-auto md:hidden"
  aria-hidden="true"
>
  <div class="flex h-16 items-center justify-between px-4 border-b border-[var(--color-border)]">
    <span class="font-display text-xl font-bold text-[var(--color-text)]">Меню</span>
    <button
      type="button"
      class="mobile-menu-close flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] transition-colors hover:bg-[var(--color-surface-muted)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
      aria-label="Закрыть меню"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto px-4 py-8">
    <nav class="flex flex-col gap-6 text-lg">
      <Navigation mobile />
    </nav>
    <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
      <a href="/contact" class="block w-full rounded-xl bg-[var(--color-accent)] px-4 py-3 text-center font-medium text-white shadow-lg shadow-[var(--color-accent)]/20 active:scale-95 transition-transform">
        Обсудить задачу
      </a>
    </div>
  </div>
</div>

<script>
  // Header scroll behavior: троттлинг по rAF + гистерезис, чтобы не дёргалось при скролле (Lenis)
  const header = document.getElementById('main-header');
  let lastScroll = 0;
  let headerVisible = true;
  let rafId = null;
  const HIDE_THRESHOLD = 120;
  const SHOW_THRESHOLD = 60;
  const MIN_DELTA = 40;

  function updateHeader() {
    const currentScroll = window.scrollY;
    if (!header) return;
    const menu = document.getElementById('mobile-menu');
    if (menu && menu.getAttribute('aria-expanded') === 'true') {
      header.style.transform = 'translateY(0)';
      rafId = null;
      return;
    }
    if (currentScroll <= SHOW_THRESHOLD) {
      headerVisible = true;
      header.style.transform = 'translateY(0)';
    } else {
      const delta = currentScroll - lastScroll;
      if (delta > MIN_DELTA && currentScroll > HIDE_THRESHOLD) {
        headerVisible = false;
        header.style.transform = 'translateY(-100%)';
      } else if (delta < -MIN_DELTA || currentScroll < HIDE_THRESHOLD) {
        headerVisible = true;
        header.style.transform = 'translateY(0)';
      }
    }
    lastScroll = currentScroll;
    rafId = null;
  }

  window.addEventListener('scroll', function () {
    if (!header || rafId !== null) return;
    rafId = requestAnimationFrame(updateHeader);
  }, { passive: true });

  // Mobile Menu Logic
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.querySelector('.mobile-menu-close');
  const body = document.body;

  function toggleMenu(show: boolean) {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(show));
    menu.setAttribute('aria-expanded', String(show));
    menu.setAttribute('aria-hidden', String(!show));
    
    if (show) {
      body.style.overflow = 'hidden';
    } else {
      body.style.overflow = '';
    }
  }

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      toggleMenu(!isExpanded);
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', () => toggleMenu(false));
    }

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });
  }

</script>
