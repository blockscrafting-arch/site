---
/**
 * Hero главной: печатающийся заголовок (TypeIt) как h1, подзаголовок, терминал с метриками, CTA, визуализация.
 */
import Button from '../common/Button.astro';
import TypewriterHero from '../features/TypewriterHero';
import HeroAutomationVisual from '../illustrations/HeroAutomationVisual.astro';
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center px-4 py-24 sm:px-6 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-hero opacity-60" aria-hidden="true"></div>
  <!-- Декоративные блобы для глубины -->
  <div class="absolute top-1/4 -left-32 w-96 h-96 rounded-full bg-[var(--color-accent)]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-1/4 -right-32 w-80 h-80 rounded-full bg-[var(--color-accent-cyan)]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="max-w-3xl mx-auto lg:mx-0 text-center lg:text-left flex-1">
        <h1 class="hero-title font-display text-4xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl lg:text-7xl">
          <TypewriterHero client:load class="!text-inherit min-h-[1.2em] inline-block" />
        </h1>
        <p class="hero-subtitle mt-6 text-lg text-[var(--color-text-muted)] sm:text-xl max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Telegram-боты, AI-агенты, n8n — от идеи до запуска. <br class="hidden sm:block" />
          <span class="text-gradient-animate font-semibold">Экономлю время и бюджет.</span>
        </p>
        
        <div class="hero-terminal mt-10 rounded-xl border border-[var(--color-border)] bg-[#1e1e1e]/90 backdrop-blur-md p-5 text-left font-mono text-sm sm:text-base max-w-xl mx-auto lg:mx-0 overflow-hidden shadow-2xl shadow-black/20 transform transition hover:scale-[1.01]">
          <div class="flex gap-2 mb-3 border-b border-white/10 pb-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <div class="text-gray-300 space-y-2">
            <div class="flex"><span class="text-green-400 mr-2">➜</span> <span class="text-blue-400">bot</span>.deploy() <span class="text-gray-500 ml-auto">// 2400+ лидов/мес</span></div>
            <div class="flex"><span class="text-green-400 mr-2">➜</span> <span class="text-blue-400">agent</span>.run() <span class="text-gray-500 ml-auto">// −80% рутины</span></div>
            <div class="flex"><span class="text-green-400 mr-2">➜</span> <span class="text-blue-400">automate</span>() <span class="text-gray-500 ml-auto">// 24/7 online</span></div>
          </div>
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-center lg:justify-start gap-4">
          <Button href="/contact" variant="primary" class="shadow-glow-sm hover:scale-105 transition-transform">Обсудить задачу</Button>
          <Button href="/cases" variant="ghost">Смотреть кейсы</Button>
        </div>
      </div>
      
      <!-- Visual Block -->
      <div class="mt-16 lg:mt-0 lg:w-[45%] flex justify-center lg:justify-end relative perspective-1000">
        <div class="absolute inset-0 bg-gradient-radial from-emerald-500/10 to-transparent blur-3xl -z-10 transform translate-x-10"></div>
        <HeroAutomationVisual />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const title = document.querySelector('.hero-title');
  const subtitle = document.querySelector('.hero-subtitle');
  const terminal = document.querySelector('.hero-terminal');
  const visual = document.querySelector('.hero-visual'); // Not used in template but good for ref

  if (title) {
    gsap.fromTo(title, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.6, delay: 0.15, ease: 'power2.out' });
  }
  if (subtitle) {
    gsap.fromTo(subtitle, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, delay: 0.5, ease: 'power2.out' });
  }
  if (terminal) {
    gsap.fromTo(terminal, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, delay: 0.85, ease: 'power2.out' });
  }
</script>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>
