---
/**
 * Шапка сайта: логотип, навигация, переключатель темы.
 * Blur-фон, минималистичная навигация. На мобильных — <details> без inline-скриптов (CSP-friendly).
 */
import Navigation from './Navigation.astro';
import ThemeToggle from '../features/ThemeToggle';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/70 backdrop-blur-md supports-[backdrop-filter]:bg-[var(--color-bg)]/50">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="font-mono text-lg font-semibold tracking-tight text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-bg)] rounded transition-colors hover:opacity-90"
      aria-label="На главную"
    >
      vlad.execute(<span class="text-[var(--color-accent)]">_</span>)
    </a>

    <div class="flex items-center gap-2">
      <div class="hidden md:block">
        <Navigation />
      </div>
      <ThemeToggle client:load />
      <details class="md:hidden group" id="mobile-menu-details">
        <summary
          class="list-none rounded-lg p-2 cursor-pointer [&::-webkit-details-marker]:hidden text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)]"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Открыть меню</span>
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div
          id="mobile-menu"
          class="absolute left-0 right-0 top-full border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 shadow-lg"
          role="group"
          aria-label="Мобильное меню"
        >
          <nav class="flex flex-col gap-1" aria-label="Мобильное меню">
            <a href="/" class="rounded-lg px-3 py-2 text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]">Главная</a>
            <a href="/cases" class="rounded-lg px-3 py-2 text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]">Кейсы</a>
            <a href="/guides" class="rounded-lg px-3 py-2 text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]">Инструкции</a>
            <a href="/about" class="rounded-lg px-3 py-2 text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]">Обо мне</a>
            <a href="/contact" class="rounded-lg px-3 py-2 text-[var(--color-text-muted)] hover:bg-[var(--color-surface-muted)] hover:text-[var(--color-text)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]">Контакты</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
