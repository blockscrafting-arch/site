---
/**
 * Sticky-навигация по услугам на странице /services.
 * Горизонтальные pills с якорными ссылками; активный элемент подсвечивается по IntersectionObserver.
 * На мобильных: зелёный градиент справа (global.css) — намёк на продолжение контента.
 */
export interface NavItem {
  id: string;
  label: string;
}

export interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav class="service-quick-nav py-3 px-4 sm:px-6" aria-label="Навигация по услугам">
  <div class="service-quick-nav-inner mx-auto max-w-6xl flex items-center gap-2">
    {items.map((item, i) => (
      <a
        href={`#${item.id}`}
        class:list={[
          'rounded-full px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
          i === 0 && 'is-active',
        ]}
        data-service-id={item.id}
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>

<script>
  /**
   * Подсветка активного пункта по видимой секции (IntersectionObserver).
   * Один активный id по максимальной доле видимости; обновляет все .service-quick-nav на странице (в потоке и fixed-копию).
   */
  (function () {
    const navs = document.querySelectorAll('.service-quick-nav');
    if (!navs.length) return;
    const firstNav = navs[0];
    const links = firstNav.querySelectorAll('a[data-service-id]');
    const sectionIds = [];
    const idToSection = new Map();
    links.forEach((link) => {
      const id = link.getAttribute('data-service-id');
      if (id) {
        const el = document.getElementById(id);
        if (el) {
          sectionIds.push(id);
          idToSection.set(id, el);
        }
      }
    });

    let visibleRatios = new Map();
    let rafScheduled = false;

    function updateActive() {
      rafScheduled = false;
      let bestId = null;
      let bestRatio = 0;
      visibleRatios.forEach((ratio, id) => {
        if (ratio > bestRatio) {
          bestRatio = ratio;
          bestId = id;
        }
      });
      if (!bestId && sectionIds.length) bestId = sectionIds[0];
      navs.forEach((nav) => {
        nav.querySelectorAll('a[data-service-id]').forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('data-service-id') === bestId);
        });
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (!id) return;
          visibleRatios.set(id, entry.isIntersecting ? entry.intersectionRatio : 0);
        });
        if (!rafScheduled) {
          rafScheduled = true;
          requestAnimationFrame(updateActive);
        }
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] }
    );

    idToSection.forEach((el) => observer.observe(el));
  })();
</script>
