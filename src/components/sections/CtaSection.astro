---
/**
 * Финальный CTA на главной: «Готовы автоматизировать?» + кнопка/форма.
 */
import Button from '../common/Button.astro';
import { site } from '../../utils/site';
---

<section class="py-24 sm:py-32 px-4 sm:px-6" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-2xl text-center">
    <div class="cta-block rounded-3xl border-2 border-[var(--color-border)] bg-[var(--color-surface)] bg-gradient-to-b from-[var(--color-accent-muted)]/20 to-transparent p-10 sm:p-14 shadow-[0_0_0_1px_var(--color-accent)_inset,0_0_30px_-10px_var(--color-accent-glow)]">
      <h2 id="cta-heading" class="cta-heading font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl md:text-4xl">
        Готовы автоматизировать?
      </h2>
      <p class="cta-desc mt-4 text-[var(--color-text-muted)]">
        Опишите задачу — обсудим решение и сроки. Ответ в течение дня.
      </p>
      <div class="cta-buttons mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/contact" variant="primary" class="shadow-glow-sm">Обсудить задачу</Button>
        <a
          href={site.tgChannel}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)]"
        >
          Написать в Telegram
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const block = document.querySelector('.cta-block');
  if (block) {
    gsap.fromTo(block, { opacity: 0, y: 28, scale: 0.98 }, {
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 0.7,
      ease: 'power2.out',
      scrollTrigger: { trigger: block, start: 'top 85%', toggleActions: 'play none none none' },
    });
  }
</script>
