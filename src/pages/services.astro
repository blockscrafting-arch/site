---
/**
 * Страница «Услуги» — детальный разбор продуктовой линейки «на пальцах».
 * Hero, sticky quick-nav, 8 сервис-блоков с flow-диаграммами и мини-кейсами, CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceShowcase from '../components/sections/ServiceShowcase.astro';
import ServiceQuickNav from '../components/features/ServiceQuickNav.astro';
import Button from '../components/common/Button.astro';

const quickNavItems = [
  { id: 'telegram-bots', label: 'Telegram-боты' },
  { id: 'ai-agents', label: 'AI-агенты' },
  { id: 'mini-apps', label: 'Mini Apps' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'parsing', label: 'Парсинг' },
  { id: 'autoposting', label: 'Автопостинг' },
  { id: 'scripts', label: 'Скрипты' },
  { id: 'integrations', label: 'Интеграции' },
];
---

<BaseLayout
  title="Услуги — vlad.execute(_)"
  description="Telegram-боты, AI-агенты, автоматизация, парсинг — объясняю на пальцах, что это и зачем бизнесу. С примерами реальных кейсов."
>
  <!-- Hero -->
  <section class="pt-24 pb-6 sm:pt-32 sm:pb-8 px-4 sm:px-6 relative" aria-labelledby="services-hero-heading">
    <div class="mx-auto max-w-3xl text-center grid gap-2 sm:gap-3 relative">
      <div class="relative flex justify-center">
        <h1 id="services-hero-heading" class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl relative z-10">
          Что я делаю и зачем это бизнесу
        </h1>
      </div>
      <p class="reveal text-lg text-[var(--color-text-muted)] leading-snug" style="animation-delay: 0.06s">
        Простыми словами — с примерами и цифрами из реальных проектов.
      </p>
    </div>
  </section>

  <!-- Sticky quick-nav -->
  <ServiceQuickNav items={quickNavItems} />

  <!-- 1. Telegram-боты -->
  <ServiceShowcase
    id="telegram-bots"
    title="Telegram-боты"
    pitch="Один бот — приём заявок, поддержка, рассылки и админка в одном чате"
    description="Многофункциональный бот под ваши процессы: приём заявок и запись на приём, ответы по FAQ и передача диалога менеджеру, рассылки и проверка подписок. В том же чате — админ-панель: модерация, настройки, отчёты и запуск скриптов без отдельных сервисов. Кнопки, меню, публикация постов в каналы и группы. Клиент общается в привычном мессенджере, вы управляете всем из одного окна."
    flowSteps={['Клиент пишет', 'Бот распознаёт запрос', 'Обработка (CRM/база/скрипт)', 'Ответ или админка в чате']}
    benefits={['Заявки, поддержка и рассылки в одном боте', 'Админка и отчёты прямо в чате', 'Проверка подписок, кнопки, посты', '24/7, масштаб без найма']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: контент на автопилоте"
    caseMetric="60 мин → 2 мин на пост"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Левый пузырь с хвостиком (клиент) -->
      <path class="svg-draw" pathLength="1" d="M 15 45 h 45 a 8 8 0 0 1 8 8 v 20 a 8 8 0 0 1 -8 8 h -35 l -10 10 v -10 a 8 8 0 0 1 -5 -5 z" />
      <!-- Три точки (клиент печатает) -->
      <circle cx="30" cy="63" r="2.5" fill="currentColor" class="service-typing-dot" style="animation-delay: 0s;" />
      <circle cx="40" cy="63" r="2.5" fill="currentColor" class="service-typing-dot" style="animation-delay: 0.2s;" />
      <circle cx="50" cy="63" r="2.5" fill="currentColor" class="service-typing-dot" style="animation-delay: 0.4s;" />
      <!-- Правый пузырь (ответ бота), появляется с задержкой -->
      <path class="service-chat-pop text-[var(--color-accent)]" d="M 105 85 h -45 a 8 8 0 0 1 -8 -8 v -20 a 8 8 0 0 1 8 -8 h 45 a 8 8 0 0 1 8 8 v 20 a 8 8 0 0 1 -5 5 v 10 l -10 -10 z" stroke-width="2" style="animation-delay: 0.5s;" />
    </svg>
  </ServiceShowcase>

  <!-- 2. AI-агенты: робот с подмигиванием -->
  <ServiceShowcase
    id="ai-agents"
    title="AI-агенты"
    pitch="Цифровой сотрудник с памятью и вашими регламентами"
    description="Агент на базе LLM и RAG: анализирует документы, отвечает клиентам по вашим правилам, готовит черновики и отчёты. Не устаёт, не забывает контекст — вы тратите время на решение задач, а не на рутину."
    flowSteps={['Запрос', 'AI анализирует контекст (RAG/память)', 'Генерирует ответ', 'Результат']}
    benefits={['Помнит контекст', 'Работает с документами', 'Учится на ваших данных', 'Заменяет рутину отдела']}
    caseSlug="ai-lawyer"
    caseTitle="ИИ-юрист: анализ и КП по ГОСТу"
    caseMetric="15 условий проверки за секунды"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="30" y="35" width="60" height="50" rx="12" />
      <path class="svg-draw" pathLength="1" d="M 60 35 v -15" />
      <circle class="svg-draw" pathLength="1" cx="60" cy="15" r="4" />
      <path class="svg-draw" pathLength="1" d="M 30 55 h -6 M 90 55 h 6" />
      <!-- Левый глаз -->
      <circle class="svg-draw text-[var(--color-accent)]" pathLength="1" cx="45" cy="55" r="4" stroke-width="2" />
      <!-- Правый глаз (мигающий, появляется сразу, без svg-draw для правильной работы CSS-трансформов, или с ним, но аккуратно) -->
      <circle cx="75" cy="55" r="4" class="text-[var(--color-accent)] service-robot-blink" stroke-width="2" style="transform-origin: 75px 55px;" />
      <path class="svg-draw" pathLength="1" d="M 45 70 q 15 10 30 0" />
    </svg>
  </ServiceShowcase>

  <!-- 3. Mini Apps: интерфейс приложения (баланс, кнопки, список, таб-бар) -->
  <ServiceShowcase
    id="mini-apps"
    title="TG Mini Apps"
    pitch="Приложение под ваш бренд внутри Telegram — без отдельной установки"
    description="Веб-приложение в одном стиле с ботом: каталог, запись на приём, личный кабинет, калькулятор. Клиент открывает по кнопке в чате, пользуется и платит, не выходя из мессенджера. Свой дизайн и UX, а не шаблон — как будто встроенный раздел вашего продукта."
    flowSteps={['Клиент нажимает кнопку в боте', 'Открывается Mini App', 'Взаимодействие', 'Данные в бот/CRM']}
    benefits={['Кастомный интерфейс под бренд', 'Без установки приложения', 'Оплата в Telegram', 'Единый стиль с ботом']}
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Корпус смартфона -->
      <rect x="35" y="10" width="50" height="100" rx="8" class="svg-draw" pathLength="1" />
      <rect x="50" y="15" width="20" height="4" rx="2" class="svg-draw" pathLength="1" />
      
      <!-- Элементы интерфейса (появляются плавно) -->
      <!-- Баланс -->
      <rect x="45" y="30" width="30" height="8" rx="4" class="service-fade-in" style="animation-delay: 0.2s;" fill="currentColor" opacity="0.2" stroke="none" />
      <path class="service-fade-in" d="M 45 42 h 20" style="animation-delay: 0.25s;" stroke-width="2" />
      
      <!-- Две кнопки -->
      <rect x="42" y="52" width="16" height="16" rx="4" class="service-fade-in text-[var(--color-accent)]" stroke-width="2" style="animation-delay: 0.3s;" />
      <path class="service-fade-in text-[var(--color-accent)]" d="M 50 57 v 6 M 47 60 l 3 3 3 -3" style="animation-delay: 0.3s;" />
      
      <rect x="62" y="52" width="16" height="16" rx="4" class="service-fade-in" style="animation-delay: 0.4s;" />
      <path class="service-fade-in" d="M 70 57 v 6 M 67 60 l 3 -3 3 3" style="animation-delay: 0.4s;" />
      
      <!-- Блок контента -->
      <rect x="42" y="75" width="36" height="20" rx="4" class="service-fade-in" style="animation-delay: 0.5s;" />
      <path class="service-fade-in" d="M 47 82 h 15 M 47 88 h 26" style="animation-delay: 0.5s;" opacity="0.5" />
      
      <!-- Нижнее меню (таб-бар) -->
      <path d="M 42 102 h 36" opacity="0.3" class="svg-draw" pathLength="1" />
      <circle cx="48" cy="102" r="1.5" fill="currentColor" class="service-fade-in" style="animation-delay: 0.6s;" stroke="none" />
      <circle cx="60" cy="102" r="1.5" fill="currentColor" class="service-fade-in" style="animation-delay: 0.6s;" stroke="none" opacity="0.4" />
      <circle cx="72" cy="102" r="1.5" fill="currentColor" class="service-fade-in" style="animation-delay: 0.6s;" stroke="none" opacity="0.4" />
    </svg>
  </ServiceShowcase>

  <!-- 4. Автоматизация: сигнал бежит по пунктирным линиям -->
  <ServiceShowcase
    id="automation"
    title="Автоматизация"
    pitch="Цепочки и рутину ведёт система — вы только проверяете результат"
    description="Заявка ушла в CRM, клиенту улетело письмо, отчёт собрался по расписанию — без вашего участия. Собираю воронки в n8n: триггер (форма, webhook, расписание) → обработка по правилам → действия (таблицы, почта, мессенджеры). Один раз настроили — работает 24/7, без забытых шагов."
    flowSteps={['Триггер (событие/расписание)', 'Обработка по алгоритму', 'Действия (CRM, почта, таблица)', 'Уведомление или тишина']}
    benefits={['Любая рутина и алгоритм', 'Работает 24/7', 'Нет человеческого фактора', 'Масштабируется']}
    caseSlug="voice-to-text"
    caseTitle="Голосовые в текст: 40 войсов в день"
    caseMetric="−100 мин/день, 10 ч/нед вернули клиенту"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Узел 1 (триггер) -->
      <rect class="svg-draw" pathLength="1" x="15" y="45" width="24" height="30" rx="6" />
      <path class="svg-draw" pathLength="1" d="M 22 60 h 10" opacity="0.5" />
      <!-- Узел 2 (действие 1) -->
      <rect class="svg-draw text-[var(--color-accent)]" pathLength="1" x="80" y="20" width="24" height="30" rx="6" stroke-width="2" />
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M 87 35 h 10" opacity="0.5" />
      <!-- Узел 3 (действие 2) -->
      <rect class="svg-draw" pathLength="1" x="80" y="70" width="24" height="30" rx="6" />
      <path class="svg-draw" pathLength="1" d="M 87 85 h 10" opacity="0.5" />
      
      <!-- Линии связи с бегущим сигналом -->
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M 39 60 L 60 60 L 60 35 L 80 35" stroke-dasharray="6 6" />
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M 39 60 L 60 60 L 60 85 L 80 85" stroke-dasharray="6 6" style="animation-delay: 0.6s;" />
      <!-- Точка разветвления -->
      <circle cx="60" cy="60" r="3" fill="currentColor" class="svg-draw" pathLength="1" />
    </svg>
  </ServiceShowcase>

  <!-- 5. Парсинг: лупа движется, под ней строки увеличены (clipPath в координатах группы) -->
  <ServiceShowcase
    id="parsing"
    title="Парсинг"
    pitch="Данные из сайтов и каналов — в таблицу или базу, по расписанию"
    description="Цены конкурентов, контакты, новости, посты из каналов — собираю откуда нужно и отдаю в удобном виде: таблица, CSV, база. Запуск по кнопке или по расписанию. Вы получаете актуальные данные без ручного копирования."
    flowSteps={['Источники (сайты/каналы/API)', 'Скрипт парсит', 'Фильтрация', 'Данные в таблицу/базу']}
    benefits={['Экономия часов ручного сбора', 'Актуальные данные', 'Масштабируется', 'Запуск по расписанию']}
    caseSlug="telegram-parser-publisher"
    caseTitle="Parser & Publisher: мониторинг каналов"
    caseMetric="Мониторинг без ручного труда"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <defs>
        <clipPath id="magnify-parsing">
          <circle cx="0" cy="0" r="16" />
        </clipPath>
      </defs>
      <!-- Фон (документ со строками) -->
      <rect class="svg-draw" pathLength="1" x="25" y="20" width="70" height="80" rx="4" opacity="0.3" />
      <path class="svg-draw" pathLength="1" d="M 35 40 h 50 M 35 60 h 50 M 35 80 h 30" opacity="0.3" />
      
      <!-- Лупа (двигается); контент внутри компенсирует движение, чтобы стоять на месте -->
      <g class="service-scan-glass">
        <circle cx="0" cy="0" r="16" class="svg-draw text-[var(--color-accent)]" stroke-width="2" pathLength="1" />
        <path d="M 12 12 L 22 22" class="svg-draw" stroke-width="2" pathLength="1" />
        <g clip-path="url(#magnify-parsing)">
          <g class="service-scan-glass-reverse">
            <!-- Увеличенные строки (стоят на месте в документе) -->
            <path d="M -25 -18 h 50 M -25 2 h 50 M -25 22 h 30" class="text-[var(--color-text)]" stroke-width="3" />
            <!-- Галочка в конце строки -->
            <path d="M 15 -2 L 20 4 L 30 -8" class="text-[var(--color-accent)]" stroke-width="3" />
          </g>
        </g>
      </g>
    </svg>
  </ServiceShowcase>

  <!-- 6. Автопостинг: календарь, часы, самолётик, AI-звёзды -->
  <ServiceShowcase
    id="autoposting"
    title="Автопостинг"
    pitch="Контент по расписанию: AI пишет и рисует, вы только нажимаете «опубликовать»"
    description="Идея или источник → AI генерирует текст и картинку → вы проверяете и одной кнопкой отправляете в Telegram, VK, Дзен. Публикация по расписанию, кросс-постинг в несколько каналов. Вместо часа на пост — пара минут на контроль."
    flowSteps={['Идея/источник', 'AI пишет текст', 'AI рисует картинку', 'Модерация (1 кнопка)', 'Публикация в N каналов']}
    benefits={['Контент 24/7', 'Кросс-постинг', 'AI-генерация', 'Контроль одной кнопкой']}
    caseSlug="ai-content-conveyor"
    caseTitle="AI-конвейер для автопостинга"
    caseMetric="30–40 мин → 2 мин на пост"
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Календарь -->
      <rect x="25" y="30" width="56" height="56" rx="6" class="svg-draw" pathLength="1" />
      <path d="M 25 46 h 56" class="svg-draw" pathLength="1" />
      <!-- Дни -->
      <rect x="35" y="56" width="6" height="6" rx="1" class="svg-draw" pathLength="1" />
      <rect x="50" y="56" width="6" height="6" rx="1" class="svg-draw" pathLength="1" />
      <rect x="65" y="56" width="6" height="6" rx="1" class="svg-draw" pathLength="1" />
      <rect x="35" y="70" width="6" height="6" rx="1" class="svg-draw" pathLength="1" opacity="0.3" />
      
      <!-- Часы -->
      <circle cx="81" cy="86" r="14" class="svg-draw text-[var(--color-accent)]" stroke-width="2" fill="var(--color-bg)" pathLength="1" />
      <path d="M 81 78 v 8 h 4" class="svg-draw text-[var(--color-accent)]" stroke-width="2" pathLength="1" />
      
      <!-- Самолетик -->
      <path d="M 75 30 L 105 15 L 90 45 L 82 38 z" class="service-fly-away text-[var(--color-accent)]" stroke-width="2" fill="currentColor" fill-opacity="0.2" />
    </svg>
  </ServiceShowcase>

  <!-- 7. Скрипты: терминал с анимацией печати строк -->
  <ServiceShowcase
    id="scripts"
    title="Скрипты"
    pitch="Точечный код под задачу: файлы, отчёты, конвертация — без лишних систем"
    description="Когда не нужен целый воркфлоу или бот — пишу скрипт на Python под одну задачу. Обработка и конвертация файлов, генерация отчётов из таблиц и баз, массовая выгрузка или рассылка. Запуск вручную одной кнопкой или по расписанию. Идеально для разовых задач и регулярной рутины, которую нецелесообразно тянуть в n8n."
    flowSteps={['Входные данные (файлы/таблица/API)', 'Скрипт обрабатывает', 'Результат: файл, отчёт или действие']}
    benefits={['Ровно под вашу задачу', 'Без лишних сервисов', 'Запуск по кнопке или cron', 'С комментариями и инструкцией']}
    caseSlug="vk-autoposter"
    caseTitle="Автопостер для ВКонтакте"
    caseMetric="10 мин → 1 сек на публикацию"
    direction="left"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect class="svg-draw" pathLength="1" x="15" y="25" width="90" height="70" rx="6" />
      <path class="svg-draw" pathLength="1" d="M 15 40 h 90" />
      <circle cx="25" cy="32.5" r="2" fill="currentColor" opacity="0.5" />
      <circle cx="32" cy="32.5" r="2" fill="currentColor" opacity="0.5" />
      <circle cx="39" cy="32.5" r="2" fill="currentColor" opacity="0.5" />
      <!-- Символы ввода -->
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M 25 55 L 32 60 L 25 65" stroke-width="2" />
      <path class="service-terminal-line" pathLength="1" d="M 40 60 h 50" opacity="0.8" />
      
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M 25 75 L 32 80 L 25 85" stroke-width="2" />
      <path class="service-terminal-line" pathLength="1" d="M 40 80 h 30" opacity="0.8" style="animation-delay: 1s;" />
    </svg>
  </ServiceShowcase>

  <!-- 8. Интеграции: два сервера, связаны «веревкой» крест-накрест, сигнал по линиям -->
  <ServiceShowcase
    id="integrations"
    title="Интеграции"
    pitch="Связываю сервисы: данные текут туда, куда нужно, без ручного переноса"
    description="CRM не видит заявки из мессенджера? Таблица не обновляется из базы? Собираю мосты между системами: Telegram, 1C, Bitrix, Google Sheets, любые API. Двусторонняя синхронизация или односторонняя выгрузка — под вашу схему работы."
    flowSteps={['Сервис A', 'API/webhook', 'n8n/скрипт', 'Сервис B']}
    benefits={['Единый поток данных', 'Нет ручного переноса', 'Любые сервисы', 'Двусторонняя синхронизация']}
    direction="right"
  >
    <svg class="w-full h-full" viewBox="0 0 120 120" overflow="visible" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <!-- Сервер A -->
      <rect class="svg-draw" pathLength="1" x="20" y="25" width="26" height="70" rx="4" />
      <path class="svg-draw" pathLength="1" d="M 26 40 h 14 M 26 50 h 8 M 26 80 h 14" opacity="0.6" />
      <!-- Сервер B -->
      <rect class="svg-draw text-[var(--color-accent)]" pathLength="1" x="74" y="25" width="26" height="70" rx="4" stroke-width="2" />
      <path class="svg-draw" pathLength="1" d="M 80 40 h 14 M 80 50 h 8 M 80 80 h 14" opacity="0.6" />
      
      <!-- Линии-мосты (вместо креста) -->
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M 46 50 Q 60 30 74 50" stroke-dasharray="6 6" />
      <!-- Наконечник стрелки 1 -->
      <path class="svg-draw text-[var(--color-accent)]" pathLength="1" d="M 68 46 L 74 50 L 68 54" />
      
      <path class="service-animate-dash-flow text-[var(--color-accent)]" d="M 74 70 Q 60 90 46 70" stroke-dasharray="6 6" style="animation-delay: 0.5s;" />
      <!-- Наконечник стрелки 2 -->
