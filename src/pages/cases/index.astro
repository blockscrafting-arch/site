---
/**
 * Список кейсов с фильтрацией по категории и уникальными карточками.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/common/Badge.astro';

const allCases = await getCollection('cases');
const cases = allCases.filter((c) => !c.data.draft);
const sorted = [...cases].sort((a, b) => {
  const dateA = a.data.date?.getTime() ?? 0;
  const dateB = b.data.date?.getTime() ?? 0;
  return dateB - dateA;
});

const categories = [
  { id: 'all', label: 'Все' },
  { id: 'bot', label: 'Боты' },
  { id: 'ai-agent', label: 'AI-агенты' },
  { id: 'automation', label: 'Автоматизация' },
  { id: 'mini-app', label: 'Mini Apps' },
  { id: 'parser', label: 'Парсеры' },
  { id: 'script', label: 'Скрипты' },
  { id: 'autoposting', label: 'Автопостинг' },
] as const;
---

<BaseLayout
  title="Кейсы — vlad.execute(_)"
  description="Реальные проекты: автоматизация, боты, AI-агенты, n8n, Python."
>
  <div class="cases-page-wrap mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 relative">
    <div class="relative w-full mb-4">
      <div class="absolute z-50 pointer-events-none text-[var(--color-accent)] opacity-[0.22] w-48 h-48 left-1/2 -translate-x-1/2 top-0 -translate-y-[55%] sm:w-64 sm:h-64 sm:left-auto sm:right-0 sm:translate-x-0 sm:top-1/2 sm:-translate-y-[42%]" aria-hidden="true">
        <svg class="w-full h-full animate-float-icon" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 30 60 L 80 60 L 100 80 L 170 80 L 170 160 L 30 160 Z" />
          <g class="animate-doc-1">
            <rect x="50" y="30" width="70" height="90" rx="2" />
            <line x1="65" y1="50" x2="105" y2="50" opacity="0.6" stroke-width="4" />
            <line x1="65" y1="70" x2="95" y2="70" opacity="0.6" stroke-width="4" />
          </g>
          <path d="M 20 90 L 180 90 L 170 170 L 30 170 Z" />
        </svg>
      </div>
      <div class="relative flex justify-center sm:justify-start">
        <h1 class="reveal cases-page-title font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl relative z-10">
          Кейсы
        </h1>
      </div>
      <p class="mt-2 text-[var(--color-text-muted)]">
        Разборы реальных проектов с результатами и цифрами.
      </p>
    </div>

    <div id="cases-filters-inflow" class="relative mt-8 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <div class="cases-filters-scroll-inner flex items-center gap-2 overflow-x-auto pb-2" style="scrollbar-width: thin;" role="tablist" aria-label="Фильтр по категории">
        {categories.map((cat) => (
          <button
            type="button"
            class="cases-filter-btn flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)] data-[active]:bg-[var(--color-accent-muted)] data-[active]:text-[var(--color-accent)]"
            data-category={cat.id}
            data-active={cat.id === 'all' ? 'true' : undefined}
          >
            {cat.label}
          </button>
        ))}
      </div>
      <div class="absolute right-0 top-0 bottom-2 w-14 pointer-events-none sm:hidden bg-[linear-gradient(to_right,transparent_0%,var(--color-accent-muted)_35%,var(--color-bg)_100%)]"></div>
    </div>

    <div class="cases-filters-fixed-wrap" id="cases-filters-fixed" aria-hidden="true">
      <div class="cases-filters-fixed-inner relative">
        <div class="cases-filters flex items-center gap-2 overflow-x-auto pb-1" style="scrollbar-width: thin;" role="tablist" aria-label="Фильтр по категории (закреплено)">
          {categories.map((cat) => (
            <button
              type="button"
              class="cases-filter-btn flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)] data-[active]:bg-[var(--color-accent-muted)] data-[active]:text-[var(--color-accent)]"
              data-category={cat.id}
              data-active={cat.id === 'all' ? 'true' : undefined}
            >
              {cat.label}
            </button>
          ))}
        </div>
        <div class="absolute right-0 top-0 bottom-1 w-14 pointer-events-none sm:hidden bg-[linear-gradient(to_right,transparent_0%,var(--color-accent-muted)_35%,var(--color-bg)_100%)]"></div>
      </div>
    </div>

    {sorted.length === 0 ? (
      <p class="mt-12 text-[var(--color-text-muted)]">Кейсы скоро появятся.</p>
    ) : (
      <ul class="reveal-stagger cases-grid mt-10 grid gap-6 sm:grid-cols-2" role="list">
        {sorted.map((entry) => {
          const accent = entry.data.accentColor ?? '#10b981';
          const cats = entry.data.categories?.length ? entry.data.categories : [];
          const categoryList = cats.join(' ');
          return (
            <li class="case-card-item" data-category={categoryList}>
              <a
                href={`/cases/${entry.slug}`}
                class="group block rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-all duration-300 hover:border-opacity-80 hover:shadow-glow-sm"
              >
                <span
                  class="mb-4 block h-1 w-12 rounded-full"
                  style={{ backgroundColor: accent }}
                  aria-hidden="true"
                />
                <h2 class="font-display font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">
                  {entry.data.title}
                </h2>
                <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2">
                  {entry.data.description}
                </p>
                {entry.data.result && (
                  <p class="mt-3 text-sm font-medium line-clamp-2" style={{ color: accent }}>
                    {entry.data.result}
                  </p>
                )}
                {entry.data.metrics && entry.data.metrics.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" role="list">
                    {entry.data.metrics.slice(0, 3).map((m) => (
                      <li class="rounded-md bg-[var(--color-surface-muted)] px-2 py-1 text-xs font-medium text-[var(--color-text-muted)]">
                        <span style={{ color: accent }}>{m.value}</span> — {m.label}
                      </li>
                    ))}
                  </ul>
                )}
                {entry.data.stack && entry.data.stack.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {entry.data.stack.map((s) => (
                      <Badge variant="gray">{s}</Badge>
                    ))}
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>

<script>
  (function () {
    const stickTop = 64;
    const fixedWrap = document.getElementById('cases-filters-fixed');
    const inFlowBar = document.getElementById('cases-filters-inflow');

    document.querySelectorAll('.cases-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.category;
        document.querySelectorAll('.cases-filter-btn').forEach((b) => {
          b.removeAttribute('data-active');
          if ((b as HTMLElement).dataset.category === cat) b.setAttribute('data-active', 'true');
        });
        document.querySelectorAll('.case-card-item').forEach((el) => {
          const itemCats = ((el as HTMLElement).dataset.category ?? '').split(' ').filter(Boolean);
          (el as HTMLElement).style.display = cat === 'all' || itemCats.includes(cat) ? '' : 'none';
        });
      });
    });

    if (fixedWrap && inFlowBar) {
      let raf: number | null = null;
      function update() {
        raf = null;
        const top = inFlowBar.getBoundingClientRect().top;
        const stuck = top < stickTop;
        fixedWrap.classList.toggle('is-stuck', stuck);
        fixedWrap.setAttribute('aria-hidden', String(!stuck));
      }
      window.addEventListener('scroll', () => { if (raf == null) raf = requestAnimationFrame(update); }, { passive: true });
      window.addEventListener('resize', update);
      document.addEventListener('astro:page-load', update);
      update();
    }
  })();
</script>
