---
/**
 * Блок социального доказательства: крупные метрики из реальных проектов.
 * Числа — главный визуал (text-5xl font-black). Без GSAP, без tilt.
 */
const metrics = [
  { value: '10 ч/нед', label: 'Вернули PM: голосовые в текст за вечер (n8n + Whisper), скан по диагонали вместо 2 часов прослушивания.', icon: 'clock' },
  { value: '120 → 2 ч', label: 'Постинг в 50+ Telegram-групп: было 120 часов в месяц, стало 2 часа на загрузку контента.', icon: 'chart' },
  { value: '1 вечер', label: 'От нуля до AI-ассистента в Telegram: голос, память, напоминания — без абонплат.', icon: 'zap' },
];
---

<section class="py-24 sm:py-32 px-4 sm:px-6" aria-labelledby="trust-heading">
  <div class="mx-auto max-w-6xl">
    <div class="relative flex justify-center mb-4">
      <div class="relative inline-flex items-center justify-center">
        <!-- SVG: молния справа от заголовка, на одной линии с остальными блоками -->
        <div class="absolute left-1/2 top-1/2 -translate-y-1/2 translate-x-[15%] sm:translate-x-[25%] lg:translate-x-[35%] w-52 h-52 sm:w-72 sm:h-72 opacity-[0.35] text-[var(--color-accent)] pointer-events-none -z-10" aria-hidden="true">
          <svg class="w-full h-full animate-slow-breath" viewBox="0 0 200 200" fill="none" stroke="currentColor">
            <!-- Central sharp lightning -->
            <path d="M115 20 L55 105 H105 L90 180 L155 90 H100 Z" stroke-width="2" stroke-linejoin="round" />
            <!-- Geometric accents -->
            <circle cx="100" cy="100" r="85" stroke-width="1" stroke-dasharray="1 8" opacity="0.3" />
            <path d="M150 40 L160 30 M40 150 L50 140 M40 50 L50 60" stroke-width="2" stroke-linecap="round" opacity="0.5" />
          </svg>
        </div>
        <h2 id="trust-heading" class="reveal font-display text-2xl font-bold text-[var(--color-text)] sm:text-3xl text-center relative z-10">
          Результаты в цифрах
        </h2>
      </div>
    </div>
    <p class="reveal mt-4 text-center text-[var(--color-text-muted)] max-w-2xl mx-auto" style="animation-delay:.06s">
      Показатели из реальных проектов.
    </p>

    <ul class="reveal-stagger mt-14 grid gap-6 sm:grid-cols-3" role="list">
      {metrics.map((m) => (
        <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 text-center">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-accent-muted)] text-[var(--color-accent)] animate-float-icon" aria-hidden="true">
            {m.icon === 'clock' && (<svg class="h-6 w-6 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>)}
            {m.icon === 'chart' && (<svg class="h-6 w-6 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>)}
            {m.icon === 'zap' && (<svg class="h-6 w-6 svg-icon-reveal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>)}
          </span>
          <span class="mt-5 block font-display text-4xl font-black text-[var(--color-accent)] sm:text-5xl tracking-tight">{m.value}</span>
          <span class="mt-3 block text-sm text-[var(--color-text-muted)] leading-relaxed">{m.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
