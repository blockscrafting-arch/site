---
/**
 * Базовый layout для всех страниц.
 * Подключает глобальные стили, Header, Footer, глоссарий, OG/Twitter meta.
 * Dark-first дизайн, Lenis smooth scroll, View Transitions.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GlossaryActivator from '../components/features/GlossaryActivator';
import CustomCursor from '../components/features/CustomCursor.astro';
import ScrollProgress from '../components/features/ScrollProgress.astro';
import BackToTop from '../components/features/BackToTop.astro';
import glossaryData from '../content/glossary.json';
import { site } from '../utils/site';

interface Props {
  title: string;
  description?: string;
  /** Путь к OG-картинке (от корня) или полный URL. По умолчанию site.ogImage */
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
const desc = description ?? site.description;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${site.url}${path}`;
const ogImageUrl = image?.startsWith('http') ? image : `${site.url}${image ?? site.ogImage}`;

/** JSON-LD для главной: Person + Service (AEO/SEO, AI-поиск 2026). */
const schemaOrg = path === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Влад',
      url: site.url,
      description: site.description,
      sameAs: [site.tgChannel, site.tgChannelContent],
    },
    {
      '@type': 'ProfessionalService',
      name: site.name,
      url: site.url,
      description: desc,
      areaServed: 'RU',
    },
  ],
} : null;

/** Экранирует </script> в JSON для безопасной вставки в тег script (защита от XSS). */
const safeGlossaryJson = JSON.stringify(glossaryData).replace(/<\/script/gi, '\\u003c/script');
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />
    {schemaOrg && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    )}
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased">
    <a href="#main-content" class="skip-link">
      Перейти к содержимому
    </a>
    <CustomCursor />
    <ScrollProgress />
    <BackToTop />
    <script type="application/json" id="glossary-data" set:html={safeGlossaryJson}></script>
    <GlossaryActivator client:idle />
    <Header />
    <main id="main-content" class="flex-1 pt-16" data-glossary>
      <slot />
    </main>
    <Footer />
    <script>
      import { initLenis } from '../scripts/lenis';
      const run = () => initLenis();
      if (typeof requestIdleCallback !== 'undefined') {
        requestIdleCallback(run, { timeout: 2000 });
      } else {
        setTimeout(run, 1);
      }
    </script>
    <script is:inline>
      /** Lightweight scroll-reveal: добавляет .is-visible по IntersectionObserver */
      function _initReveal() {
        var els = document.querySelectorAll('.reveal, .reveal-stagger');
        if (!els.length) return;
        var io = new IntersectionObserver(function(entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-visible');
              io.unobserve(entries[i].target);
            }
          }
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0 });
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      }
      requestAnimationFrame(function(){ requestAnimationFrame(_initReveal); });
      document.addEventListener('astro:after-swap', function() {
        requestAnimationFrame(function(){ requestAnimationFrame(_initReveal); });
      });
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', () => {
        window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
      });
    </script>
  </body>
</html>
