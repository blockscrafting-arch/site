---
/**
 * Секция «Как работаю»: 4 шага в виде timeline.
 * Desktop: горизонтальная линия с точками.
 * Mobile: вертикальная линия с текстом справа.
 */
const steps = [
  { num: '01', title: 'Описываете задачу', sub: 'Текстом, голосом или ТЗ — как удобно' },
  { num: '02', title: 'Предлагаю варианты', sub: 'Варианты с ценами — в тот же день' },
  { num: '03', title: 'Запускаем MVP', sub: 'Рабочая версия за 1–3 дня' },
  { num: '04', title: 'Гарантирую работу', sub: 'Баги по ТЗ правлю бесплатно' },
];
---

<section class="py-20 sm:py-28 px-4 sm:px-6" aria-labelledby="process-heading">
  <div class="mx-auto max-w-5xl">
    <h2
      id="process-heading"
      class="reveal font-display text-3xl font-bold text-[var(--color-text)] sm:text-4xl md:text-5xl text-center"
    >
      Запуск за 4 шага
    </h2>

    <!-- Mobile: vertical timeline -->
    <ol class="reveal-stagger mt-12 sm:mt-16 flex flex-col gap-0 lg:hidden" role="list">
      {steps.map((step, i) => (
        <li class="relative flex gap-4">
          <div class="flex flex-col items-center">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]">
              <span class="font-display text-sm font-black text-[var(--color-accent)]">{step.num}</span>
            </div>
            {i < steps.length - 1 && (
              <div class="w-px flex-1 bg-[var(--color-border)] my-1" aria-hidden="true"></div>
            )}
          </div>
          <div class="pb-8 pt-1.5">
            <h3 class="font-display font-semibold text-[var(--color-text)] text-base">{step.title}</h3>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">{step.sub}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- Desktop: horizontal timeline -->
    <ol class="reveal-stagger mt-12 sm:mt-16 hidden lg:grid lg:grid-cols-4 gap-0 relative" role="list">
      <div class="absolute top-5 left-[12.5%] right-[12.5%] h-px bg-[var(--color-border)]" aria-hidden="true"></div>
      {steps.map((step) => (
        <li class="relative flex flex-col items-center text-center px-4">
          <div class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]">
            <span class="font-display text-sm font-black text-[var(--color-accent)]">{step.num}</span>
          </div>
          <h3 class="mt-4 font-display font-semibold text-[var(--color-text)] text-lg">{step.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">{step.sub}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
